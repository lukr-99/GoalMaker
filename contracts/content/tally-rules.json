    {"id": "video", "name": "Video", "color": "red", "emoji": "📺"},
    {"id": "social", "name": "Social", "color": "pink", "emoji": "📱"},
    {"id": "games", "name": "Games", "color": "orange", "emoji": "🎮"},
    {"id": "reading", "name": "Reading", "color": "green", "emoji": "📖"},
    {"id": "chat", "name": "Chat", "color": "cyan", "emoji": "💬"},
    {"id": "other", "name": "Other", "color": "yellow", "emoji": "⏳"}
  ],
