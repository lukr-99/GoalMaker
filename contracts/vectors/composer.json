{
  "schema": 1,
  "description": "Composer lines and the drafts they give (docs/composer.md). 'marked' is the line with each recognized part written as [[kind:text]]; the input is the line without the brackets, and the expected spans are the bracketed parts (kind, start, end in UTF-16 code units). 'expect' lists only fields that differ from the defaults. 'now' is local time; the day rolls over at 'rolloverHour'. 2026-09-18 is a Friday.",
  "defaults": {
    "now": "2026-09-18T14:05",
    "rolloverHour": 4,
    "expect": {
      "plannedDate": null,
      "plannedTime": null,
      "tags": [],
      "area": null,
      "project": null,
      "topPriority": false,
      "idea": false,
      "repeat": null,
      "command": null
    }
  },
  "cases": [
    { "name": "a plain line is just a title", "marked": "Buy running shoes", "expect": { "title": "Buy running shoes" } },
    { "name": "extra spaces collapse", "marked": "  Buy   running shoes  ", "expect": { "title": "Buy running shoes" } },
    { "name": "an empty line", "marked": "", "expect": { "title": "" } },

    { "name": "a date word at the end", "marked": "Call mom [[date:tomorrow]]", "expect": { "title": "Call mom", "plannedDate": "2026-09-19" } },
    { "name": "a date word at the start", "marked": "[[date:tomorrow]] call mom", "expect": { "title": "call mom", "plannedDate": "2026-09-19" } },
    { "name": "punctuation after a date goes with it", "marked": "Call mom [[date:tomorrow.]]", "expect": { "title": "Call mom", "plannedDate": "2026-09-19" } },
    { "name": "date, time and tag together", "marked": "Buy shoes [[date:tmrw]] [[time:9:00]] [[tag:#run]]", "expect": { "title": "Buy shoes", "plannedDate": "2026-09-19", "plannedTime": "09:00", "tags": ["run"] } },
    { "name": "at and pm", "marked": "Dentist [[date:tomorrow]] [[time:at 5pm]]", "expect": { "title": "Dentist", "plannedDate": "2026-09-19", "plannedTime": "17:00" } },
    { "name": "time before date", "marked": "Pay rent [[time:at 5pm]] [[date:tomorrow]]", "expect": { "title": "Pay rent", "plannedDate": "2026-09-19", "plannedTime": "17:00" } },
    { "name": "case doesn't matter", "marked": "Call [[date:Tomorrow]] [[time:5PM]]", "expect": { "title": "Call", "plannedDate": "2026-09-19", "plannedTime": "17:00" } },

    { "name": "a time later today means today", "marked": "Send report [[time:17:00]]", "expect": { "title": "Send report", "plannedDate": "2026-09-18", "plannedTime": "17:00" } },
    { "name": "a time already past means tomorrow", "marked": "Send report [[time:9:00]]", "expect": { "title": "Send report", "plannedDate": "2026-09-19", "plannedTime": "09:00" } },
    { "name": "a time never moves an explicit date", "marked": "Call [[date:today]] [[time:9:00]]", "expect": { "title": "Call", "plannedDate": "2026-09-18", "plannedTime": "09:00" } },
    { "name": "am or pm as a separate word", "marked": "Standup [[time:5:30 pm]]", "expect": { "title": "Standup", "plannedDate": "2026-09-18", "plannedTime": "17:30" } },
    { "name": "noon", "marked": "Lunch with Eva [[time:noon]]", "expect": { "title": "Lunch with Eva", "plannedDate": "2026-09-19", "plannedTime": "12:00" } },
    { "name": "12am is midnight", "marked": "Launch [[date:tomorrow]] [[time:12am]]", "expect": { "title": "Launch", "plannedDate": "2026-09-19", "plannedTime": "00:00" } },
    { "name": "midnight", "marked": "Deploy [[date:tomorrow]] [[time:at midnight]]", "expect": { "title": "Deploy", "plannedDate": "2026-09-19", "plannedTime": "00:00" } },

    { "name": "a weekday means the next one", "marked": "Gym [[date:monday]]", "expect": { "title": "Gym", "plannedDate": "2026-09-21" } },
    { "name": "today's weekday means a week from today", "marked": "Gym [[date:friday]]", "expect": { "title": "Gym", "plannedDate": "2026-09-25" } },
    { "name": "sunday is two days away", "marked": "Brunch [[date:sunday]]", "expect": { "title": "Brunch", "plannedDate": "2026-09-20" } },
    { "name": "an abbreviated weekday", "marked": "Gym [[date:wed]]", "expect": { "title": "Gym", "plannedDate": "2026-09-23" } },
    { "name": "on before a weekday", "marked": "Work [[date:on monday]]", "expect": { "title": "Work", "plannedDate": "2026-09-21" } },
    { "name": "next weekday is in next week", "marked": "Gym [[date:next monday]]", "expect": { "title": "Gym", "plannedDate": "2026-09-21" } },
    { "name": "next weekday early in the week", "now": "2026-09-14T10:00", "marked": "Review [[date:next wednesday]]", "expect": { "title": "Review", "plannedDate": "2026-09-23" } },
    { "name": "a weekday early in the week", "now": "2026-09-14T10:00", "marked": "Review [[date:wednesday]]", "expect": { "title": "Review", "plannedDate": "2026-09-16" } },
    { "name": "next week is its Monday", "marked": "Plan trip [[date:next week]]", "expect": { "title": "Plan trip", "plannedDate": "2026-09-21" } },
    { "name": "next month is its first day", "marked": "Pay rent [[date:next month]]", "expect": { "title": "Pay rent", "plannedDate": "2026-10-01" } },
    { "name": "in N days", "marked": "Renew passport [[date:in 3 days]]", "expect": { "title": "Renew passport", "plannedDate": "2026-09-21" } },
    { "name": "in N weeks", "marked": "Check results [[date:in 2 weeks]]", "expect": { "title": "Check results", "plannedDate": "2026-10-02" } },
    { "name": "in a week", "marked": "Follow up [[date:in a week]]", "expect": { "title": "Follow up", "plannedDate": "2026-09-25" } },
    { "name": "in N months", "marked": "Dentist checkup [[date:in 6 months]]", "expect": { "title": "Dentist checkup", "plannedDate": "2027-03-18" } },
    { "name": "an ISO date", "marked": "Dentist [[date:on 2026-10-05]]", "expect": { "title": "Dentist", "plannedDate": "2026-10-05" } },
    { "name": "a day.month. date", "marked": "Dentist [[date:21.9.]]", "expect": { "title": "Dentist", "plannedDate": "2026-09-21" } },
    { "name": "a day.month. already past means next year", "marked": "Birthday party [[date:2.3.]]", "expect": { "title": "Birthday party", "plannedDate": "2027-03-02" } },
    { "name": "a day.month.year date", "marked": "Wedding [[date:5.10.2027]]", "expect": { "title": "Wedding", "plannedDate": "2027-10-05" } },
    { "name": "a month name first", "marked": "Meet Anna [[date:on sep 25]]", "expect": { "title": "Meet Anna", "plannedDate": "2026-09-25" } },
    { "name": "a day then a full month name", "marked": "Concert [[date:25 october]]", "expect": { "title": "Concert", "plannedDate": "2026-10-25" } },
    { "name": "an impossible date stays text", "marked": "Pay bill 31.2.", "expect": { "title": "Pay bill 31.2." } },

    { "name": "a date word inside the sentence stays text", "marked": "Prepare monday meeting", "expect": { "title": "Prepare monday meeting" } },
    { "name": "only the tail's date counts", "marked": "Prepare monday meeting [[date:friday]]", "expect": { "title": "Prepare monday meeting", "plannedDate": "2026-09-25" } },
    { "name": "a word that only starts like a date stays text", "marked": "Tomorrow's plan", "expect": { "title": "Tomorrow's plan" } },
    { "name": "leading markers and a date", "marked": "[[tag:#work]] [[date:tomorrow]] finish slides", "expect": { "title": "finish slides", "plannedDate": "2026-09-19", "tags": ["work"] } },
    { "name": "only markers leave an empty title", "marked": "[[date:tomorrow]] [[tag:#run]]", "expect": { "title": "", "plannedDate": "2026-09-19", "tags": ["run"] } },
    { "name": "the last date wins", "marked": "Call [[date:today]] [[date:tomorrow]]", "expect": { "title": "Call", "plannedDate": "2026-09-19" } },
    { "name": "an impossible time stays text", "marked": "Match 25:00", "expect": { "title": "Match 25:00" } },
    { "name": "at without a time stays text", "marked": "Meet at the station", "expect": { "title": "Meet at the station" } },
    { "name": "a bare number isn't a time", "marked": "Buy 3 apples", "expect": { "title": "Buy 3 apples" } },

    { "name": "markers work anywhere", "marked": "Email [[area:@Work]] about the [[project:+Website]] launch [[priority:!]]", "expect": { "title": "Email about the launch", "area": "Work", "project": "Website", "topPriority": true } },
    { "name": "an email address isn't an area", "marked": "Write to owner@goalmaker.test", "expect": { "title": "Write to owner@goalmaker.test" } },
    { "name": "a # inside a word isn't a tag", "marked": "Learn C# [[tag:#dev]]", "expect": { "title": "Learn C#", "tags": ["dev"] } },
    { "name": "a tag starts with a letter", "marked": "Be the #1 fan", "expect": { "title": "Be the #1 fan" } },
    { "name": "a backslash keeps a marker as text", "marked": "Plan \\#launch party", "expect": { "title": "Plan #launch party" } },
    { "name": "a backslash keeps a date word as text", "marked": "Send report \\tomorrow", "expect": { "title": "Send report tomorrow" } },
    { "name": "a question mark on a word is punctuation", "marked": "Is the oven off?", "expect": { "title": "Is the oven off?" } },
    { "name": "a lone question mark marks an idea", "marked": "Dark mode for widgets [[idea:?]]", "expect": { "title": "Dark mode for widgets", "idea": true } },
    { "name": "an exclamation mark on a word is punctuation", "marked": "Call mom!", "expect": { "title": "Call mom!" } },
    { "name": "tags keep the first spelling, once each", "marked": "Run [[tag:#Health]] [[tag:#health]] [[tag:#run]]", "expect": { "title": "Run", "tags": ["Health", "run"] } },
    { "name": "Czech letters in names", "marked": "Nakoupit [[area:@Domácnost]] [[tag:#nákup]]", "expect": { "title": "Nakoupit", "area": "Domácnost", "tags": ["nákup"] } },
    { "name": "punctuation after a marker goes with it", "marked": "Stretch [[tag:#health,]] then rest", "expect": { "title": "Stretch then rest", "tags": ["health"] } },
    { "name": "underscores in areas and projects are spaces", "marked": "Plan [[project:+Side_project]] [[area:@Deep_work]]", "expect": { "title": "Plan", "area": "Deep work", "project": "Side project" } },
    { "name": "the last area wins", "marked": "Move desk [[area:@Home]] [[area:@Work]]", "expect": { "title": "Move desk", "area": "Work" } },

    { "name": "every weekday name", "marked": "Water plants [[repeat:every monday]]", "expect": { "title": "Water plants", "plannedDate": "2026-09-21", "repeat": "FREQ=WEEKLY;BYDAY=MO" } },
    { "name": "daily starts today", "marked": "Stretch [[repeat:daily]]", "expect": { "title": "Stretch", "plannedDate": "2026-09-18", "repeat": "FREQ=DAILY" } },
    { "name": "every day with a past time starts tomorrow", "marked": "Vitamins [[repeat:every day]] [[time:8:00]]", "expect": { "title": "Vitamins", "plannedDate": "2026-09-19", "plannedTime": "08:00", "repeat": "FREQ=DAILY" } },
    { "name": "weekdays with a past time start on the next weekday", "marked": "Standup [[repeat:weekdays]] [[time:9:30]]", "expect": { "title": "Standup", "plannedDate": "2026-09-21", "plannedTime": "09:30", "repeat": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR" } },
    { "name": "a list of weekdays counts today", "marked": "Gym [[repeat:every mon, wed and fri]]", "expect": { "title": "Gym", "plannedDate": "2026-09-18", "repeat": "FREQ=WEEKLY;BYDAY=MO,WE,FR" } },
    { "name": "every weekend", "marked": "Long run [[repeat:every weekend]]", "expect": { "title": "Long run", "plannedDate": "2026-09-19", "repeat": "FREQ=WEEKLY;BYDAY=SA,SU" } },
    { "name": "every N days", "marked": "Water cactus [[repeat:every 3 days]]", "expect": { "title": "Water cactus", "plannedDate": "2026-09-18", "repeat": "FREQ=DAILY;INTERVAL=3" } },
    { "name": "every N weeks takes the planned weekday", "marked": "Review budget [[repeat:every 2 weeks]]", "expect": { "title": "Review budget", "plannedDate": "2026-09-18", "repeat": "FREQ=WEEKLY;INTERVAL=2;BYDAY=FR" } },
    { "name": "weekly takes the given date's weekday", "marked": "Backup [[repeat:weekly]] [[date:on sunday]]", "expect": { "title": "Backup", "plannedDate": "2026-09-20", "repeat": "FREQ=WEEKLY;BYDAY=SU" } },
    { "name": "every Nth of the month", "marked": "Pay rent [[repeat:every 1st]]", "expect": { "title": "Pay rent", "plannedDate": "2026-10-01", "repeat": "FREQ=MONTHLY;BYMONTHDAY=1" } },
    { "name": "monthly takes the planned day", "marked": "Pay rent [[repeat:monthly]]", "expect": { "title": "Pay rent", "plannedDate": "2026-09-18", "repeat": "FREQ=MONTHLY;BYMONTHDAY=18" } },
    { "name": "every N months", "marked": "Haircut [[repeat:every 2 months]]", "expect": { "title": "Haircut", "plannedDate": "2026-09-18", "repeat": "FREQ=MONTHLY;INTERVAL=2;BYMONTHDAY=18" } },
    { "name": "a day some months lack starts where it exists", "marked": "Report [[repeat:every 31st]]", "expect": { "title": "Report", "plannedDate": "2026-10-31", "repeat": "FREQ=MONTHLY;BYMONTHDAY=31" } },
    { "name": "every without a pattern stays text", "marked": "Clean every corner", "expect": { "title": "Clean every corner" } },

    { "name": "after midnight, tomorrow is the day that has begun", "now": "2026-09-19T01:30", "marked": "Call [[date:tomorrow]]", "expect": { "title": "Call", "plannedDate": "2026-09-19" } },
    { "name": "after midnight, today is still yesterday", "now": "2026-09-19T01:30", "marked": "Call [[date:today]]", "expect": { "title": "Call", "plannedDate": "2026-09-18" } },
    { "name": "after midnight, a morning time is this morning", "now": "2026-09-19T01:30", "marked": "Wake up [[time:7:00]]", "expect": { "title": "Wake up", "plannedDate": "2026-09-19", "plannedTime": "07:00" } },
    { "name": "with the rollover at midnight, tomorrow is tomorrow", "now": "2026-09-19T01:30", "rolloverHour": 0, "marked": "Call [[date:tomorrow]]", "expect": { "title": "Call", "plannedDate": "2026-09-20" } },

    { "name": "a command", "marked": "[[command:/plan]]", "expect": { "title": "", "command": { "name": "plan", "argument": "", "known": true } } },
    { "name": "a command's argument isn't parsed", "marked": "[[command:/habit]] Read 20 pages #daily", "expect": { "title": "", "command": { "name": "habit", "argument": "Read 20 pages #daily", "known": true } } },
    { "name": "commands ignore case", "marked": "[[command:/Plan]]", "expect": { "title": "", "command": { "name": "plan", "argument": "", "known": true } } },
    { "name": "an unknown command", "marked": "[[command:/dance]] now", "expect": { "title": "", "command": { "name": "dance", "argument": "now", "known": false } } },
    { "name": "a slash without a letter isn't a command", "marked": "/ 2 split", "expect": { "title": "/ 2 split" } }
  ]
}
