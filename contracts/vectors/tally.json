    {"name": "an app rule comes before a title rule", "sample": {"platform": "windows", "app": "WINWORD.EXE", "title": "YouTube plan.docx - Word"}, "defaults": "shipped", "expect": {"category": "work", "project": null}},
    {"name": "mail in a browser is Email", "sample": {"platform": "windows", "app": "msedge.exe", "title": "Inbox - Gmail - Microsoft​ Edge"}, "defaults": "shipped", "expect": {"category": "email", "project": null}},
