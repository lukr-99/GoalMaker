{
  "schema": 1,
  "description": "What the bottom bar on Wants, Habits and Goals reads from a typed line (docs/composer.md, 'Adding on Wants, Habits and Goals'). Each group lists lines and what they give; 'expect' lists only fields that differ from the group's defaults. Goals read the line against 'today', the planning day (2026-10-01 is a Thursday). Anything not understood stays in the title.",
  "today": "2026-10-01",
  "wants": {
    "defaults": { "title": "", "reason": null, "price": null, "currency": null, "waitDays": null },
    "cases": [
      { "name": "a plain line is just a title", "line": "Mechanical keyboard", "expect": { "title": "Mechanical keyboard" } },
      { "name": "an empty line", "line": "", "expect": {} },
      { "name": "spaces collapse", "line": "  Mechanical   keyboard  ", "expect": { "title": "Mechanical keyboard" } },
      { "name": "a price with Kč", "line": "Kindle 3290 Kč", "expect": { "title": "Kindle", "price": 3290, "currency": "CZK" } },
      { "name": "a price written together with its currency", "line": "Kindle 3290Kč", "expect": { "title": "Kindle", "price": 3290, "currency": "CZK" } },
      { "name": "kc and czk are crowns too, in any case", "line": "Lamp 450 KC", "expect": { "title": "Lamp", "price": 450, "currency": "CZK" } },
      { "name": "czk", "line": "Lamp 450 czk", "expect": { "title": "Lamp", "price": 450, "currency": "CZK" } },
      { "name": "thousands split by spaces", "line": "Bike 12 990 Kč", "expect": { "title": "Bike", "price": 12990, "currency": "CZK" } },
      { "name": "thousands split by a dot", "line": "Bike 12.990 Kč", "expect": { "title": "Bike", "price": 12990, "currency": "CZK" } },
      { "name": "a decimal comma", "line": "Cable 9,50 €", "expect": { "title": "Cable", "price": 9.5, "currency": "EUR" } },
      { "name": "a euro sign in front", "line": "Cable €12", "expect": { "title": "Cable", "price": 12, "currency": "EUR" } },
      { "name": "a dollar sign in front with a decimal dot", "line": "Game $19.99", "expect": { "title": "Game", "price": 19.99, "currency": "USD" } },
      { "name": "pounds after the number", "line": "Book 12 gbp", "expect": { "title": "Book", "price": 12, "currency": "GBP" } },
      { "name": "a bare number is part of the title", "line": "iPhone 15", "expect": { "title": "iPhone 15" } },
      { "name": "the first price counts and a later one stays", "line": "Kindle 3290 Kč or 99 €", "expect": { "title": "Kindle or 99 €", "price": 3290, "currency": "CZK" } },
      { "name": "the reason after because", "line": "Kindle 3290 Kč because I read on the train", "expect": { "title": "Kindle", "price": 3290, "currency": "CZK", "reason": "I read on the train" } },
      { "name": "because in any case, and a price inside the reason stays there", "line": "Kindle BECAUSE paper books cost 400 Kč each", "expect": { "title": "Kindle", "reason": "paper books cost 400 Kč each" } },
      { "name": "because with nothing after it gives no reason", "line": "Kindle because", "expect": { "title": "Kindle" } },
      { "name": "only because", "line": "because it is nice", "expect": { "reason": "it is nice" } },
      { "name": "a picked wait in days", "line": "Desk wait 10 days", "expect": { "title": "Desk", "waitDays": 10 } },
      { "name": "a picked wait in weeks, with for", "line": "Desk wait for 2 weeks", "expect": { "title": "Desk", "waitDays": 14 } },
      { "name": "a wait of a month is 30 days", "line": "Desk wait a month", "expect": { "title": "Desk", "waitDays": 30 } },
      { "name": "one day", "line": "Desk wait 1 day", "expect": { "title": "Desk", "waitDays": 1 } },
      { "name": "a wait over a year stays text", "line": "Desk wait 13 months", "expect": { "title": "Desk wait 13 months" } },
      { "name": "wait alone stays text", "line": "Weight vest wait", "expect": { "title": "Weight vest wait" } },
      { "name": "everything together", "line": "Kindle 3 290 Kč wait 2 weeks because I read on the train", "expect": { "title": "Kindle", "price": 3290, "currency": "CZK", "waitDays": 14, "reason": "I read on the train" } },
      { "name": "punctuation after the currency goes with it", "line": "Kindle 3290 Kč, because yes", "expect": { "title": "Kindle", "price": 3290, "currency": "CZK", "reason": "yes" } }
    ]
  },
  "habits": {
    "defaults": { "name": "", "cadence": "daily", "weekdays": null, "times": null, "measure": "check", "target": null, "unit": null },
    "cases": [
      { "name": "a plain line is a daily check", "line": "Floss", "expect": { "name": "Floss" } },
      { "name": "an empty line", "line": "", "expect": {} },
      { "name": "every day", "line": "Floss every day", "expect": { "name": "Floss" } },
      { "name": "daily", "line": "Daily stretch", "expect": { "name": "stretch" } },
      { "name": "times a week", "line": "Swim 2 times a week", "expect": { "name": "Swim", "cadence": "per_week", "times": 2 } },
      { "name": "x per week", "line": "Gym 3x per week", "expect": { "name": "Gym", "cadence": "per_week", "times": 3 } },
      { "name": "x as its own word", "line": "Gym 3 x a week", "expect": { "name": "Gym", "cadence": "per_week", "times": 3 } },
      { "name": "once a week", "line": "Call grandma once a week", "expect": { "name": "Call grandma", "cadence": "per_week", "times": 1 } },
      { "name": "twice a month", "line": "Deep clean twice a month", "expect": { "name": "Deep clean", "cadence": "per_month", "times": 2 } },
      { "name": "times a month", "line": "Climb 6 times a month", "expect": { "name": "Climb", "cadence": "per_month", "times": 6 } },
      { "name": "weekly", "line": "Plan meals weekly", "expect": { "name": "Plan meals", "cadence": "per_week", "times": 1 } },
      { "name": "monthly", "line": "Budget check monthly", "expect": { "name": "Budget check", "cadence": "per_month", "times": 1 } },
      { "name": "more than seven a week stays text", "line": "Walk 8 times a week", "expect": { "name": "Walk 8 times a week" } },
      { "name": "weekdays", "line": "Standup notes weekdays", "expect": { "name": "Standup notes", "cadence": "weekdays", "weekdays": 31 } },
      { "name": "on weekends", "line": "Long walk on weekends", "expect": { "name": "Long walk", "cadence": "weekdays", "weekdays": 96 } },
      { "name": "every with one day", "line": "Piano every monday", "expect": { "name": "Piano", "cadence": "weekdays", "weekdays": 1 } },
      { "name": "every with a list of days", "line": "Run every mon, wed and fri", "expect": { "name": "Run", "cadence": "weekdays", "weekdays": 21 } },
      { "name": "on with days and a slash", "line": "Yoga on Tue/Thu", "expect": { "name": "Yoga on Tue/Thu" } },
      { "name": "on with days separated by spaces", "line": "Yoga on tue thu", "expect": { "name": "Yoga", "cadence": "weekdays", "weekdays": 10 } },
      { "name": "every sunday", "line": "Review the week every Sunday.", "expect": { "name": "Review the week", "cadence": "weekdays", "weekdays": 64 } },
      { "name": "a count with a unit", "line": "Drink 8 glasses", "expect": { "name": "Drink", "measure": "count", "target": 8, "unit": "glasses" } },
      { "name": "a count with a day after it", "line": "Water 8 glasses a day", "expect": { "name": "Water", "measure": "count", "target": 8, "unit": "glasses" } },
      { "name": "times a day is a count with no unit", "line": "Stretch 3 times a day", "expect": { "name": "Stretch", "measure": "count", "target": 3 } },
      { "name": "twice a day", "line": "Brush teeth twice a day", "expect": { "name": "Brush teeth", "measure": "count", "target": 2 } },
      { "name": "minutes are an amount", "line": "Read 20 minutes", "expect": { "name": "Read", "measure": "amount", "target": 20, "unit": "minutes" } },
      { "name": "a number and unit written together", "line": "Run 5km", "expect": { "name": "Run", "measure": "amount", "target": 5, "unit": "km" } },
      { "name": "a decimal is always an amount", "line": "Water 1,5 bottles", "expect": { "name": "Water", "measure": "amount", "target": 1.5, "unit": "bottles" } },
      { "name": "pages are an amount", "line": "Read 10 pages every day", "expect": { "name": "Read", "measure": "amount", "target": 10, "unit": "pages" } },
      { "name": "cadence and amount together", "line": "Swim 2 times a week 40 min", "expect": { "name": "Swim", "cadence": "per_week", "times": 2, "measure": "amount", "target": 40, "unit": "min" } },
      { "name": "days and amount together", "line": "Practice guitar 30 min every mon and thu", "expect": { "name": "Practice guitar", "cadence": "weekdays", "weekdays": 9, "measure": "amount", "target": 30, "unit": "min" } },
      { "name": "thousands split by a comma", "line": "Walk 10,000 steps", "expect": { "name": "Walk", "measure": "amount", "target": 10000, "unit": "steps" } },
      { "name": "thousands split by a space", "line": "Walk 10 000 steps a day", "expect": { "name": "Walk", "measure": "amount", "target": 10000, "unit": "steps" } },
      { "name": "a number before a small word is no amount", "line": "Visit 2 of my friends", "expect": { "name": "Visit 2 of my friends" } },
      { "name": "a zero is no amount", "line": "Smoke 0 cigarettes", "expect": { "name": "Smoke 0 cigarettes" } },
      { "name": "only the cadence leaves no name", "line": "every day", "expect": {} }
    ]
  },
  "goals": {
    "defaults": { "title": "", "horizon": "week", "periodStart": "2026-09-28", "mode": "done", "target": null, "unit": null },
    "cases": [
      { "name": "a plain line is this week's goal, done or not", "line": "Clean the garage", "expect": { "title": "Clean the garage" } },
      { "name": "an empty line", "line": "", "expect": {} },
      { "name": "this week, and the target stays in the title", "line": "Run 30 km this week", "expect": { "title": "Run 30 km", "mode": "number", "target": 30, "unit": "km" } },
      { "name": "this month", "line": "Read 3 books this month", "expect": { "title": "Read 3 books", "horizon": "month", "periodStart": "2026-10-01", "mode": "number", "target": 3, "unit": "books" } },
      { "name": "this year", "line": "This year visit 4 countries", "expect": { "title": "visit 4 countries", "horizon": "year", "periodStart": "2026-01-01", "mode": "number", "target": 4, "unit": "countries" } },
      { "name": "today", "line": "Finish the report today", "expect": { "title": "Finish the report", "horizon": "day", "periodStart": "2026-10-01" } },
      { "name": "tomorrow", "line": "Ship it tomorrow", "expect": { "title": "Ship it", "horizon": "day", "periodStart": "2026-10-02" } },
      { "name": "next week", "line": "Write 2 posts next week", "expect": { "title": "Write 2 posts", "periodStart": "2026-10-05", "mode": "number", "target": 2, "unit": "posts" } },
      { "name": "next month", "line": "Save 5000 CZK next month", "expect": { "title": "Save 5000 CZK", "horizon": "month", "periodStart": "2026-11-01", "mode": "number", "target": 5000, "unit": "CZK" } },
      { "name": "next year", "line": "Run a marathon next year", "expect": { "title": "Run a marathon", "horizon": "year", "periodStart": "2027-01-01" } },
      { "name": "in a month later this year", "line": "Run 100 km in November", "expect": { "title": "Run 100 km", "horizon": "month", "periodStart": "2026-11-01", "mode": "number", "target": 100, "unit": "km" } },
      { "name": "in this month", "line": "Paint the hall in oct", "expect": { "title": "Paint the hall", "horizon": "month", "periodStart": "2026-10-01" } },
      { "name": "in a month that has passed means next year", "line": "Ski trip in February", "expect": { "title": "Ski trip", "horizon": "month", "periodStart": "2027-02-01" } },
      { "name": "in a year", "line": "Learn Spanish in 2027", "expect": { "title": "Learn Spanish", "horizon": "year", "periodStart": "2027-01-01" } },
      { "name": "a year gone by stays text", "line": "Learn Spanish in 2020", "expect": { "title": "Learn Spanish in 2020" } },
      { "name": "case and punctuation", "line": "Run 20 km THIS MONTH.", "expect": { "title": "Run 20 km", "horizon": "month", "periodStart": "2026-10-01", "mode": "number", "target": 20, "unit": "km" } },
      { "name": "the first horizon counts and a later one stays", "line": "Today plan next week", "expect": { "title": "plan next week", "horizon": "day", "periodStart": "2026-10-01" } },
      { "name": "a number and unit written together", "line": "Swim 3km this week", "expect": { "title": "Swim 3km", "mode": "number", "target": 3, "unit": "km" } },
      { "name": "a decimal target", "line": "Lose 2.5 kg this month", "expect": { "title": "Lose 2.5 kg", "horizon": "month", "periodStart": "2026-10-01", "mode": "number", "target": 2.5, "unit": "kg" } },
      { "name": "a target with thousands split by a space", "line": "Save 10 000 CZK this year", "expect": { "title": "Save 10 000 CZK", "horizon": "year", "periodStart": "2026-01-01", "mode": "number", "target": 10000, "unit": "CZK" } },
      { "name": "a number before a small word is no target", "line": "Read 2 of the classics", "expect": { "title": "Read 2 of the classics" } },
      { "name": "a bare number is no target", "line": "Finish chapter 4", "expect": { "title": "Finish chapter 4" } },
      { "name": "only the horizon leaves no title", "line": "this month", "expect": { "horizon": "month", "periodStart": "2026-10-01" } }
    ]
  }
}
