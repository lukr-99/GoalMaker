    { "horizon": "week", "day": "2026-09-14", "start": "2026-09-14", "end": "2026-09-20" },
    { "horizon": "week", "day": "2026-09-20", "start": "2026-09-14", "end": "2026-09-20" },
    { "horizon": "week", "day": "2027-01-01", "start": "2026-12-28", "end": "2027-01-03" },
    { "horizon": "day", "day": "2026-09-18", "start": "2026-09-18", "end": "2026-09-18" }
  ],
