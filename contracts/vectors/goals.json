      "tasks": [],
      "entries": [{ "amount": 6 }, { "amount": -2 }],
      "expect": { "value": 4, "target": 10, "fraction": 0.4, "hit": false }
    },
    {
      "name": "number: past the target is hit, the fraction stays at 1",
