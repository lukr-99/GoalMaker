  ],
  "order": [
    {
      "name": "behind first, then on track, hit and dropped, each in its own order",
      "goals": [{ "id": "a", "pace": "hit" }, { "id": "b", "pace": "on_track" }, { "id": "c", "pace": "behind" }, { "id": "d", "pace": "dropped" }, { "id": "e", "pace": "behind" }, { "id": "f", "pace": "on_track" }],
