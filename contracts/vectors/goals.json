  "chain": [
    {
      "name": "a month lights its year and everything under it",
      "goals": [{ "id": "y1", "parent": null }, { "id": "y2", "parent": null }, { "id": "m1", "parent": "y1" }, { "id": "m2", "parent": "y2" }, { "id": "w1", "parent": "m1" }, { "id": "w2", "parent": "m1" }, { "id": "d1", "parent": "w1" }, { "id": "d2", "parent": "m2" }, { "id": "w3", "parent": "gone" }],
      "picked": "m1",
      "expect": ["d1", "m1", "w1", "w2", "y1"]
    },
    {
      "name": "a day lights every goal it feeds up to the year",
      "goals": [{ "id": "y1", "parent": null }, { "id": "y2", "parent": null }, { "id": "m1", "parent": "y1" }, { "id": "m2", "parent": "y2" }, { "id": "w1", "parent": "m1" }, { "id": "w2", "parent": "m1" }, { "id": "d1", "parent": "w1" }, { "id": "d2", "parent": "m2" }, { "id": "w3", "parent": "gone" }],
      "picked": "d1",
      "expect": ["d1", "m1", "w1", "y1"]
    },
    {
      "name": "a year lights what feeds it, even past a skipped horizon",
      "goals": [{ "id": "y1", "parent": null }, { "id": "y2", "parent": null }, { "id": "m1", "parent": "y1" }, { "id": "m2", "parent": "y2" }, { "id": "w1", "parent": "m1" }, { "id": "w2", "parent": "m1" }, { "id": "d1", "parent": "w1" }, { "id": "d2", "parent": "m2" }, { "id": "w3", "parent": "gone" }],
      "picked": "y2",
      "expect": ["d2", "m2", "y2"]
    },
    {
      "name": "a goal whose parent is gone lights only itself",
      "goals": [{ "id": "y1", "parent": null }, { "id": "y2", "parent": null }, { "id": "m1", "parent": "y1" }, { "id": "m2", "parent": "y2" }, { "id": "w1", "parent": "m1" }, { "id": "w2", "parent": "m1" }, { "id": "d1", "parent": "w1" }, { "id": "d2", "parent": "m2" }, { "id": "w3", "parent": "gone" }],
      "picked": "w3",
      "expect": ["w3"]
    },
    {
      "name": "a goal that isn't there lights nothing",
      "goals": [{ "id": "y1", "parent": null }, { "id": "y2", "parent": null }, { "id": "m1", "parent": "y1" }, { "id": "m2", "parent": "y2" }, { "id": "w1", "parent": "m1" }, { "id": "w2", "parent": "m1" }, { "id": "d1", "parent": "w1" }, { "id": "d2", "parent": "m2" }, { "id": "w3", "parent": "gone" }],
      "picked": "x",
      "expect": []
    },
    {
      "name": "a loop is walked once",
      "goals": [{ "id": "a", "parent": "b" }, { "id": "b", "parent": "a" }, { "id": "c", "parent": "a" }],
      "picked": "a",
      "expect": ["a", "b", "c"]
