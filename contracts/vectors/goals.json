    { "name": "not a shorter horizon", "child": { "horizon": "month", "start": "2026-09-01" }, "parent": { "horizon": "week", "start": "2026-09-14" }, "allowed": false }
  ],
  "progress": [
    { "name": "an open done-or-not goal", "goal": { "mode": "done", "status": "open" }, "tasks": [], "entries": [], "expect": { "value": 0, "target": 1, "fraction": 0, "hit": false } },
    { "name": "a done done-or-not goal", "goal": { "mode": "done", "status": "done" }, "tasks": [], "entries": [], "expect": { "value": 1, "target": 1, "fraction": 1, "hit": true } },
    {
      "name": "tasks: the share done, dropped and deleted ones don't count",
      "goal": { "mode": "tasks", "status": "open" },
      "tasks": [{ "status": "done" }, { "status": "open" }, { "status": "done" }, { "status": "open" }, { "status": "dropped" }, { "status": "done", "deleted": true }],
      "entries": [],
      "expect": { "value": 2, "target": 4, "fraction": 0.5, "hit": false }
    },
    {
      "name": "tasks: all done is hit",
      "goal": { "mode": "tasks", "status": "open" },
      "tasks": [{ "status": "done" }, { "status": "done" }],
      "entries": [],
      "expect": { "value": 2, "target": 2, "fraction": 1, "hit": true }
    },
    { "name": "tasks: none yet is nothing", "goal": { "mode": "tasks", "status": "open" }, "tasks": [], "entries": [], "expect": { "value": 0, "target": 0, "fraction": 0, "hit": false } },
    {
      "name": "number: the sum against the target, deleted entries don't count",
      "goal": { "mode": "number", "status": "open", "target": 80 },
