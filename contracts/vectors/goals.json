      "tasks": [],
      "entries": [{ "amount": 15 }, { "amount": 10 }],
      "expect": { "value": 25, "target": 20, "fraction": 1, "hit": true }
    },
    {
      "name": "number: below zero shows as nothing",
      "goal": { "mode": "number", "status": "open", "target": 10 },
      "tasks": [],
      "entries": [{ "amount": -3 }],
      "expect": { "value": -3, "target": 10, "fraction": 0, "hit": false }
    },
    {
      "name": "a goal marked done is hit whatever its numbers",
      "goal": { "mode": "number", "status": "done", "target": 80 },
      "tasks": [],
      "entries": [{ "amount": 30 }],
      "expect": { "value": 30, "target": 80, "fraction": 1, "hit": true }
    },
    {
      "name": "a dropped goal isn't hit",
      "goal": { "mode": "tasks", "status": "dropped" },
      "tasks": [{ "status": "done" }],
      "entries": [],
      "expect": { "value": 1, "target": 1, "fraction": 1, "hit": false }
    }
  ],
  "copy": [
    {
