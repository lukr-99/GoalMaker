{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lukr-99/GoalMaker/contracts/schemas/release-manifest.schema.json",
  "title": "GoalMaker release manifest",
  "description": "Describes the latest release in the update channel. Clients verify the detached ECDSA P-256 signature over the exact file bytes before reading it. Unknown properties are ignored.",
  "type": "object",
  "required": ["schema", "version", "publishedAt", "artifacts"],
  "properties": {
    "schema": { "const": 1 },
    "version": {
      "type": "string",
      "description": "Semantic version 2.0.0 without a leading v.",
      "pattern": "^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$"
    },
    "androidVersionCode": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "path", "size", "sha256"],
        "properties": {
          "platform": { "enum": ["android", "windows"] },
          "path": {
            "type": "string",
            "description": "X.Y.Z/<file>: the asset <file> of the GitHub Release vX.Y.Z (vectors/release-channel.json), and the object path in the old releases bucket. Relative, forward slashes, no '..' segments.",
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
          },
          "size": { "type": "integer", "minimum": 1, "maximum": 524288000 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
