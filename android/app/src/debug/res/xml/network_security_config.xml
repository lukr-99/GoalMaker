<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds talk to the local Supabase stack over plain HTTP (10.0.2.2 on the emulator, the
     PC's LAN address on a phone). Release builds keep the platform default: HTTPS only. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
