{
  "required_documents": [
    "README.md",
    "ARCHITECTURE.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE.md"
  ],
  "migration_directories": [
    "supabase/migrations",
    "replica/migrations"
  ],
  "type_scan_roots": [
    "android/app/src/main/kotlin",
    "windows/src"
  ],
  "type_policy_excludes": [
    "**/generated/**",
    "**/obj/**",
    "**/bin/**",
    "**/build/**",
    "**/node_modules/**",
    "**/.gradle/**"
  ],
  "link_check_excludes": []
}
