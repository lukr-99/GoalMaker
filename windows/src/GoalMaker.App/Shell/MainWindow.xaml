<ui:FluentWindow x:Class="GoalMaker.App.Shell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:GoalMaker.App.Views"
                 xmlns:controls="clr-namespace:GoalMaker.App.Controls"
                 Title="{DynamicResource App.Name}"
                 Width="1100"
                 Height="720"
                 MinWidth="720"
                 MinHeight="480"
                 Icon="{DynamicResource GM.LogoIcon}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding Places.OpenPaletteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </ui:FluentWindow.InputBindings>
    <!-- The theme's background under everything, title bar included (WPF UI owns the window's own). -->
    <Grid Background="{DynamicResource GM.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource App.Name}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{DynamicResource GM.LogoIcon}" />
            </ui:TitleBar.Icon>
            <!-- Pins or unpins the page on show (ADR 0014); only a place that can change shows it. -->
            <ui:TitleBar.TrailingContent>
                <ui:Button x:Name="PinButton"
                           DataContext="{Binding Places, RelativeSource={RelativeSource AncestorType=Window}}"
                           Command="{Binding TogglePinCurrentCommand}"
                           Content="{Binding PinLabel}"
                           AutomationProperties.Name="{Binding PinLabel}"
                           Appearance="Transparent"
                           Margin="0,0,8,0"
                           Padding="10,4"
                           Foreground="{DynamicResource GM.AccentBrush}"
                           Visibility="{Binding CanPinCurrent, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" Foreground="{DynamicResource GM.AccentBrush}" />
                    </ui:Button.Icon>
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:ProgressRing Grid.Row="1"
                         IsIndeterminate="True"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <views:SignInView Grid.Row="1"
                          DataContext="{Binding SignIn}"
                          Visibility="{Binding DataContext.IsSignedOut, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <ui:NavigationView x:Name="Navigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="240"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <!-- Go to (Ctrl+K) opens any page by typing. -->
            <ui:NavigationView.PaneHeader>
                <ui:Button x:Name="GoToButton"
                           DataContext="{Binding Places, RelativeSource={RelativeSource AncestorType=Window}}"
                           Command="{Binding OpenPaletteCommand}"
                           AutomationProperties.Name="{DynamicResource Places.GoTo}"
                           Appearance="Transparent"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           Margin="0,4,0,6"
                           Padding="11,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Search24" Foreground="{DynamicResource GM.AccentBrush}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{DynamicResource Places.GoTo}" Foreground="{DynamicResource GM.TextMutedBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" CornerRadius="4" Padding="6,1" BorderThickness="1" BorderBrush="{DynamicResource GM.OutlineBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Places.GoToShortcut}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </Border>
                    </Grid>
                </ui:Button>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Nav.Activity}" TargetPageType="{x:Type views:ActivityPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav.AreasAndTags}" TargetPageType="{x:Type views:AreasPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Tag24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav.Settings}" TargetPageType="{x:Type views:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                    <!-- An update waiting, or something that went wrong while nobody was watching (docs/problems.md). -->
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge Style="{StaticResource GM.SettingsMark}" />
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Go to (ADR 0014): type to filter, arrows to move, Enter to open, Esc or a click outside to close. -->
        <Grid x:Name="PaletteLayer"
              Grid.Row="1"
              DataContext="{Binding Places, RelativeSource={RelativeSource AncestorType=Window}}"
              Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVisibility}}">
            <Border x:Name="PaletteScrim" Background="#59000000" />
            <Border x:Name="PaletteBox"
                    Width="520"
                    MaxWidth="{Binding ActualWidth, ElementName=PaletteLayer}"
                    Margin="0,56,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource GM.SurfaceBrush}"
                    BorderBrush="{DynamicResource GM.OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource GM.CardCorner}"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <ScaleTransform />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <ui:TextBox x:Name="PaletteInput"
                                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{DynamicResource Places.GoToHint}"
                                AutomationProperties.Name="{DynamicResource Places.GoTo}"
                                Icon="{ui:SymbolIcon Search24}"
                                Margin="10"
                                FontSize="15" />
                    <ListBox x:Name="PaletteList"
                             ItemsSource="{Binding Matches}"
                             SelectedIndex="{Binding SelectedIndex}"
                             MaxHeight="360"
                             Margin="6,0,6,8"
                             BorderThickness="0"
                             Background="Transparent"
                             AutomationProperties.Name="{DynamicResource Places.GoTo}">
                        <!-- The highlighted row: an accent tint and bar, text in the text color, as in the prototype. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Margin="0,1">
                                                <Border x:Name="Fill" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.AccentBrush}" Opacity="0" />
                                                <Border x:Name="Bar" Width="3" Margin="0,8" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource GM.AccentBrush}" Visibility="Collapsed" />
                                                <ContentPresenter Margin="10,0,0,0" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fill" Property="Opacity" Value="0.08" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Fill" Property="Opacity" Value="0.16" />
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Padding="6,6" FontSize="14" Foreground="{DynamicResource GM.TextBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{DynamicResource Places.NothingFound}"
                               Margin="18,0,18,14"
                               Foreground="{DynamicResource GM.TextMutedBrush}"
                               Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- The launch moment: the logo in the theme's colors draws its arrow, then the app shows through. -->
        <Grid x:Name="Intro" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource GM.BackgroundBrush}">
            <controls:GoalMakerLogo x:Name="IntroLogo" Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</ui:FluentWindow>
