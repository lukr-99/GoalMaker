<ui:FluentWindow x:Class="GoalMaker.App.Shell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:GoalMaker.App.Views"
                 Title="{DynamicResource App.Name}"
                 Width="1100"
                 Height="720"
                 MinWidth="720"
                 MinHeight="480"
                 Icon="pack://application:,,,/Assets/GoalMaker.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!-- The theme's background under everything, title bar included (WPF UI owns the window's own). -->
    <Grid Background="{DynamicResource GM.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource App.Name}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/GoalMaker.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:ProgressRing Grid.Row="1"
                         IsIndeterminate="True"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <views:SignInView Grid.Row="1"
                          DataContext="{Binding SignIn}"
                          Visibility="{Binding DataContext.IsSignedOut, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <ui:NavigationView x:Name="Navigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="240"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Nav.Today}" TargetPageType="{x:Type views:TodayPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="CalendarToday24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav.Tomorrow}" TargetPageType="{x:Type views:TomorrowPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="CalendarArrowRight24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav.Inbox}" TargetPageType="{x:Type views:InboxPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="MailInbox24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <!-- Areas and tags as filters for every list (M2-11). -->
            <ui:NavigationView.PaneFooter>
                <ScrollViewer x:Name="FilterPane"
                              MaxHeight="320"
                              Margin="8,4,8,8"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsPaneOpen, ElementName=Navigation, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Visibility="{Binding HasAny, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel Margin="8,0,0,4">
                            <ui:Button DockPanel.Dock="Right"
                                       Padding="6,0"
                                       Appearance="Transparent"
                                       Content="{DynamicResource Nav.ClearFilter}"
                                       Command="{Binding ClearCommand}"
                                       Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Nav.Filters}" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Areas}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Margin="0,1"
                                                  Padding="8,4"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding Command}"
                                                  AutomationProperties.Name="{Binding Label}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Tags}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Margin="0,1"
                                                  Padding="8,4"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding Command}"
                                                  AutomationProperties.Name="{Binding Label}">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </ui:NavigationView.PaneFooter>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Nav.Archive}" TargetPageType="{x:Type views:ArchivePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Archive24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav.Activity}" TargetPageType="{x:Type views:ActivityPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav.AreasAndTags}" TargetPageType="{x:Type views:AreasPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Tag24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav.Settings}" TargetPageType="{x:Type views:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
