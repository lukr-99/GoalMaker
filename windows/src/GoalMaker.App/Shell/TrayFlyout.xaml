<UserControl x:Class="GoalMaker.App.Shell.TrayFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
             Width="340"
             FontFamily="{DynamicResource GM.BodyFont}"
             Foreground="{DynamicResource GM.TextBrush}">
    <!-- Today at a glance from the tray (spec, story 79). -->
    <Border Padding="16,14"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{DynamicResource GM.OutlineBrush}"
            Background="{DynamicResource GM.BackgroundBrush}">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource GM.HeadingFont}" FontSize="20" FontWeight="Bold" />
            <TextBlock Margin="0,2,0,10" Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" />

            <TextBlock Margin="0,0,0,10"
                       Text="{Binding EmptyText}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource GM.TextMutedBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                        <Border Margin="0,0,0,4" Padding="8,4" CornerRadius="8" Background="{DynamicResource GM.SurfaceBrush}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding TimeText}"
                                           FontFamily="{DynamicResource GM.NumberFont}"
                                           Foreground="{DynamicResource GM.TextMutedBrush}"
                                           Visibility="{Binding HasTime, Converter={StaticResource BoolToVisibility}}" />
                                <CheckBox VerticalAlignment="Center"
                                          Foreground="{DynamicResource GM.TextBrush}"
                                          IsChecked="{Binding IsDone}"
                                          AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DayText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource GM.DangerBrush}"
                                                   Visibility="{Binding HasDay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </CheckBox>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="4,2,0,0"
                       Text="{Binding MoreText}"
                       FontSize="12"
                       Foreground="{DynamicResource GM.TextMutedBrush}"
                       Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />

            <DockPanel Margin="0,12,0,0">
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Primary"
                           Content="{DynamicResource Tray.Open}"
                           Command="{Binding OpenAppCommand}" />
                <ui:Button HorizontalAlignment="Left"
                           Appearance="Secondary"
                           Content="{DynamicResource Tray.QuickAdd}"
                           Command="{Binding QuickAddCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button.Icon>
                </ui:Button>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
