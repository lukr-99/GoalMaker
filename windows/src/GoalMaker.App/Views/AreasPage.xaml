<Page x:Class="GoalMaker.App.Views.AreasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Areas.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <DataTemplate x:Key="ColorOption" DataType="{x:Type vm:ColorOptionViewModel}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!-- The areas and tags manager (M2-11). Fields save when they lose the keyboard. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource GM.PagePadding}" MaxWidth="{DynamicResource GM.PageWidth}" HorizontalAlignment="Center">
            <controls:HeadlineText Margin="0,0,0,12" Title="{DynamicResource Areas.Title}" FontSize="40" />
            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Areas.Hint}" />
            <TextBlock Margin="0,0,0,12"
                       Text="{Binding Status}"
                       Foreground="{DynamicResource GM.DangerBrush}"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

            <ui:Card Margin="0,0,0,12" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Areas.Areas}" />
                    <ItemsControl ItemsSource="{Binding Areas}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AreaRowViewModel}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding Colors}"
                                              SelectedItem="{Binding Color}"
                                              ItemTemplate="{StaticResource ColorOption}"
                                              AutomationProperties.Name="{DynamicResource Areas.Color}" />
                                    <TextBox Grid.Column="1"
                                             Margin="8,0,0,0"
                                             MaxLength="16"
                                             Text="{Binding Emoji}"
                                             ToolTip="{DynamicResource Areas.Emoji}"
                                             AutomationProperties.Name="{DynamicResource Areas.Emoji}" />
                                    <TextBox Grid.Column="2"
                                             Margin="8,0,0,0"
                                             MaxLength="60"
                                             Text="{Binding Name}"
                                             AutomationProperties.Name="{DynamicResource Areas.Name}" />
                                    <StackPanel Grid.Column="3" Margin="8,0,0,0" Orientation="Horizontal">
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                                                   ToolTip="{DynamicResource Areas.MoveUp}" AutomationProperties.Name="{DynamicResource Areas.MoveUp}">
                                            <ui:SymbolIcon Symbol="ArrowUp24" />
                                        </ui:Button>
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                                                   ToolTip="{DynamicResource Areas.MoveDown}" AutomationProperties.Name="{DynamicResource Areas.MoveDown}">
                                            <ui:SymbolIcon Symbol="ArrowDown24" />
                                        </ui:Button>
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding ArchiveCommand}"
                                                   ToolTip="{DynamicResource Areas.ArchiveArea}" AutomationProperties.Name="{DynamicResource Areas.ArchiveArea}">
                                            <ui:SymbolIcon Symbol="Archive24" />
                                        </ui:Button>
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding DeleteCommand}"
                                                   ToolTip="{DynamicResource Areas.DeleteArea}" AutomationProperties.Name="{DynamicResource Areas.DeleteArea}">
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0">
                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource Areas.AddArea}" Command="{Binding AddAreaCommand}" />
                        <ui:TextBox PlaceholderText="{DynamicResource Areas.NewArea}"
                                    MaxLength="60"
                                    Text="{Binding NewAreaName, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{DynamicResource Areas.NewArea}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddAreaCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{DynamicResource Areas.DeleteHint}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="20" Visibility="{Binding HasArchived, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Areas.Archived}" />
                    <ItemsControl ItemsSource="{Binding ArchivedAreas}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ArchivedAreaRowViewModel}">
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6" Appearance="Transparent" Command="{Binding DeleteCommand}"
                                               ToolTip="{DynamicResource Areas.DeleteArea}" AutomationProperties.Name="{DynamicResource Areas.DeleteArea}">
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </ui:Button>
                                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource Areas.Restore}" Command="{Binding RestoreCommand}" />
                                    <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" Foreground="{DynamicResource GM.TextMutedBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Areas.ArchivedHint}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Areas.Tags}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Areas.NoTags}"
                               Visibility="{Binding HasNoTags, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TagRowViewModel}">
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6" Appearance="Transparent" Command="{Binding DeleteCommand}"
                                               ToolTip="{DynamicResource Areas.DeleteTag}" AutomationProperties.Name="{DynamicResource Areas.DeleteTag}">
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </ui:Button>
                                    <TextBlock DockPanel.Dock="Left" Margin="0,0,4,0" VerticalAlignment="Center" Text="#" Foreground="{DynamicResource GM.TextMutedBrush}" />
                                    <TextBox MaxLength="40" Text="{Binding Name}" AutomationProperties.Name="{DynamicResource Areas.Name}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0">
                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource Areas.AddTag}" Command="{Binding AddTagCommand}" />
                        <ui:TextBox PlaceholderText="{DynamicResource Areas.NewTag}"
                                    MaxLength="41"
                                    Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{DynamicResource Areas.NewTag}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddTagCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </DockPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
