<Page x:Class="GoalMaker.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:tray="https://github.com/lukr-99/dotnetlib/tray"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Settings.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <!-- Settings on the dotnetlib settings kit (docs/design/spec.md, Settings): one scrolling page of
         section cards, a title and a one-line description each, rows split by thin dividers, the
         section list on the left (chips on a narrow window), the jump and scroll hints, and "Saved"
         next to each control. The order is SettingsSectionsViewModel.Order. -->
    <Page.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <!-- An area or a tag as a small pill. -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource GM.OutlineBrush}" />
        </Style>
        <!-- A theme card's small preview, drawn in that theme's colors and fonts. -->
        <DataTemplate x:Key="ThemeCard">
            <Border Padding="10" CornerRadius="3" Background="{Binding Background}" ToolTip="{Binding Summary}"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontFamily="{Binding HeadingFont}" FontSize="16" Foreground="{Binding Text}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Border Padding="6,0" CornerRadius="5" Background="{Binding Hero}">
                            <TextBlock Text="3/5" FontFamily="{Binding NumberFont}" FontSize="16" Foreground="{Binding HeroAccent}" />
                        </Border>
                        <Border Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="3" Background="{Binding Accent}" />
                        <Ellipse Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{Binding Primary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <tray:SettingsPage x:Name="Kit"
                       Title="{DynamicResource Settings.Title}"
                       ReduceMotion="{Binding PageReduceMotion}"
                       SavedText="{DynamicResource Settings.Saved}"
                       NavigationLabel="{DynamicResource Settings.Sections}"
                       SearchPlaceholder="{DynamicResource Settings.SearchPlaceholder}"
                       OneResultText="{DynamicResource Settings.OneResult}"
                       ResultCountFormat="{DynamicResource Settings.ResultCount}"
                       NoResultsTitle="{DynamicResource Settings.NoResultsTitle}"
                       NoResultsFormat="{DynamicResource Settings.NoResults}"
                       ClearSearchText="{DynamicResource Settings.ClearSearch}"
                       Background="{DynamicResource GM.BackgroundBrush}">

        <!-- What went wrong while nobody was watching (docs/problems.md); its view model is set in code. -->
        <tray:SettingsSection x:Name="ProblemsSection" SectionId="problems"
                              Title="{DynamicResource Problems.Title}" Description="{DynamicResource Settings.ProblemsDescription}"
                              Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl Margin="0,8,0,6" ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Advice}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding When}" FontSize="12" />
                            <Expander Margin="0,8,0,0" Header="{DynamicResource Problems.WhatHappened}"
                                      Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Margin="0,8,0,0" Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         BorderThickness="0" Background="Transparent" FontSize="12"
                                         Foreground="{DynamicResource GM.TextMutedBrush}"
                                         AutomationProperties.Name="{DynamicResource Problems.WhatHappened}" />
                            </Expander>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="account" Title="{DynamicResource Settings.Account}" Description="{DynamicResource Settings.AccountDescription}">
            <!-- A dev build that stays on this PC has no account (docs/sign-in.md). -->
            <tray:SettingsRow Label="{DynamicResource Settings.LocalOnlyTitle}" Hint="{DynamicResource Settings.LocalOnly}"
                              Visibility="{Binding IsLocalOnly, Converter={StaticResource BoolToVisibility}}" />
            <tray:InfoRow Label="{DynamicResource Settings.SignedInAs}" Value="{Binding Email}" Hint="{Binding SignsInAgain}"
                          Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
            <tray:ButtonRow Label="{DynamicResource Settings.SignOut}" Hint="{DynamicResource Settings.SignOutHint}"
                            ButtonText="{DynamicResource Settings.SignOut}" BusyText="{DynamicResource Settings.SigningOut}"
                            IsBusy="{Binding IsSigningOut}" Command="{Binding SignOutCommand}"
                            Result="{Binding SignOutWarning}" ResultKind="Error"
                            Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
            <!-- Only while changes haven't reached the server, as on the phone. -->
            <tray:SettingsDangerZone Label="{DynamicResource Settings.DangerZone}"
                                     Visibility="{Binding HasSignOutWarning, Converter={StaticResource BoolToVisibility}}">
                <tray:DangerRow x:Name="SignOutAnywayRow" Label="{DynamicResource Settings.SignOutAnyway}" Hint="{DynamicResource Settings.SignOutAnywayHint}"
                                ButtonText="{DynamicResource Settings.SignOutAnyway}" Command="{Binding SignOutAnywayCommand}"
                                ConfirmTitle="{DynamicResource Settings.SignOutAnywayAsk}" ConfirmMessage="{Binding SignOutAnywayLost}"
                                ConfirmText="{DynamicResource Settings.SignOutAnyway}" CancelText="{DynamicResource Settings.Cancel}" />
            </tray:SettingsDangerZone>
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="appearance" Title="{DynamicResource Settings.Appearance}" Description="{DynamicResource Settings.AppearanceDescription}">
            <tray:ChoiceCardsRow Label="{DynamicResource Settings.Theme}" Options="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                 OptionTemplate="{StaticResource ThemeCard}" />
            <!-- The mark takes on the theme's colors, and draws itself again when the theme changes. -->
            <tray:SettingsRow Label="{DynamicResource Settings.Logo}" Hint="{DynamicResource Settings.LogoHint}">
                <controls:GoalMakerLogo Width="44" Height="44" />
            </tray:SettingsRow>
            <tray:SegmentedRow Label="{DynamicResource Settings.Mode}" Options="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}"
                               DisplayMemberPath="Text" />
            <tray:ToggleRow Label="{DynamicResource Settings.PureBlack}" Hint="{DynamicResource Settings.PureBlackHint}"
                            DisabledReason="{DynamicResource Settings.PureBlackDisabled}"
                            IsOn="{Binding PureBlack}" IsEnabled="{Binding IsPureBlackAvailable}" />
            <tray:SegmentedRow Label="{DynamicResource Settings.ReduceMotion}" Hint="{DynamicResource Settings.ReduceMotionHint}"
                               Options="{Binding MotionOptions}" SelectedItem="{Binding SelectedMotion}" DisplayMemberPath="Text" />
            <tray:ToggleRow Label="{DynamicResource Settings.CompletionSound}" Hint="{DynamicResource Settings.CompletionSoundHint}"
                            IsOn="{Binding CompletionSound}" />
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="planning" Title="{DynamicResource Settings.Planning}" Description="{DynamicResource Settings.PlanningDescription}">
            <tray:DropdownRow Label="{DynamicResource Settings.DayStart}" Hint="{DynamicResource Settings.DayStartHint}"
                              Options="{Binding DayStartOptions}" SelectedItem="{Binding SelectedDayStart}" DisplayMemberPath="Text" />

            <!-- Each reminder: a switch, and while it is on its time in half hours, saved when the slider is let go. -->
            <tray:ToggleRow Label="{DynamicResource Settings.PlanReminder}" Hint="{Binding PlanReminderSummary}" IsOn="{Binding PlanReminderOn}" />
            <tray:SliderRow Label="{DynamicResource Settings.ReminderTime}" Minimum="0" Maximum="47" Step="1"
                            Value="{Binding PlanReminderHalf}"
                            ValueFormatter="{x:Static vm:SettingsViewModel.HalfHourFormatter}"
                            Visibility="{Binding PlanReminderOn, Converter={StaticResource BoolToVisibility}}" />

            <tray:ToggleRow Label="{DynamicResource Settings.WeeklyReview}" Hint="{Binding WeeklyReviewSummary}" IsOn="{Binding WeeklyReviewOn}" />
            <tray:SliderRow Label="{DynamicResource Settings.ReminderTime}" Minimum="0" Maximum="47" Step="1"
                            Value="{Binding WeeklyReviewHalf}"
                            ValueFormatter="{x:Static vm:SettingsViewModel.HalfHourFormatter}"
                            Visibility="{Binding WeeklyReviewOn, Converter={StaticResource BoolToVisibility}}" />
            <tray:DropdownRow Label="{DynamicResource Settings.WeeklyReviewDay}" Options="{Binding WeekdayOptions}"
                              SelectedItem="{Binding SelectedWeeklyReviewDay}" DisplayMemberPath="Text"
                              Visibility="{Binding WeeklyReviewOn, Converter={StaticResource BoolToVisibility}}" />

            <tray:ToggleRow Label="{DynamicResource Settings.MonthlyReview}" Hint="{Binding MonthlyReviewSummary}" IsOn="{Binding MonthlyReviewOn}" />
            <tray:SliderRow Label="{DynamicResource Settings.ReminderTime}" Minimum="0" Maximum="47" Step="1"
                            Value="{Binding MonthlyReviewHalf}"
                            ValueFormatter="{x:Static vm:SettingsViewModel.HalfHourFormatter}"
                            Visibility="{Binding MonthlyReviewOn, Converter={StaticResource BoolToVisibility}}" />

            <tray:ToggleRow Label="{DynamicResource Settings.WantsReady}" Hint="{Binding WantsReadySummary}" IsOn="{Binding WantsReadyOn}" />
            <tray:SliderRow Label="{DynamicResource Settings.ReminderTime}" Minimum="0" Maximum="47" Step="1"
                            Value="{Binding WantsReadyHalf}"
                            ValueFormatter="{x:Static vm:SettingsViewModel.HalfHourFormatter}"
                            Visibility="{Binding WantsReadyOn, Converter={StaticResource BoolToVisibility}}" />
            <!-- The why reminder (docs/life-goals.md): how often, at a moment worked out the same on both devices. -->
            <tray:DropdownRow Label="{DynamicResource Settings.Why}" Hint="{DynamicResource Settings.WhyHint}"
                              Options="{Binding WhyOptions}" SelectedItem="{Binding SelectedWhy}" DisplayMemberPath="Text" />

            <!-- Quiet hours (docs/reminders.md): typed times, saved on Enter or when the field is left. -->
            <tray:ButtonRow Label="{DynamicResource Settings.QuietHours}" Hint="{Binding QuietHoursSummary}"
                            ButtonText="{DynamicResource Settings.QuietHoursClear}" Command="{Binding TurnOffQuietHoursCommand}" />
            <tray:TextFieldRow Label="{DynamicResource Settings.QuietHoursStart}" Hint="{DynamicResource Settings.QuietHoursStartHint}"
                               Value="{Binding QuietHoursStartText}" Validate="{Binding ValidateTime}" Placeholder="22:00"
                               LastGoodValueText="{DynamicResource Settings.FieldKept}" />
            <tray:TextFieldRow Label="{DynamicResource Settings.QuietHoursEnd}" Hint="{DynamicResource Settings.QuietHoursEndHint}"
                               Value="{Binding QuietHoursEndText}" Validate="{Binding ValidateTime}" Placeholder="07:00"
                               LastGoodValueText="{DynamicResource Settings.FieldKept}" />
        </tray:SettingsSection>

        <!-- Areas and tags: the areas in use and the tags (AreasViewModel, set in code), and the way to the full manager. -->
        <tray:SettingsSection x:Name="AreasSection" SectionId="areas" Title="{DynamicResource Areas.Title}" Description="{DynamicResource Settings.AreasDescription}">
            <tray:SettingsGroupLabel Text="{DynamicResource Areas.Areas}" />
            <StackPanel Margin="0,8,0,4">
                <ItemsControl ItemsSource="{Binding Areas}" Focusable="False" AutomationProperties.Name="{DynamicResource Areas.Areas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource GM.SurfaceVariantBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Color.Brush}" />
                                    <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="{Binding Emoji, Mode=OneWay}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{DynamicResource Areas.None}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Areas.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <tray:SettingsGroupLabel Text="{DynamicResource Areas.Tags}" />
            <StackPanel Margin="0,8,0,4">
                <ItemsControl ItemsSource="{Binding Tags}" Focusable="False" AutomationProperties.Name="{DynamicResource Areas.Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding Name, Mode=OneWay, StringFormat=#{0}}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Areas.NoTagsYet}"
                           Visibility="{Binding HasNoTags, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <!-- Its DataContext is the sections view model, which knows the way to the Areas page. -->
            <tray:LinkRow x:Name="OpenAreasRow" Label="{DynamicResource Areas.Open}" Hint="{DynamicResource Areas.OpenHint}"
                          Command="{Binding OpenAreasCommand}" />
        </tray:SettingsSection>

        <!-- The Claude connector (docs/connector.md); its DataContext is the ConnectorViewModel, set in code. -->
        <tray:SettingsSection x:Name="ClaudeSection" SectionId="claude" Title="{DynamicResource Settings.Claude}" Description="{DynamicResource Settings.ClaudeDescription}">
            <tray:SettingsGroupLabel Text="{DynamicResource Connector.Title}" />
            <controls:ConnectorPanel />
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="quick-add" Title="{DynamicResource Settings.QuickAdd}" Description="{DynamicResource Settings.QuickAddDescription}">
            <!-- Press the new keys in the box; SettingsPage.xaml.cs turns them into the shortcut. -->
            <tray:SettingsRow x:Name="QuickAddRow" Label="{DynamicResource Settings.QuickAddShortcut}" Hint="{Binding QuickAddHotkeyStatus}"
                              ShowsSavedAutomatically="False">
                <TextBox x:Name="QuickAddShortcut" MinWidth="200" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         Style="{DynamicResource {x:Static tray:SettingsStyles.TextFieldKey}}"
                         Text="{Binding QuickAddHotkeyText, Mode=OneWay}" PreviewKeyDown="OnQuickAddShortcutKeyDown"
                         ToolTip="{DynamicResource Settings.QuickAddPress}"
                         AutomationProperties.Name="{DynamicResource Settings.QuickAddShortcut}"
                         AutomationProperties.HelpText="{DynamicResource Settings.QuickAddPress}" />
            </tray:SettingsRow>
            <tray:ButtonRow Label="{DynamicResource Settings.QuickAddResetTitle}" Hint="{DynamicResource Settings.QuickAddResetHint}"
                            ButtonText="{DynamicResource Settings.QuickAddReset}" Command="{Binding ResetQuickAddHotkeyCommand}" />
            <tray:ButtonRow Label="{DynamicResource Settings.QuickAddTurnOffTitle}" Hint="{DynamicResource Settings.QuickAddOffHint}"
                            ButtonText="{DynamicResource Settings.QuickAddTurnOff}" Command="{Binding TurnOffQuickAddHotkeyCommand}" />
        </tray:SettingsSection>

        <!-- Startup: GoalMaker's own (story 81) and the ask that hands it to Startup Profiles (story 84). -->
        <tray:SettingsSection SectionId="startup" Title="{DynamicResource Settings.Startup}" Description="{DynamicResource Settings.StartupDescription}">
            <tray:ToggleRow Label="{DynamicResource Settings.StartWithWindows}" Hint="{DynamicResource Settings.StartWithWindowsHint}"
                            IsOn="{Binding StartsWithWindows}" />
            <tray:ButtonRow Label="{DynamicResource Settings.StartupProfiles}" Hint="{DynamicResource Settings.StartupProfilesHint}"
                            ButtonText="{DynamicResource Settings.StartupProfilesAdd}" Command="{Binding AddToStartupProfilesCommand}"
                            Result="{Binding StartupProfilesStatus}" ResultKind="Success"
                            Visibility="{Binding HasStartupProfiles, Converter={StaticResource BoolToVisibility}}" />
        </tray:SettingsSection>

        <!-- The mini windows (spec, story 80); the tray and the mini switch open the same two. -->
        <tray:SettingsSection SectionId="mini-windows" Title="{DynamicResource Settings.MiniWindows}" Description="{DynamicResource Settings.MiniWindowsDescription}">
            <tray:LinkRow Label="{DynamicResource Tray.MiniToday}" Hint="{DynamicResource Settings.MiniWindowHint}" Command="{Binding OpenTodayMiniCommand}" />
            <tray:LinkRow Label="{DynamicResource Tray.MiniHabits}" Hint="{DynamicResource Settings.MiniWindowHint}" Command="{Binding OpenHabitsMiniCommand}" />
        </tray:SettingsSection>

        <!-- Your data (docs/backup.md): one file with everything, the weekly one, and Restore in the danger zone at the end. -->
        <tray:SettingsSection SectionId="data" Title="{DynamicResource Settings.Backup}" Description="{DynamicResource Settings.DataDescription}">
            <tray:ButtonRow Label="{DynamicResource Settings.BackupExportTitle}" Hint="{DynamicResource Settings.BackupExportHint}"
                            ButtonText="{DynamicResource Settings.BackupExport}" Command="{Binding ExportDataCommand}"
                            Result="{Binding ExportResult}" ResultKind="{Binding ExportResultKind}" />
            <tray:ButtonRow Label="{DynamicResource Settings.BackupWeekly}" Hint="{Binding WeeklyBackupHint}"
                            ButtonText="{DynamicResource Settings.BackupWeeklyChoose}" Command="{Binding ChooseWeeklyBackupCommand}"
                            Result="{Binding WeeklyResult}" ResultKind="{Binding WeeklyResultKind}" />
            <tray:ButtonRow Label="{DynamicResource Settings.BackupWeeklyStopTitle}" Hint="{DynamicResource Settings.BackupWeeklyStopHint}"
                            ButtonText="{DynamicResource Settings.BackupWeeklyOffButton}" Command="{Binding TurnOffWeeklyBackupCommand}"
                            Visibility="{Binding HasWeeklyBackup, Converter={StaticResource BoolToVisibility}}" />
            <tray:SettingsDangerZone Label="{DynamicResource Settings.DangerZone}">
                <tray:DangerRow Label="{DynamicResource Settings.BackupRestoreTitle}" Hint="{DynamicResource Settings.BackupRestoreHint}"
                                ButtonText="{DynamicResource Settings.BackupRestore}" Command="{Binding RestoreFromFileCommand}"
                                Result="{Binding RestoreResult}" ResultKind="{Binding RestoreResultKind}" />
            </tray:SettingsDangerZone>
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="updates" Title="{DynamicResource Settings.Updates}" Description="{DynamicResource Settings.UpdatesDescription}">
            <!-- An update the check found: the accent row, as the mark on the Settings item promised. -->
            <Grid Margin="0,10,0,10" AutomationProperties.Name="{Binding AvailableText}"
                  Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}">
                <Border CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.AccentBrush}" Opacity="0.12" />
                <Border CornerRadius="{DynamicResource GM.RowCorner}" BorderBrush="{DynamicResource GM.AccentBrush}" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource GM.AccentBrush}" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownload20" Filled="True" FontSize="18" Foreground="{DynamicResource GM.OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Text="{Binding AvailableText}" TextWrapping="Wrap"
                                   FontSize="15" FontFamily="{DynamicResource GM.BodyStrongFont}" Foreground="{DynamicResource GM.TextBrush}" />
                        <ui:Button Grid.Column="2" Appearance="Primary" VerticalAlignment="Center" Content="{Binding InstallText}"
                                   Command="{Binding InstallUpdateCommand}" />
                    </Grid>
                </Border>
            </Grid>
            <ProgressBar Margin="0,6,0,6" Maximum="1" Value="{Binding DownloadProgress}"
                         Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
            <tray:ButtonRow x:Name="CheckRow" Label="{DynamicResource Settings.CheckUpdates}" Hint="{Binding UpdateCheckHint}"
                            ButtonText="{DynamicResource Settings.CheckNow}" BusyText="{DynamicResource Settings.Update.Checking}"
                            IsBusy="{Binding IsChecking}" Command="{Binding CheckForUpdatesCommand}"
                            Result="{Binding UpdateResult}" ResultKind="{Binding UpdateStatusKind}" />
            <tray:LinkRow Label="{DynamicResource Settings.Update.DownloadYourself}" Hint="{DynamicResource Settings.Update.Manual}"
                          IsExternal="True" Command="{Binding OpenReleasesPageCommand}"
                          Visibility="{Binding HasReleasesPage, Converter={StaticResource BoolToVisibility}}" />
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="about" Title="{DynamicResource Settings.About}" Description="{DynamicResource Settings.AboutDescription}">
            <tray:InfoRow Label="{DynamicResource Settings.Version}" Value="{Binding VersionValue}" />
            <tray:InfoRow Label="{DynamicResource Settings.Backend}" Value="{Binding BackendValue}" IsMonospace="True" />
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="developer" Title="{DynamicResource Settings.Developer}" Description="{DynamicResource Settings.DeveloperDescription}"
                              Visibility="{Binding IsDevBuild, Converter={StaticResource BoolToVisibility}}">
            <tray:TextFieldRow Label="{DynamicResource Settings.BackendUrl}" Hint="{DynamicResource Settings.BackendHint}"
                               Value="{Binding BackendUrlDraft}" Validate="{Binding ValidateBackendUrl}"
                               LastGoodValueText="{DynamicResource Settings.FieldKept}" />
            <tray:TextFieldRow Label="{DynamicResource Settings.BackendKey}" Hint="{DynamicResource Settings.BackendKeyHint}"
                               Value="{Binding BackendKeyDraft}" Validate="{Binding ValidateBackendKey}" LastGoodValueText="" />
            <tray:ButtonRow Label="{DynamicResource Settings.BackendSaveTitle}" Hint="{DynamicResource Settings.BackendSaveHint}"
                            ButtonText="{DynamicResource Settings.BackendSave}" IsPrimary="True" Command="{Binding SaveBackendCommand}" />
            <tray:ButtonRow Label="{DynamicResource Settings.BackendResetTitle}" Hint="{DynamicResource Settings.BackendResetHint}"
                            ButtonText="{DynamicResource Settings.BackendReset}" Command="{Binding ResetBackendCommand}" />
        </tray:SettingsSection>
    </tray:SettingsPage>
</Page>
