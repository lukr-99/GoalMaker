<Page x:Class="GoalMaker.App.Views.LifeGoalsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource LifeGoals.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <Page.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
        </Style>
        <!-- The editor and the delete question take the page while they're open. -->
        <Style x:Key="Overlay" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GM.BackgroundBrush}" />
        </Style>

        <!-- A whole card that is one button: Enter or a click edits it; the dashed focus frame shows where the keyboard is. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small round button over a picture: back and forward through a card's pictures. -->
        <Style x:Key="PictureTurn" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Round" CornerRadius="18" Background="{DynamicResource GM.SurfaceBrush}" Opacity="0.85">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Round" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A card's menu: on a right click, the menu key or its "more" button. One per card. -->
        <ContextMenu x:Key="CardMenu" x:Shared="False">
            <MenuItem Header="{DynamicResource LifeGoals.Edit}" Command="{Binding EditCommand}" />
            <MenuItem Header="{DynamicResource LifeGoals.Achieve}" Command="{Binding AchieveCommand}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{DynamicResource LifeGoals.Drop}" Command="{Binding DropCommand}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{DynamicResource LifeGoals.MoveUp}" Command="{Binding MoveUpCommand}" Visibility="{Binding CanMoveUp, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{DynamicResource LifeGoals.MoveDown}" Command="{Binding MoveDownCommand}" Visibility="{Binding CanMoveDown, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{DynamicResource LifeGoals.Reopen}" Command="{Binding ReopenCommand}" Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{DynamicResource LifeGoals.Delete}" Command="{Binding DeleteCommand}" Foreground="{DynamicResource GM.DangerBrush}" />
        </ContextMenu>

        <!--
          One life goal: its pictures to click through (Left and Right on the focused card), or its first
          letter on the accent; the title, the time left and the why in full. Enter edits it; a right click,
          the menu key or the "more" button has the rest.
        -->
        <DataTemplate x:Key="LifeGoalCard" DataType="{x:Type vm:LifeGoalCardViewModel}">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,14" Command="{Binding EditCommand}"
                    ContextMenu="{StaticResource CardMenu}"
                    AutomationProperties.Name="{Binding CardName}"
                    AutomationProperties.HelpText="{DynamicResource LifeGoals.CardHelp}">
                <Button.InputBindings>
                    <KeyBinding Key="Left" Command="{Binding PreviousPictureCommand}" />
                    <KeyBinding Key="Right" Command="{Binding NextPictureCommand}" />
                </Button.InputBindings>
                <Border CornerRadius="{DynamicResource GM.CardCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                    <StackPanel>
                        <Grid Height="320" Visibility="{Binding ShowsPictures, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="{DynamicResource GM.CardCorner}" Background="{DynamicResource GM.SurfaceVariantBrush}"
                                    ToolTip="{DynamicResource LifeGoals.PictureWaiting}"
                                    Visibility="{Binding Shown.IsWaiting, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="Image24" FontSize="32" Foreground="{DynamicResource GM.TextMutedBrush}" />
                            </Border>
                            <Border CornerRadius="{DynamicResource GM.CardCorner}" AutomationProperties.Name="{Binding Shown.Name}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Shown.Image}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Button Style="{StaticResource PictureTurn}" HorizontalAlignment="Left" Command="{Binding PreviousPictureCommand}"
                                    ToolTip="{DynamicResource LifeGoals.PreviousPicture}" AutomationProperties.Name="{DynamicResource LifeGoals.PreviousPicture}"
                                    Visibility="{Binding HasManyPictures, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource PictureTurn}" HorizontalAlignment="Right" Command="{Binding NextPictureCommand}"
                                    ToolTip="{DynamicResource LifeGoals.NextPicture}" AutomationProperties.Name="{DynamicResource LifeGoals.NextPicture}"
                                    Visibility="{Binding HasManyPictures, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" />
                            </Button>
                            <ItemsControl Margin="0,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Focusable="False" IsHitTestVisible="False"
                                          ItemsSource="{Binding Dots}" Visibility="{Binding HasManyPictures, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="7" Height="7" Margin="3,0" Fill="White" Opacity="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid Height="320" Visibility="{Binding ShowsLetter, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="{DynamicResource GM.CardCorner}" Background="{DynamicResource GM.AccentBrush}" Opacity="0.18" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Letter}" FontSize="56"
                                       FontFamily="{DynamicResource GM.HeadingFont}" Foreground="{DynamicResource GM.AccentBrush}" />
                        </Grid>
                        <DockPanel Margin="18,12,8,16">
                            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="8" BorderThickness="0"
                                       controls:MenuButton.OpensMenu="True" ContextMenu="{StaticResource CardMenu}"
                                       ToolTip="{Binding MenuName}" AutomationProperties.Name="{Binding MenuName}">
                                <ui:SymbolIcon Symbol="MoreVertical24" />
                            </ui:Button>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="20" FontFamily="{DynamicResource GM.BodyStrongFont}" TextWrapping="Wrap" />
                                <TextBlock x:Name="Status" Margin="0,2,0,0" Text="{Binding Status}" FontSize="13" FontFamily="{DynamicResource GM.BodyStrongFont}"
                                           Foreground="{DynamicResource GM.AccentBrush}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="0,8,0,0" Text="{Binding Why}" FontSize="15" TextWrapping="Wrap"
                                           Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A picture in the editor, with its remove button on the corner. -->
        <DataTemplate x:Key="EditorPicture" DataType="{x:Type vm:LifeGoalPictureViewModel}">
            <Grid Width="96" Height="96" Margin="0,0,8,8">
                <Border CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceVariantBrush}">
                    <ui:SymbolIcon Symbol="Image24" Foreground="{DynamicResource GM.TextMutedBrush}" />
                </Border>
                <Border CornerRadius="{DynamicResource GM.RowCorner}" AutomationProperties.Name="{Binding Name}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="4" MinWidth="0" MinHeight="0"
                           Command="{Binding RemoveCommand}"
                           ToolTip="{DynamicResource LifeGoals.RemovePicture}" AutomationProperties.Name="{DynamicResource LifeGoals.RemovePicture}">
                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                </ui:Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Page.InputBindings>
        <!-- A new life goal, from anywhere on the page. -->
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}" />
    </Page.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Life goals (docs/life-goals.md): the open ones in the owner's order, then the achieved and dropped ones folded. -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{DynamicResource GM.PagePadding}" MaxWidth="{DynamicResource GM.PageWidth}" HorizontalAlignment="Stretch">
                <DockPanel Margin="0,0,0,12">
                    <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Appearance="Primary" Command="{Binding AddCommand}"
                               Content="{DynamicResource LifeGoals.Add}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <controls:HeadlineText Title="{DynamicResource LifeGoals.Title}" FontSize="40" />
                </DockPanel>

                <TextBlock Style="{StaticResource Hint}" FontSize="15" Text="{DynamicResource LifeGoals.Empty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl x:Name="OpenCards" ItemsSource="{Binding Open}" ItemTemplate="{StaticResource LifeGoalCard}" Focusable="False" />

                <ui:Button Margin="0,4,0,8" Appearance="Transparent" BorderThickness="0" Command="{Binding ToggleClosedCommand}"
                           Visibility="{Binding HasClosed, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.Name="{Binding ClosedLabel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{Binding ClosedLabel}" FontFamily="{DynamicResource GM.BodyStrongFont}"
                                   Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <ui:SymbolIcon Margin="6,0,0,0" FontSize="16" Foreground="{DynamicResource GM.TextMutedBrush}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ChevronDown24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsClosed}" Value="True">
                                            <Setter Property="Symbol" Value="ChevronUp24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </StackPanel>
                </ui:Button>
                <ItemsControl x:Name="ClosedCards" ItemsSource="{Binding Closed}" ItemTemplate="{StaticResource LifeGoalCard}" Focusable="False"
                              Visibility="{Binding ShowsClosed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Undo for the last achieved, dropped or deleted life goal, for five seconds. -->
        <Border Grid.Row="1" Margin="24,0,24,16" Padding="16,6,6,6" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.HeroBrush}"
                MaxWidth="{DynamicResource GM.PageWidth}"
                Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Foreground="{DynamicResource GM.HeroAccentBrush}"
                           Content="{DynamicResource Lists.Undo}" Command="{Binding UndoCommand}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding UndoText}" Foreground="{DynamicResource GM.OnHeroBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Adding or editing a life goal. Picture files dropped anywhere on it are added. -->
        <Border x:Name="EditorOverlay" Grid.RowSpan="2" Style="{StaticResource Overlay}" AllowDrop="True"
                DragEnter="OnPictureDragOver" DragOver="OnPictureDragOver" Drop="OnPictureDrop"
                Visibility="{Binding Editor.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ui:Card Margin="24" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Editor}">
                    <ui:Card.InputBindings>
                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
                    </ui:Card.InputBindings>
                    <StackPanel Width="480">
                        <TextBlock Margin="0,0,0,8" Text="{Binding Heading}" FontSize="20" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource LifeGoals.What}" />
                        <ui:TextBox x:Name="TitleBox" MaxLength="200" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{DynamicResource LifeGoals.What}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource LifeGoals.Why}" />
                        <ui:TextBox MaxLength="2000" MinLines="3" TextWrapping="Wrap" AcceptsReturn="True"
                                    Text="{Binding Why, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{DynamicResource LifeGoals.Why}"
                                    AutomationProperties.HelpText="{DynamicResource LifeGoals.WhyHint}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{DynamicResource LifeGoals.WhyHint}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource LifeGoals.By}" />
                        <ComboBox ItemsSource="{Binding ByChoices}" SelectedItem="{Binding By}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{DynamicResource LifeGoals.By}" />
                        <DatePicker Margin="0,8,0,0" SelectedDate="{Binding PickedDay}" DisplayDateStart="{Binding FirstDay, Mode=OneWay}"
                                    AutomationProperties.Name="{DynamicResource LifeGoals.PickDay}"
                                    Visibility="{Binding PicksDay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource LifeGoals.Pictures}" />
                        <ItemsControl ItemsSource="{Binding Pictures}" ItemTemplate="{StaticResource EditorPicture}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ui:Button HorizontalAlignment="Left" Command="{Binding AddPicturesCommand}" Content="{DynamicResource LifeGoals.AddPicture}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ImageAdd24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{DynamicResource LifeGoals.DropHint}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding PictureProblem}" TextWrapping="Wrap" Foreground="{DynamicResource GM.DangerBrush}"
                                   Visibility="{Binding HasPictureProblem, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button Command="{Binding CancelCommand}" Content="{DynamicResource LifeGoals.Cancel}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource LifeGoals.Save}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </ScrollViewer>
        </Border>

        <!-- Delete asks first, with Cancel focused: the pictures go too. -->
        <Border Grid.RowSpan="2" Style="{StaticResource Overlay}" Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
            <ui:Card Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:Card.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding CancelDeleteCommand}" />
                </ui:Card.InputBindings>
                <StackPanel Width="360">
                    <TextBlock Text="{Binding DeleteQuestion}" FontSize="20" TextWrapping="Wrap" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{DynamicResource LifeGoals.DeleteDetail}" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button x:Name="CancelDelete" Command="{Binding CancelDeleteCommand}" Content="{DynamicResource LifeGoals.Cancel}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Danger" Command="{Binding ConfirmDeleteCommand}" Content="{DynamicResource LifeGoals.Delete}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Border>
    </Grid>
</Page>
