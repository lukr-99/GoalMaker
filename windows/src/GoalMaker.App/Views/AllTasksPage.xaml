<Page x:Class="GoalMaker.App.Views.AllTasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource AllTasks.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <!-- All tasks (docs/all-tasks.md): every open task grouped by area, searched as you type and filtered. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{DynamicResource GM.PageWidth}" HorizontalAlignment="Center" Margin="{DynamicResource GM.PagePadding}">
            <controls:HeadlineText Margin="0,0,0,16" Title="{DynamicResource AllTasks.Title}" FontSize="40" />
            <ui:TextBox Margin="0,0,0,12" PlaceholderText="{DynamicResource AllTasks.Search}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{DynamicResource AllTasks.Search}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <WrapPanel Margin="0,0,0,12">
                <CheckBox Margin="0,0,16,0" VerticalAlignment="Center" Content="{DynamicResource AllTasks.ProjectItems}"
                          IsChecked="{Binding ShowProjectItems}" />
                <ContentControl Focusable="False" VerticalAlignment="Center"
                                Content="{Binding Filters}" ContentTemplate="{StaticResource ListFilters}"
                                Visibility="{Binding Filters.HasAny, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource GM.TextMutedBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AllTasksGroupViewModel}">
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding AreaBrush}"
                                         Visibility="{Binding HasBrush, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AllTasksRowViewModel}">
                                        <Border Margin="{DynamicResource GM.RowGap}" Padding="12,6" MinHeight="{DynamicResource GM.RowMinHeight}"
                                                CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                                            <DockPanel VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Local">
                                                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource Focus.Complete}" Command="{Binding CompleteCommand}" />
                                                <ui:Button DockPanel.Dock="Right" TabIndex="0" Padding="6" Appearance="Transparent" Command="{Binding OpenCommand}"
                                                           ToolTip="{DynamicResource Lists.OpenTask}" AutomationProperties.Name="{DynamicResource Lists.OpenTask}">
                                                    <ui:SymbolIcon Symbol="Open24" />
                                                </ui:Button>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DateText}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasDate, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource GM.DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ContentControl Margin="0,1" VerticalAlignment="Center" Focusable="False"
                                                                        Content="{Binding Project}" ContentTemplate="{StaticResource ProjectTag}"
                                                                        Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
