<Page x:Class="GoalMaker.App.Views.ArchivePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Archive.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <!-- The archive of done tasks (M2-12): search as you type, open one, or reopen it. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- As wide as the window allows, up to 760, from the left. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="760" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Margin="{DynamicResource GM.PagePadding}">
            <controls:HeadlineText Margin="0,0,0,16" Title="{DynamicResource Archive.Title}" FontSize="40" />
            <ui:TextBox Margin="0,0,0,12" PlaceholderText="{DynamicResource Archive.Search}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{DynamicResource Archive.Search}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource GM.TextMutedBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ArchiveRowViewModel}">
                        <Border Margin="{DynamicResource GM.RowGap}" Padding="12,6" MinHeight="{DynamicResource GM.RowMinHeight}"
                                CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                            <DockPanel VerticalAlignment="Center">
                                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource Archive.Reopen}" Command="{Binding ReopenCommand}" />
                                <ui:Button DockPanel.Dock="Right" Padding="6" Appearance="Transparent" Command="{Binding OpenCommand}"
                                           ToolTip="{DynamicResource Lists.OpenTask}" AutomationProperties.Name="{DynamicResource Lists.OpenTask}">
                                    <ui:SymbolIcon Symbol="Open24" />
                                </ui:Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DoneText}" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
