<UserControl x:Class="GoalMaker.App.Views.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:GoalMaker.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="460" Margin="32" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <controls:GoalMakerLogo Width="36" Height="36" Margin="0,0,12,0" />
                <TextBlock VerticalAlignment="Center"
                           Text="{DynamicResource App.Name}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
            <TextBlock Margin="0,12,0,24"
                       Text="{DynamicResource SignIn.Title}"
                       FontSize="36"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <ui:Card Padding="24">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsEmailStep, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBox x:Name="EmailBox"
                                    PlaceholderText="{DynamicResource SignIn.EmailLabel}"
                                    AutomationProperties.Name="{DynamicResource SignIn.EmailLabel}"
                                    AutomationProperties.HelpText="{DynamicResource SignIn.EmailHint}"
                                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsIdle}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendCodeCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <TextBlock Margin="4,8,0,16"
                                   Text="{DynamicResource SignIn.EmailHint}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:Button HorizontalAlignment="Stretch"
                                   Height="44"
                                   Appearance="Primary"
                                   Content="{DynamicResource SignIn.SendCode}"
                                   Command="{Binding SendCodeCommand}"
                                   IsEnabled="{Binding IsIdle}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsCodeStep, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,0,0,12" Text="{Binding CodeSentText}" TextWrapping="Wrap" FontSize="15" />
                        <ui:TextBox x:Name="CodeBox"
                                    PlaceholderText="{DynamicResource SignIn.CodeLabel}"
                                    AutomationProperties.Name="{DynamicResource SignIn.CodeLabel}"
                                    Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="24"
                                    MaxLength="6"
                                    IsEnabled="{Binding IsIdle}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding VerifyCodeCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button Margin="0,16,0,8"
                                   HorizontalAlignment="Stretch"
                                   Height="44"
                                   Appearance="Primary"
                                   Content="{DynamicResource SignIn.Verify}"
                                   Command="{Binding VerifyCodeCommand}"
                                   IsEnabled="{Binding IsIdle}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:HyperlinkButton Content="{DynamicResource SignIn.Resend}" Command="{Binding SendCodeCommand}" />
                            <ui:HyperlinkButton Content="{DynamicResource SignIn.UseAnotherEmail}" Command="{Binding UseAnotherEmailCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <ui:ProgressRing Margin="0,16,0,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding ErrorText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Status.ErrorBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ui:Card>

            <TextBlock Margin="4,16,0,0"
                       Text="{Binding DevBackendText}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
