<Page x:Class="GoalMaker.App.Views.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Calendar.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <Page.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <!-- The view on show reads as chosen. -->
        <Style x:Key="WeekButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Appearance" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeek}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                    <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonthButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Appearance" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMonth}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                    <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Weekday" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>

        <!-- One day of the grid. -->
        <DataTemplate x:Key="DayCell" DataType="{x:Type vm:CalendarCellViewModel}">
            <ui:Button Margin="2" Padding="0" Height="64" HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                       Appearance="Transparent" Command="{Binding OpenCommand}"
                       AutomationProperties.Name="{Binding Day}">
                <Border CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontSize="13" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource GM.TextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InPeriod}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                                            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                                            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Height="4" Margin="0,4,0,0" CornerRadius="2" HorizontalAlignment="Center"
                                Width="{Binding BarWidth}" Background="{DynamicResource GM.AccentBrush}"
                                Visibility="{Binding HasAnything, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </ui:Button>
        </DataTemplate>

        <!-- One line of what a day holds. -->
        <DataTemplate x:Key="DayEntry" DataType="{x:Type vm:CalendarEntryViewModel}">
            <ui:Button Margin="0,0,0,6" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Appearance="Transparent" Command="{Binding OpenCommand}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <TextBlock Text="{Binding Time}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Visibility="{Binding HasTime, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </ui:Button>
        </DataTemplate>
    </Page.Resources>

    <!-- The calendar (docs/calendar.md): the grid on the left, the day the owner picked beside it. -->
    <Grid Margin="{DynamicResource GM.PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <controls:HeadlineText Title="{DynamicResource Calendar.Title}" FontSize="32" />
            <DockPanel Margin="0,8,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Padding="8,4" Appearance="Transparent" Command="{Binding BackCommand}"
                               ToolTip="{DynamicResource Calendar.Back}" AutomationProperties.Name="{DynamicResource Calendar.Back}">
                        <ui:SymbolIcon Symbol="ChevronLeft24" />
                    </ui:Button>
                    <ui:Button Margin="4,0,0,0" Padding="8,4" Appearance="Transparent" Command="{Binding Today_Command}"
                               Content="{DynamicResource Calendar.Today}" />
                    <ui:Button Margin="4,0,0,0" Padding="8,4" Appearance="Transparent" Command="{Binding ForwardCommand}"
                               ToolTip="{DynamicResource Calendar.Forward}" AutomationProperties.Name="{DynamicResource Calendar.Forward}">
                        <ui:SymbolIcon Symbol="ChevronRight24" />
                    </ui:Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Period}" FontSize="16" FontFamily="{DynamicResource GM.BodyStrongFont}"
                               VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource WeekButton}" Command="{Binding ShowCommand}"
                               CommandParameter="week" Content="{DynamicResource Calendar.Week}" />
                    <ui:Button Style="{StaticResource MonthButton}" Command="{Binding ShowCommand}"
                               CommandParameter="month" Content="{DynamicResource Calendar.Month}" />
                </StackPanel>
            </DockPanel>

            <primitives:UniformGrid Columns="7">
                <TextBlock Style="{StaticResource Weekday}" Text="{Binding Weekdays[0]}" />
                <TextBlock Style="{StaticResource Weekday}" Text="{Binding Weekdays[1]}" />
                <TextBlock Style="{StaticResource Weekday}" Text="{Binding Weekdays[2]}" />
                <TextBlock Style="{StaticResource Weekday}" Text="{Binding Weekdays[3]}" />
                <TextBlock Style="{StaticResource Weekday}" Text="{Binding Weekdays[4]}" />
                <TextBlock Style="{StaticResource Weekday}" Text="{Binding Weekdays[5]}" />
                <TextBlock Style="{StaticResource Weekday}" Text="{Binding Weekdays[6]}" />
            </primitives:UniformGrid>

            <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource DayCell}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <primitives:UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Calendar.PickADay}"
                           Visibility="{Binding HasNoDay, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Visibility="{Binding HasDay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DayTitle}" FontSize="16" FontFamily="{DynamicResource GM.BodyStrongFont}"
                               Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Calendar.DayEmpty}"
                               Visibility="{Binding IsDayEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding DayEntries}" ItemTemplate="{StaticResource DayEntry}" Focusable="False" />
                    <TextBlock Text="{Binding DayReminders}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource GM.TextMutedBrush}"
                               Visibility="{Binding HasReminders, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
