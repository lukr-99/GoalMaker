<Page x:Class="GoalMaker.App.Views.FocusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Focus.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <!-- The Focus Board: a manually-ordered watchlist of open tasks with deadlines. -->
    <Grid>
        <!-- Main board (hidden while add panel is open) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsAddClosed, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <StackPanel MaxWidth="{DynamicResource GM.PageWidth}" HorizontalAlignment="Center" Margin="{DynamicResource GM.PagePadding}">
                    <controls:HeadlineText Margin="0,0,0,16" Title="{DynamicResource Focus.Title}" FontSize="40" />
                    <TextBlock Text="{DynamicResource Focus.Empty}" Foreground="{DynamicResource GM.TextMutedBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FocusRowViewModel}">
                                <Border Margin="{DynamicResource GM.RowGap}" Padding="12,8" MinHeight="{DynamicResource GM.RowMinHeight}"
                                        CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                                    <DockPanel VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Local">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Vertical" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <ui:Button Padding="4" Appearance="Transparent"
                                                       Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="{DynamicResource Focus.MoveUp}"
                                                       AutomationProperties.Name="{DynamicResource Focus.MoveUp}">
                                                <ui:SymbolIcon Symbol="ChevronUp20" />
                                            </ui:Button>
                                            <ui:Button Padding="4" Appearance="Transparent"
                                                       Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="{DynamicResource Focus.MoveDown}"
                                                       AutomationProperties.Name="{DynamicResource Focus.MoveDown}">
                                                <ui:SymbolIcon Symbol="ChevronDown20" />
                                            </ui:Button>
                                        </StackPanel>
                                        <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="{DynamicResource Focus.Complete}"
                                                   Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6" Appearance="Transparent"
                                                   Command="{Binding DataContext.RemoveFromBoardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="{DynamicResource Focus.Remove}"
                                                   AutomationProperties.Name="{DynamicResource Focus.Remove}">
                                            <ui:SymbolIcon Symbol="PinOff24" />
                                        </ui:Button>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource GM.TextMutedBrush}"
                                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Add to board panel (shown when IsAddOpen) -->
        <Grid Background="{DynamicResource GM.BackgroundBrush}"
              Visibility="{Binding IsAddOpen, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="{DynamicResource GM.PageWidth}" HorizontalAlignment="Center" Margin="{DynamicResource GM.PagePadding}">
                    <controls:HeadlineText Margin="0,0,0,16" Title="{DynamicResource Focus.AddTitle}" FontSize="32" />
                    <TextBlock Text="{DynamicResource Focus.AddEmpty}" Foreground="{DynamicResource GM.TextMutedBrush}"
                               Visibility="{Binding IsCandidatesEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Candidates}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FocusAddRowViewModel}">
                                <Border Margin="{DynamicResource GM.RowGap}" Padding="12,8" MinHeight="{DynamicResource GM.RowMinHeight}"
                                        CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                                    <DockPanel VerticalAlignment="Center">
                                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource Focus.Add}"
                                                   Command="{Binding DataContext.AddToBoardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource GM.TextMutedBrush}"
                                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FAB: Add when board is shown; Back when add panel is open -->
        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                   Appearance="Primary" Content="{DynamicResource Focus.Add}"
                   Command="{Binding ShowAddDialogCommand}"
                   Visibility="{Binding IsAddClosed, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24"
                   Appearance="Secondary" Content="{DynamicResource Task.Back}"
                   Command="{Binding CloseAddDialogCommand}"
                   Visibility="{Binding IsAddOpen, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
