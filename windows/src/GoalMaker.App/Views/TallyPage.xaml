<Page x:Class="GoalMaker.App.Views.TallyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Tally.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <Page.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,20,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="{DynamicResource GM.CardCorner}" />
            <Setter Property="Background" Value="{DynamicResource GM.SurfaceBrush}" />
        </Style>
        <!-- Minutes and hours in the theme's number face, which has tabular figures. -->
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource GM.NumberFont}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- A filter chip: a chosen one carries the accent, as on the Wants page; a category shows its color. -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Tint" CornerRadius="{DynamicResource GM.ChipCorner}" Background="{DynamicResource GM.AccentBrush}" Opacity="0" />
                            <Border x:Name="Edge" CornerRadius="{DynamicResource GM.ChipCorner}" BorderThickness="1" BorderBrush="{DynamicResource GM.OutlineBrush}" Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="Tick" Symbol="Checkmark16" FontSize="13" Margin="0,0,6,0" Visibility="Collapsed"
                                                   Foreground="{DynamicResource GM.AccentBrush}" />
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Brush}"
                                             Visibility="{Binding HasBrush, Converter={StaticResource BoolToVisibility}}" />
                                    <ContentPresenter VerticalAlignment="Center" TextElement.FontFamily="{DynamicResource GM.BodyStrongFont}"
                                                      TextElement.Foreground="{DynamicResource GM.TextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.2" />
                                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource GM.AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource GM.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Edge" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One category in a legend: its swatch, emoji, name and time. -->
        <DataTemplate x:Key="Legend" DataType="{x:Type vm:TallySegmentViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Emoji}" Margin="0,0,4,0" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Name}" Margin="0,0,6,0" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Style="{StaticResource Number}" Text="{Binding Value}"
                           Foreground="{DynamicResource GM.TextMutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <!--
            One day of the week: its time on top, its categories stacked, its name underneath; today's name in
            the accent. The whole bar is a button that shows the day closer up; the day shown is underlined.
        -->
        <DataTemplate x:Key="DayBar" DataType="{x:Type vm:TallyBarViewModel}">
            <Button Command="{Binding Pick}" Cursor="Hand" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}"
                    Margin="2,0" Padding="2,0" HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GM.OutlineBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GM.AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <!-- Two lines' room, so "5 h 20 min" wraps in a narrow window and every bar starts at the same height. -->
                    <Grid Height="30">
                        <TextBlock Text="{Binding Value}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Bottom"
                                   Style="{StaticResource Number}" Foreground="{DynamicResource GM.TextMutedBrush}" />
                    </Grid>
                    <controls:StackedBar Height="120" Margin="6,2,6,0" Parts="{Binding Parts}" Fraction="{Binding Fraction}" />
                    <TextBlock x:Name="Day" Text="{Binding Label}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    <Border x:Name="Picked" Height="2" Margin="10,2,10,2" CornerRadius="1" Background="{DynamicResource GM.AccentBrush}" Visibility="Hidden" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                    <Setter TargetName="Day" Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Picked" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One clock hour of the day on this PC: its share of the hour and its categories stacked. -->
        <DataTemplate x:Key="HourBar" DataType="{x:Type vm:TallyHourViewModel}">
            <controls:StackedBar Height="72" Margin="1,0" Parts="{Binding Parts}" Fraction="{Binding Fraction}" ToolTip="{Binding Tip}" />
        </DataTemplate>

        <!-- A site or folder under an app, with Make a rule. -->
        <DataTemplate x:Key="WindowRow" DataType="{x:Type vm:TallyWindowRowViewModel}">
            <DockPanel Margin="16,0,0,0">
                <ui:Button DockPanel.Dock="Right" Padding="8,2" Appearance="Transparent" FontSize="12" Command="{Binding MakeRuleCommand}"
                           Content="{DynamicResource Tally.MakeRule}" AutomationProperties.Name="{Binding MakeRuleName}" />
                <TextBlock DockPanel.Dock="Right" Margin="12,0,4,0" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Number}"
                           Text="{Binding Value}" Foreground="{DynamicResource GM.TextMutedBrush}" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource GM.TextMutedBrush}" />
            </DockPanel>
        </DataTemplate>

        <!-- An app under a category: its executable, its time, Make a rule, and its sites or folders. -->
        <DataTemplate x:Key="AppRow" DataType="{x:Type vm:TallyAppRowViewModel}">
            <StackPanel Margin="26,2,0,4">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Padding="8,2" Appearance="Transparent" FontSize="12" Command="{Binding MakeRuleCommand}"
                               Content="{DynamicResource Tally.MakeRule}" AutomationProperties.Name="{Binding MakeRuleName}" />
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,4,0" VerticalAlignment="Center" Style="{StaticResource Number}" Text="{Binding Value}" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="{Binding App}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Windows}" ItemTemplate="{StaticResource WindowRow}" Focusable="False"
                              Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- A category of this PC's apps: a row that opens to its apps. -->
        <DataTemplate x:Key="AppGroup" DataType="{x:Type vm:TallyAppGroupViewModel}">
            <StackPanel Margin="0,0,0,2">
                <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" Focusable="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              ToolTip="{DynamicResource Tally.ShowApps}" AutomationProperties.HelpText="{DynamicResource Tally.ShowApps}">
                    <AutomationProperties.Name>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="Name" />
                            <Binding Path="Value" />
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Row" Padding="8,6" CornerRadius="{DynamicResource GM.RowCorner}" Background="Transparent"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <DockPanel>
                                    <ui:SymbolIcon x:Name="Chevron" DockPanel.Dock="Right" Margin="8,0,0,0" Symbol="ChevronDown20" FontSize="14"
                                                   Foreground="{DynamicResource GM.TextMutedBrush}" />
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Number}" Text="{Binding Value}"
                                               Foreground="{DynamicResource GM.AccentBrush}" />
                                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Emoji}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Symbol" Value="ChevronUp20" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource GM.OutlineBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource GM.AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}" Focusable="False"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- A project's time this week against the project with the most. -->
        <DataTemplate x:Key="ProjectRow" DataType="{x:Type vm:TallyProjectViewModel}">
            <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" MinWidth="72" TextAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource Number}" Text="{Binding Value}" Foreground="{DynamicResource GM.AccentBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <controls:ShareBar Height="6" Margin="0,4,0,0" Flat="True" Fraction="{Binding Fraction}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- One of the owner's rules, with Edit and Delete. -->
        <DataTemplate x:Key="RuleRow" DataType="{x:Type vm:TallyRuleRowViewModel}">
            <Border Margin="0,0,0,6" Padding="12,6" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding EditCommand}"
                                   ToolTip="{DynamicResource Tally.EditRule}" AutomationProperties.Name="{DynamicResource Tally.EditRule}">
                            <ui:SymbolIcon Symbol="Edit24" />
                        </ui:Button>
                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding DeleteCommand}"
                                   ToolTip="{DynamicResource Tally.DeleteRule}" AutomationProperties.Name="{DynamicResource Tally.DeleteRule}">
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button>
                    </StackPanel>
                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Pattern}" FontSize="14" FontFamily="{DynamicResource GM.BodyStrongFont}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- One of the owner's categories, with Edit and Delete. -->
        <DataTemplate x:Key="CategoryRow" DataType="{x:Type vm:TallyCategoryRowViewModel}">
            <Border Margin="0,0,0,6" Padding="12,6" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding EditCommand}"
                                   ToolTip="{DynamicResource Tally.EditCategory}" AutomationProperties.Name="{DynamicResource Tally.EditCategory}">
                            <ui:SymbolIcon Symbol="Edit24" />
                        </ui:Button>
                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding DeleteCommand}"
                                   ToolTip="{DynamicResource Tally.DeleteCategory}" AutomationProperties.Name="{DynamicResource Tally.DeleteCategory}">
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button>
                    </StackPanel>
                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Emoji}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CategoryChoice" DataType="{x:Type vm:FilterChoiceViewModel}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ColorOption" DataType="{x:Type vm:ColorOptionViewModel}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!-- Tally (docs/tally.md): the switch, the filters, the day, its hours and apps on this PC, the week, the projects, and the owner's rules and categories. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource GM.PagePadding}" MaxWidth="{DynamicResource GM.WidePageWidth}" HorizontalAlignment="Center">
            <controls:HeadlineText Title="{DynamicResource Tally.Title}" FontSize="40" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,8" Text="{DynamicResource Tally.Hint}" />

            <!-- The switch: a setting row with what stays here, and what syncs underneath. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="{Binding TallyOn}"
                                         AutomationProperties.Name="{DynamicResource Tally.On}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Tally.On}" FontFamily="{DynamicResource GM.BodyStrongFont}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Tally.Kept}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{DynamicResource Tally.Synced}" />
                </StackPanel>
            </Border>

            <!-- Phone, PC and a chip per category with time: a chosen one narrows everything below. -->
            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Chips}" Focusable="False"
                          AutomationProperties.Name="{DynamicResource Tally.Filters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FilterOptionViewModel}">
                        <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding Command}" CommandParameter="{Binding Id}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Tally.Empty}"
                       Visibility="{Binding HasNoTime, Converter={StaticResource BoolToVisibility}}" />

            <!-- The day: today, or the day picked in the week, on every device. -->
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Margin="0,12,0,4" Appearance="Transparent" Command="{Binding ShowTodayCommand}"
                           Content="{DynamicResource Tally.ShowToday}"
                           Visibility="{Binding IsNotToday, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Bottom" Text="{Binding DayTitle}" />
            </DockPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Number}" Text="{Binding DayTotal}" FontSize="28" Foreground="{DynamicResource GM.AccentBrush}" />
                    <controls:StackedBar Height="20" Margin="0,8,0,10" Flat="True" Parts="{Binding DayParts}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{Binding DayEmpty}"
                               Visibility="{Binding HasNoDay, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding DayLegend}" ItemTemplate="{StaticResource Legend}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- This PC's own look at the day, from its log: by hour, then its apps, sites and folders. -->
            <StackPanel Visibility="{Binding ShowLocal, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Tally.ByHour}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel AutomationProperties.Name="{Binding HoursDescription}">
                        <ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource HourBar}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <primitives:UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- The time every six hours, each over its quarter of the day. -->
                        <ItemsControl ItemsSource="{Binding HourMarks}" Focusable="False" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <primitives:UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10" Style="{StaticResource Number}" Foreground="{DynamicResource GM.TextMutedBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Tally.Apps}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding DayChoice}" Command="{Binding ShowAppsCommand}" CommandParameter="day"
                                          IsChecked="{Binding AppsForDay, Mode=OneWay}" />
                            <ToggleButton Style="{StaticResource FilterChip}" Content="{DynamicResource Tally.AppsWeek}" Command="{Binding ShowAppsCommand}"
                                          CommandParameter="week" IsChecked="{Binding AppsForWeek, Mode=OneWay}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{DynamicResource Tally.AppsOnlyHere}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{DynamicResource Tally.AppsNone}"
                                   Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppGroup}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0" Text="{DynamicResource Tally.AppsPhone}"
                       Visibility="{Binding ShowLocalElsewhere, Converter={StaticResource BoolToVisibility}}" />

            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Margin="0,20,4,6" VerticalAlignment="Bottom" FontSize="12" Style="{StaticResource Number}"
                           Text="{Binding WeekTotal}" Foreground="{DynamicResource GM.TextMutedBrush}" />
                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Tally.ThisWeek}" />
            </DockPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding WeekDays}" ItemTemplate="{StaticResource DayBar}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <primitives:UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{DynamicResource Tally.WeekHint}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasProjects, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Tally.Projects}" />
                <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ProjectRow}" Focusable="False" />
            </StackPanel>

            <!-- The owner's rules: tried before the shipped ones, first match wins. -->
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Margin="0,12,0,4" Appearance="Transparent" Command="{Binding AddRuleCommand}"
                           Content="{DynamicResource Tally.AddRule}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button.Icon>
                </ui:Button>
                <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Bottom" Text="{DynamicResource Tally.Rules}" />
            </DockPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource GM.AccentBrush}"
                    Visibility="{Binding IsEditingRule, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding RulePanelTitle}" FontSize="18" FontFamily="{DynamicResource GM.HeadingFont}" Foreground="{DynamicResource GM.AccentBrush}" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Tally.Matches}" />
                            <ComboBox ItemsSource="{Binding MatchChoices}" SelectedItem="{Binding DraftMatch}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="{DynamicResource Tally.Matches}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Tally.Platform}" />
                            <ComboBox ItemsSource="{Binding PlatformChoices}" SelectedItem="{Binding DraftPlatform}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="{DynamicResource Tally.Platform}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Tally.Pattern}" />
                    <ui:TextBox x:Name="DraftPattern" Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                AutomationProperties.Name="{DynamicResource Tally.Pattern}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding PatternHint}" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Tally.CountsAs}" />
                            <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding DraftCategory}" ItemTemplate="{StaticResource CategoryChoice}"
                                      AutomationProperties.Name="{DynamicResource Tally.CountsAs}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Tally.Project}" />
                            <ComboBox ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding DraftProject}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="{DynamicResource Tally.Project}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource GM.DangerBrush}" Text="{DynamicResource Tally.RuleRefused}"
                               Visibility="{Binding RuleRefused, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button Appearance="Transparent" Content="{DynamicResource Tally.Cancel}" Command="{Binding CancelRuleCommand}" Margin="0,0,8,0" />
                        <ui:Button Appearance="Primary" Content="{DynamicResource Tally.Save}" Command="{Binding SaveRuleCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Tally.RulesNone}"
                       Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Rules}" ItemTemplate="{StaticResource RuleRow}" Focusable="False" />

            <!-- The owner's categories, beside the shipped ones. -->
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Margin="0,12,0,4" Appearance="Transparent" Command="{Binding AddCategoryCommand}"
                           Content="{DynamicResource Tally.AddCategory}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button.Icon>
                </ui:Button>
                <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Bottom" Text="{DynamicResource Tally.Categories}" />
            </DockPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource GM.AccentBrush}"
                    Visibility="{Binding IsEditingCategory, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding CategoryPanelTitle}" FontSize="18" FontFamily="{DynamicResource GM.HeadingFont}" Foreground="{DynamicResource GM.AccentBrush}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Tally.Name}" />
                    <ui:TextBox x:Name="DraftName" Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                AutomationProperties.Name="{DynamicResource Tally.Name}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Tally.Color}" />
                            <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding DraftColor}" ItemTemplate="{StaticResource ColorOption}"
                                      AutomationProperties.Name="{DynamicResource Tally.Color}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Tally.Emoji}" />
                            <ui:TextBox Text="{Binding DraftEmoji, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"
                                        AutomationProperties.Name="{DynamicResource Tally.Emoji}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button Appearance="Transparent" Content="{DynamicResource Tally.Cancel}" Command="{Binding CancelCategoryCommand}" Margin="0,0,8,0" />
                        <ui:Button Appearance="Primary" Content="{DynamicResource Tally.Save}" Command="{Binding SaveCategoryCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Tally.CategoriesNone}"
                       Visibility="{Binding HasNoCategories, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryRow}" Focusable="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
