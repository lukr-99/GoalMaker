<Page x:Class="GoalMaker.App.Views.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Stats.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <Page.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,20,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="{DynamicResource GM.RowCorner}" />
            <Setter Property="Background" Value="{DynamicResource GM.SurfaceBrush}" />
        </Style>

        <!--
            One week of the tasks chart: everything done in the faded accent, and the project work in the
            full accent from the bottom, so the bar reads as project work under the rest (docs/stats.md).
        -->
        <DataTemplate x:Key="WeekBar" DataType="{x:Type vm:StatsBarViewModel}">
            <StackPanel Margin="3,0" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                <TextBlock Text="{Binding Value}" FontSize="11" HorizontalAlignment="Center"
                           Foreground="{DynamicResource GM.TextMutedBrush}" />
                <Grid Height="78">
                    <controls:ShareBar Track="False" Fraction="{Binding Fraction}" Filled="{Binding Filled}">
                        <controls:ShareBar.Style>
                            <Style TargetType="controls:ShareBar">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasProjectWork, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:ShareBar.Style>
                    </controls:ShareBar>
                    <controls:ShareBar Track="False" Fraction="{Binding ProjectFraction}" Filled="True"
                                       Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- One project in the By project block: its name, a bar against the busiest, and what it finished. -->
        <DataTemplate x:Key="ProjectRow" DataType="{x:Type vm:StatsProjectViewModel}">
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="14" MinWidth="28" TextAlignment="Right"
                           FontFamily="{DynamicResource GM.NumberFont}" Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource GM.AccentBrush}" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <controls:ShareBar Height="6" Margin="0,4,0,0" Flat="True" Fraction="{Binding Fraction}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- One column of the goals chart, which names its month underneath. -->
        <DataTemplate x:Key="MonthBar" DataType="{x:Type vm:StatsBarViewModel}">
            <StackPanel Margin="4,0">
                <TextBlock Text="{Binding Value}" FontSize="11" HorizontalAlignment="Center"
                           Foreground="{DynamicResource GM.TextMutedBrush}" />
                <controls:ShareBar Height="70" Fraction="{Binding Fraction}" Filled="{Binding Filled}" />
                <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- One week of Tally: its time on top, its categories stacked from the bottom. -->
        <DataTemplate x:Key="TallyWeek" DataType="{x:Type vm:TallyBarViewModel}">
            <StackPanel Margin="3,0" ToolTip="{Binding Tip}">
                <controls:StackedBar Height="90" Parts="{Binding Parts}" Fraction="{Binding Fraction}" />
            </StackPanel>
        </DataTemplate>

        <!-- One category in the Tally legend: its swatch, name and time over the twelve weeks. -->
        <DataTemplate x:Key="TallyLegend" DataType="{x:Type vm:TallySegmentViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Emoji}" Margin="0,0,4,0" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Name}" Margin="0,0,6,0" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Value}" FontFamily="{DynamicResource GM.NumberFont}"
                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource GM.TextMutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- One habit over the window. -->
        <DataTemplate x:Key="HabitRow" DataType="{x:Type vm:StatsHabitViewModel}">
            <Border Margin="0,0,0,6" Padding="12,8"
                    CornerRadius="{DynamicResource GM.RowCorner}"
                    Background="{DynamicResource GM.SurfaceBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Emoji}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" MinWidth="64" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Rate}" FontSize="16" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource GM.AccentBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="{DynamicResource Stats.Streak}">
                            <ui:SymbolIcon Symbol="Fire24" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Streak}" FontSize="11" Margin="3,0,0,0"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" />
                        <controls:ShareBar Height="6" Margin="0,4,0,4" Flat="True" Fraction="{Binding Fraction}" />
                        <TextBlock Text="{Binding Met}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- Stats (docs/stats.md): the long view of tasks, goals, habits and how the weeks felt. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource GM.PagePadding}" MaxWidth="{DynamicResource GM.WidePageWidth}" HorizontalAlignment="Center">
            <controls:HeadlineText Title="{DynamicResource Stats.Title}" FontSize="40" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,8" Text="{DynamicResource Stats.Hint}" />

            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Stats.Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <primitives:UniformGrid Rows="1" Margin="0,8,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DoneValue}" FontSize="28" Foreground="{DynamicResource GM.AccentBrush}" />
                        <TextBlock Text="{DynamicResource Stats.Done}" FontSize="12" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                        <TextBlock Text="{Binding DonePerWeek}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <TextBlock Text="{Binding DoneOnProjects}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Visibility="{Binding HasProjectWork, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="{Binding GoalsValue}" FontSize="28" Foreground="{DynamicResource GM.AccentBrush}" />
                        <TextBlock Text="{DynamicResource Stats.Goals}" FontSize="12" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                        <TextBlock Text="{Binding GoalsHint}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding HabitsValue}" FontSize="28" Foreground="{DynamicResource GM.AccentBrush}" />
                        <TextBlock Text="{DynamicResource Stats.Habits}" FontSize="12" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                        <TextBlock Text="{Binding HabitsHint}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </primitives:UniformGrid>

            <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Stats.TasksAWeek}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Weeks}" ItemTemplate="{StaticResource WeekBar}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <primitives:UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding FirstWeek}" FontSize="11"
                                   Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <TextBlock HorizontalAlignment="Right" Text="{DynamicResource Stats.ThisWeek}" FontSize="11"
                                   Foreground="{DynamicResource GM.TextMutedBrush}" />
                    </DockPanel>
                    <!-- Which part of a bar is which, once any of the weeks had project work. -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding HasProjectWork, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource GM.AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProjectWorkLegend}" FontSize="11" Margin="6,0,16,0" VerticalAlignment="Center" />
                        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource GM.AccentBrush}" Opacity="0.45" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OtherWorkLegend}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The projects that finished the most over the same weeks. -->
            <StackPanel Visibility="{Binding HasProjectWork, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Stats.ByProject}" />
                <Border Style="{StaticResource Card}" Padding="12,12,12,4">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ByProject}" ItemTemplate="{StaticResource ProjectRow}" Focusable="False" />
                        <TextBlock Text="{Binding MoreProjects}" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Visibility="{Binding HasMoreProjects, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding HasMonths, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Stats.GoalsAMonth}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Months}" ItemTemplate="{StaticResource MonthBar}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <primitives:UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding HasHabits, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Stats.HabitsSection}" />
                <ItemsControl ItemsSource="{Binding HabitRows}" ItemTemplate="{StaticResource HabitRow}" Focusable="False" />
            </StackPanel>

            <StackPanel Visibility="{Binding HasRatings, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Stats.Ratings}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <controls:RatingLines x:Name="Chart" Height="120" Ratings="{Binding Ratings}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource GM.AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Reviews.Mood}" FontSize="11" Margin="6,0,16,0" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding EnergyLineBrush, ElementName=Chart}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Reviews.Energy}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding HasWants, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Stats.Wants}" />
                <primitives:UniformGrid Rows="1">
                    <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="{Binding WantsBought}" FontSize="28" Foreground="{DynamicResource GM.AccentBrush}" />
                            <TextBlock Text="{DynamicResource Stats.WantsBought}" FontSize="12" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="{Binding WantsDropped}" FontSize="28" Foreground="{DynamicResource GM.AccentBrush}" />
                            <TextBlock Text="{DynamicResource Stats.WantsDropped}" FontSize="12" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding WantsNotSpent}" FontSize="28" Foreground="{DynamicResource GM.AccentBrush}" />
                            <TextBlock Text="{DynamicResource Stats.WantsNotSpent}" FontSize="12" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                            <TextBlock Text="{Binding WantsCurrency}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </primitives:UniformGrid>
            </StackPanel>

            <!-- Where the time went over twelve weeks (Tally, docs/tally.md), once there is any. -->
            <StackPanel Visibility="{Binding HasTally, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Stats.Tally}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding TallyTotal}" FontSize="28" FontFamily="{DynamicResource GM.NumberFont}" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource GM.AccentBrush}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding TallyPerWeek}" FontSize="12" Margin="12,0,0,6" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TallyWeeks}" ItemTemplate="{StaticResource TallyWeek}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <primitives:UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <DockPanel Margin="0,8,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding TallyFirstWeek}" FontSize="11"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" />
                            <TextBlock HorizontalAlignment="Right" Text="{DynamicResource Stats.ThisWeek}" FontSize="11"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TallyLegend}" ItemTemplate="{StaticResource TallyLegend}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
