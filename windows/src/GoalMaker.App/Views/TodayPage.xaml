<Page x:Class="GoalMaker.App.Views.TodayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{DynamicResource Today.Title}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="{StaticResource Space.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Today.Title}" FontSize="40" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,24"
                       Text="{Binding Greeting}"
                       FontSize="15"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                VerticalAlignment="Top"
                Padding="24"
                CornerRadius="{StaticResource Shape.Card}"
                Background="{DynamicResource Brand.PrimaryBrush}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Today.SpineTitle}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brand.OnPrimaryBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{DynamicResource Today.SpineBody}"
                           FontSize="15"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brand.OnPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- The composer (spec: chat-app layout). It becomes the quick-add box in M2. -->
        <Border Grid.Row="2"
                Padding="20,14"
                CornerRadius="{StaticResource Shape.Composer}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Send24" Foreground="{DynamicResource TextFillColorDisabledBrush}" />
                <TextBlock Text="{DynamicResource Today.ComposerPlaceholder}"
                           FontSize="15"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Page>
