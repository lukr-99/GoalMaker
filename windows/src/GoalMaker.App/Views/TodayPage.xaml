<Page x:Class="GoalMaker.App.Views.TodayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{DynamicResource Today.Title}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="{StaticResource Space.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Bottom"
                       Text="{Binding SyncText}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <StackPanel>
                <TextBlock Text="{DynamicResource Today.Title}" FontSize="40" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding Greeting}"
                           FontSize="15"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="4,8,0,0"
                           Text="{DynamicResource Today.Empty}"
                           FontSize="15"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="14,8"
                                    CornerRadius="{StaticResource Shape.Card}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right"
                                               Appearance="Transparent"
                                               Command="{Binding DeleteCommand}"
                                               ToolTip="{DynamicResource Today.Delete}"
                                               AutomationProperties.Name="{DynamicResource Today.Delete}">
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </ui:Button>
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding IsDone}"
                                              AutomationProperties.Name="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" />
                                    </CheckBox>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The composer (spec: chat-app layout). Shortcut parsing arrives in M2. -->
        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="8,4"
                CornerRadius="{StaticResource Shape.Composer}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Primary"
                           Command="{Binding AddTaskCommand}"
                           ToolTip="{DynamicResource Today.Add}"
                           AutomationProperties.Name="{DynamicResource Today.Add}">
                    <ui:SymbolIcon Symbol="Send24" />
                </ui:Button>
                <ui:TextBox x:Name="Composer"
                            Margin="0,0,8,0"
                            BorderThickness="0"
                            Background="Transparent"
                            PlaceholderText="{DynamicResource Today.ComposerPlaceholder}"
                            Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{DynamicResource Today.ComposerPlaceholder}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </DockPanel>
        </Border>
    </Grid>
</Page>
