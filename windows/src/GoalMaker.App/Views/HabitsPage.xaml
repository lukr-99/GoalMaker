<Page x:Class="GoalMaker.App.Views.HabitsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Habits.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <Page.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
        </Style>
        <!-- The editor and the log panel take the page while they're open. -->
        <Style x:Key="Overlay" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GM.BackgroundBrush}" />
        </Style>

        <!-- One habit: its ring (a click checks in), how often it runs, where today stands, and its heatmap. -->
        <DataTemplate x:Key="HabitRow" DataType="{x:Type vm:HabitRowViewModel}">
            <Border Margin="0,0,0,8"
                    Padding="12,10,6,12"
                    CornerRadius="{DynamicResource GM.CardCorner}"
                    Background="{DynamicResource GM.SurfaceBrush}">
                <!-- Right click, or the menu key on the focused row: the rest of what a habit can do. -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Habits.Log}" Command="{Binding LogCommand}" Visibility="{Binding CanLog, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="{DynamicResource Habits.Clear}" Command="{Binding ClearCommand}" Visibility="{Binding CanClear, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="{Binding SkipText}" Command="{Binding SkipCommand}" Visibility="{Binding CanSkip, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="{DynamicResource Habits.Unskip}" Command="{Binding UnskipCommand}" Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="{DynamicResource Habits.Pause}" Command="{Binding PauseCommand}" Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="{DynamicResource Habits.Resume}" Command="{Binding ResumeCommand}" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="{DynamicResource Habits.Archive}" Command="{Binding ArchiveCommand}" Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="{DynamicResource Habits.Unarchive}" Command="{Binding UnarchiveCommand}" Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="{DynamicResource Habits.Edit}" Command="{Binding EditCommand}" />
                        <MenuItem Header="{DynamicResource Habits.Delete}" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Padding="6" Appearance="Transparent" Command="{Binding DeleteCommand}"
                                   ToolTip="{DynamicResource Habits.Delete}" AutomationProperties.Name="{DynamicResource Habits.Delete}">
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button>
                        <ui:Button DockPanel.Dock="Right" Padding="6" Appearance="Transparent" Command="{Binding EditCommand}"
                                   ToolTip="{DynamicResource Habits.Edit}" AutomationProperties.Name="{DynamicResource Habits.Edit}">
                            <ui:SymbolIcon Symbol="Edit24" />
                        </ui:Button>
                        <ui:Button DockPanel.Dock="Right" Padding="6" Appearance="Transparent" Command="{Binding LogCommand}"
                                   Visibility="{Binding CanLog, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="{DynamicResource Habits.Log}" AutomationProperties.Name="{DynamicResource Habits.Log}">
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button>
                        <Button DockPanel.Dock="Left"
                                Width="48" Height="48" Margin="0,0,12,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding CheckInCommand}"
                                IsEnabled="{Binding CanCheckIn}"
                                ToolTip="{Binding CheckInText}"
                                AutomationProperties.Name="{Binding CheckInText}">
                            <Grid>
                                <controls:GoalRing Width="44" Height="44" Fraction="{Binding Fraction}" Thickness="4" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding RingText}" FontSize="15" />
                                <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Symbol="Checkmark20"
                                               Foreground="{DynamicResource GM.AccentBrush}"
                                               Visibility="{Binding ShowsCheck, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CadenceText}" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" />
                                <TextBlock Margin="6,0" Text="·" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StreakText}" FontSize="12"
                                       FontFamily="{DynamicResource GM.BodyStrongFont}"
                                       Foreground="{DynamicResource GM.AccentBrush}"
                                       Visibility="{Binding HasStreak, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Serves}" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}"
                                       Visibility="{Binding HasServes, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                    <controls:HabitHeatmap Margin="0,10,8,0" HorizontalAlignment="Left" Heat="{Binding Heat}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- Habits (docs/habits.md): today's rings, streaks and heatmaps; the editor and the log panel take the page. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="{DynamicResource GM.PagePadding}" MaxWidth="760" HorizontalAlignment="Left">
                <DockPanel Margin="0,0,0,12">
                    <ui:Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Appearance="Primary"
                               Command="{Binding NewHabitCommand}" Content="{DynamicResource Habits.Add}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <controls:HeadlineText Title="{DynamicResource Habits.Title}" FontSize="40" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Habits.Hint}" />
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Habits.Empty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource HabitRow}" Focusable="False" />

                <StackPanel Margin="0,8,0,0" Visibility="{Binding HasArchived, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Appearance="Transparent" Command="{Binding ToggleArchivedCommand}" Content="{Binding ArchivedHeader}" />
                    <ItemsControl ItemsSource="{Binding Archived}" ItemTemplate="{StaticResource HabitRow}" Focusable="False"
                                  Visibility="{Binding IsArchivedExpanded, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Adding or editing a habit. -->
        <Border Style="{StaticResource Overlay}" Visibility="{Binding Editor.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <ui:Card Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Editor}">
                <ui:Card.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
                </ui:Card.InputBindings>
                <StackPanel Width="432">
                    <TextBlock Margin="0,0,0,8" Text="{Binding Heading}" FontSize="20" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Habits.Name}" />
                    <ui:TextBox x:Name="NameBox" MaxLength="100" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="{DynamicResource Habits.Name}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Habits.Emoji}" />
                    <ui:TextBox MaxLength="16" Text="{Binding Emoji, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Habits.Emoji}" />
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding EmojiChoices}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EmojiChoiceViewModel}">
                                <Button Width="34" Height="34" Margin="0,0,4,4" Padding="0" Cursor="Hand" BorderThickness="0"
                                        Background="Transparent"
                                        Command="{Binding PickCommand}"
                                        Content="{Binding Emoji}"
                                        FontSize="17"
                                        AutomationProperties.Name="{Binding Emoji}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Habits.Cadence}" />
                    <ComboBox ItemsSource="{Binding Cadences}" SelectedItem="{Binding Cadence}" DisplayMemberPath="Label"
                              AutomationProperties.Name="{DynamicResource Habits.Cadence}" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Days}" Focusable="False"
                                  Visibility="{Binding IsWeekdays, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HabitDayViewModel}">
                                <ui:ToggleSwitch Margin="0,0,16,6" Content="{Binding Label}" IsChecked="{Binding IsChosen, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding IsTimes, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button DockPanel.Dock="Left" Padding="8" Command="{Binding FewerTimesCommand}"
                                   ToolTip="{DynamicResource Habits.Fewer}" AutomationProperties.Name="{DynamicResource Habits.Fewer}">
                            <ui:SymbolIcon Symbol="Subtract24" />
                        </ui:Button>
                        <ui:Button DockPanel.Dock="Right" Padding="8" Command="{Binding MoreTimesCommand}"
                                   ToolTip="{DynamicResource Habits.MoreTimes}" AutomationProperties.Name="{DynamicResource Habits.MoreTimes}">
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button>
                        <TextBlock Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding TimesLabel}" FontSize="14" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Habits.Measure}" />
                    <ComboBox ItemsSource="{Binding Measures}" SelectedItem="{Binding Measure}" DisplayMemberPath="Label"
                              AutomationProperties.Name="{DynamicResource Habits.Measure}" />
                    <Grid Visibility="{Binding IsCounted, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Habits.Target}" />
                            <ui:TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Habits.Target}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Habits.Unit}" />
                            <ui:TextBox MaxLength="20" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Habits.Unit}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Habits.Goal}" />
                    <ComboBox ItemsSource="{Binding GoalChoices}" SelectedItem="{Binding Goal}" DisplayMemberPath="Label"
                              AutomationProperties.Name="{DynamicResource Habits.Goal}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{DynamicResource Habits.GoalHint}" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource GM.DangerBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <DockPanel Margin="0,20,0,0">
                        <ui:Button DockPanel.Dock="Left" Appearance="Transparent" Command="{Binding DeleteCommand}" Content="{DynamicResource Habits.Delete}"
                                   Foreground="{DynamicResource GM.DangerBrush}"
                                   Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button Command="{Binding CancelCommand}" Content="{DynamicResource Habits.Cancel}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource Habits.Save}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ui:Card>
        </Border>

        <!-- Logging an amount on a count or amount habit. -->
        <Border Style="{StaticResource Overlay}" Visibility="{Binding IsLogging, Converter={StaticResource BoolToVisibility}}">
            <ui:Card Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:Card.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddAmountCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding CancelLogCommand}" />
                </ui:Card.InputBindings>
                <StackPanel Width="352">
                    <TextBlock Margin="0,0,0,8" Text="{Binding LogTitle}" FontSize="20" TextWrapping="Wrap" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Habits.LogAmount}" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding LogUnit}"
                                   Visibility="{Binding HasLogUnit, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBox x:Name="LogBox" Text="{Binding LogText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Habits.LogAmount}" />
                    </DockPanel>
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button Command="{Binding CancelLogCommand}" Content="{DynamicResource Habits.Cancel}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding AddAmountCommand}" Content="{DynamicResource Habits.LogAdd}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Border>

        <controls:ConfettiBurst x:Name="Confetti" />
    </Grid>
</Page>
