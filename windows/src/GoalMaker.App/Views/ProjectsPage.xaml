<Page x:Class="GoalMaker.App.Views.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Projects.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <Page.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
        </Style>

        <!--
          A project's status at a glance, read from the Tag: active plays on in the accent, paused and
          done step back in the muted colour, each with a mark of its own.
        -->
        <Style x:Key="StatusIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="PlayCircle24" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="paused">
                    <Setter Property="Symbol" Value="PauseCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="done">
                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GM.TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="paused">
                    <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="done">
                    <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One project in the list beside the board. -->
        <DataTemplate x:Key="ProjectRow" DataType="{x:Type vm:ProjectRowViewModel}">
            <ui:Button Margin="0,0,0,4" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Appearance="Transparent" Command="{Binding OpenCommand}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center"
                                       Tag="{Binding StatusId}" Style="{StaticResource StatusIcon}" />
                        <TextBlock Text="{Binding Name}" FontSize="14" Tag="{Binding StatusId}" Style="{StaticResource StatusName}" />
                    </StackPanel>
                    <!-- The status, then what Backlog, To do and Doing hold, so the load reads at a glance. -->
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <TextBlock Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding Backlog}"
                                   Foreground="{DynamicResource GM.AccentBrush}"
                                   ToolTip="{DynamicResource Projects.Backlog}" />
                        <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding Todo}"
                                   Foreground="{DynamicResource GM.AccentBrush}"
                                   ToolTip="{DynamicResource Projects.Todo}" />
                        <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding Doing}"
                                   Foreground="{DynamicResource GM.AccentBrush}"
                                   ToolTip="{DynamicResource Projects.Doing}" />
                    </StackPanel>
                </StackPanel>
            </ui:Button>
        </DataTemplate>

        <!-- A card's type: a plain task stays quiet, an idea takes the accent and a bug the danger colour. -->
        <Style x:Key="ItemTypeIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="TaskListSquareLtr24" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ItemType}" Value="idea">
                    <Setter Property="Symbol" Value="LightbulbFilament24" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ItemType}" Value="bug">
                    <Setter Property="Symbol" Value="Bug24" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemTypeLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ItemType}" Value="idea">
                    <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ItemType}" Value="bug">
                    <Setter Property="Foreground" Value="{DynamicResource GM.DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One card on the board. -->
        <DataTemplate x:Key="BoardCard" DataType="{x:Type vm:BoardItemViewModel}">
            <Border Margin="0,0,0,6" Padding="10,8"
                    CornerRadius="{DynamicResource GM.RowCorner}"
                    Background="{DynamicResource GM.SurfaceBrush}">
                <StackPanel>
                    <DockPanel>
                        <!-- The menu opens on a left click of the dots, as well as on a right click. -->
                        <ui:Button DockPanel.Dock="Right" Padding="4" Appearance="Transparent" Click="OnItemMenu"
                                   ToolTip="{DynamicResource Projects.ItemMenu}"
                                   AutomationProperties.Name="{DynamicResource Projects.ItemMenu}">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Projects.Backlog}" Command="{Binding MoveCommand}" CommandParameter="backlog" />
                                    <MenuItem Header="{DynamicResource Projects.Todo}" Command="{Binding MoveCommand}" CommandParameter="todo" />
                                    <MenuItem Header="{DynamicResource Projects.Doing}" Command="{Binding MoveCommand}" CommandParameter="doing" />
                                    <MenuItem Header="{DynamicResource Projects.Done}" Command="{Binding MoveCommand}" CommandParameter="done" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource Projects.OpenItem}" Command="{Binding OpenCommand}" />
                                    <MenuItem Header="{DynamicResource Projects.Archive}" Command="{Binding ArchiveCommand}"
                                              Visibility="{Binding CanArchive, Converter={StaticResource BoolToVisibility}}" />
                                    <MenuItem Header="{DynamicResource Projects.RemoveItem}" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <ui:SymbolIcon Symbol="MoreVertical24" />
                        </ui:Button>
                        <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <!-- An idea and a bug wear their own icon and colour, so a board reads at a glance. -->
                        <ui:SymbolIcon Margin="0,0,4,0" FontSize="12" VerticalAlignment="Center"
                                       Style="{StaticResource ItemTypeIcon}" />
                        <TextBlock Text="{Binding Type}" FontSize="11" Style="{StaticResource ItemTypeLabel}" />
                        <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <TextBlock Text="{Binding Priority}" FontSize="11" Foreground="{DynamicResource GM.AccentBrush}" />
                        <TextBlock Text="{Binding Day}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Visibility="{Binding HasDay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{DynamicResource Projects.ByClaude}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Visibility="{Binding MadeByClaude, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A done item that left the board, with its way back. -->
        <DataTemplate x:Key="ArchivedCard" DataType="{x:Type vm:ArchivedItemViewModel}">
            <Border Margin="0,0,0,4" Padding="10,6"
                    CornerRadius="{DynamicResource GM.RowCorner}"
                    Background="{DynamicResource GM.SurfaceBrush}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Padding="6,2" VerticalAlignment="Center" Appearance="Transparent"
                               FontSize="12" Command="{Binding PutBackCommand}" Content="{Binding ActionText}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <TextBlock Text="{Binding DoneText}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!--
          One column of the board. Folded, it is a narrow strip with its count and its name down the
          side, and a click opens it again; open, its header folds it.
        -->
        <DataTemplate x:Key="BoardColumn" DataType="{x:Type vm:BoardColumnViewModel}">
            <Grid Margin="0,0,10,0">
                <ui:Button Width="38" Padding="4,10" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                           HorizontalContentAlignment="Center" Appearance="Secondary"
                           Command="{Binding FoldCommand}" ToolTip="{Binding UnfoldText}"
                           AutomationProperties.Name="{Binding UnfoldText}"
                           Visibility="{Binding IsFolded, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding Count}"
                                   Foreground="{DynamicResource GM.AccentBrush}" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="11"
                                   FontFamily="{DynamicResource GM.BodyStrongFont}" Text="{Binding Title}"
                                   Foreground="{DynamicResource GM.AccentBrush}">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </ui:Button>
                <StackPanel MinWidth="200" Visibility="{Binding IsUnfolded, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="0,0,0,6">
                        <ui:Button DockPanel.Dock="Right" Padding="4" Appearance="Transparent" VerticalAlignment="Center"
                                   Command="{Binding FoldCommand}" ToolTip="{Binding FoldText}"
                                   AutomationProperties.Name="{Binding FoldText}">
                            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="12" />
                        </ui:Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ColumnTitle}" Margin="4,0,0,0" Text="{Binding Title}" />
                            <TextBlock Margin="6,0,0,0" FontSize="11" Text="{Binding Count}"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="11" Text="{DynamicResource Projects.ColumnEmpty}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BoardCard}" Focusable="False" />
                    <!-- Under Done: how many items left the board, which opens the list of them. -->
                    <StackPanel Visibility="{Binding HasArchived, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Margin="0,2,0,6" Padding="6,2" HorizontalAlignment="Left" Appearance="Transparent" FontSize="12"
                                   Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Command="{Binding ToggleArchivedCommand}" Content="{Binding ArchivedText}" />
                        <ItemsControl ItemsSource="{Binding Archived}" ItemTemplate="{StaticResource ArchivedCard}" Focusable="False"
                                      Visibility="{Binding ShowsArchived, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A board column shares the width while it is open and shrinks to its strip when folded. -->
        <Style x:Key="BoardColumnWidth" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="*" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolded}" Value="True">
                    <Setter Property="Width" Value="Auto" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- Projects (docs/projects.md): the projects on the left, the board of the one on show beside them. -->
    <Grid Margin="{DynamicResource GM.PagePaddingToEdge}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,16,0">
            <controls:HeadlineText Title="{DynamicResource Projects.Title}" FontSize="32" />
            <ui:Button Margin="0,8,0,8" HorizontalAlignment="Left" Appearance="Primary"
                       Command="{Binding NewCommand}" Content="{DynamicResource Projects.Add}" />
            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Projects.Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <!-- Every project filtered away: the filter stays over the board, where it can be let go. -->
            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Projects.NoneMatch}"
                       Visibility="{Binding IsFilteredAway, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ProjectRow}" Focusable="False" />
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <!-- The scrollbar rides the window's edge, and the page's own gutter keeps the content clear of it. -->
            <StackPanel Margin="{DynamicResource GM.PageGutter}">
                <!--
                  The area and tag filter (docs/projects.md) narrows the project list and the board, so
                  it sits over both, and stays when it filters every project away.
                -->
                <ContentControl Margin="0,0,0,12" Focusable="False" HorizontalAlignment="Left"
                                Content="{Binding Filters}" ContentTemplate="{StaticResource ListFilters}"
                                Visibility="{Binding Filters.HasAny, Converter={StaticResource BoolToVisibility}}" />
                <!-- The project on show, or the editor when one is being written. -->
                <Border Padding="12" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}"
                        Visibility="{Binding ShowsProject, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <!-- The status with its mark and the Edit button share one row, centred on each other. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:SymbolIcon Margin="0,0,4,0" FontSize="14" VerticalAlignment="Center"
                                           Tag="{Binding ProjectStatus}" Style="{StaticResource StatusIcon}" />
                            <TextBlock Margin="0,0,8,0" Text="{Binding ProjectStatusText}" FontSize="12" VerticalAlignment="Center"
                                       Tag="{Binding ProjectStatus}" Style="{StaticResource StatusName}" />
                            <ui:Button Appearance="Transparent" VerticalAlignment="Center" Command="{Binding EditCommand}"
                                       Content="{DynamicResource Projects.Edit}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ProjectName}" FontSize="18" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                            <TextBlock Text="{Binding ProjectDescription}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" />
                            <TextBlock Text="{Binding ProjectRepository}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                            <TextBlock Text="{Binding ProjectFolder}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Padding="12" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ui:TextBox PlaceholderText="{DynamicResource Projects.Name}" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="{DynamicResource Projects.Description}"
                                    Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="{DynamicResource Projects.Repository}"
                                    Text="{Binding ProjectRepository, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="{DynamicResource Projects.Folder}"
                                    Text="{Binding ProjectFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Margin="0,8,0,0" MinWidth="140" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Statuses}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding ProjectStatus}"
                                  AutomationProperties.Name="{DynamicResource Projects.Status}" />
                        <!-- The project's area: its items without one of their own count as in it. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" Text="{DynamicResource Projects.Area}" />
                            <ComboBox MinWidth="140" ItemsSource="{Binding ProjectAreaChoices}" SelectedItem="{Binding ProjectArea}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="{DynamicResource Projects.Area}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" Text="{DynamicResource Projects.ArchiveAfter}" />
                            <ComboBox MinWidth="120" ItemsSource="{Binding ArchiveChoices}"
                                      DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ProjectArchiveAfter}"
                                      AutomationProperties.Name="{DynamicResource Projects.ArchiveAfter}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource Goals.Save}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding CancelCommand}"
                                       Content="{DynamicResource Goals.Cancel}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding DeleteCommand}"
                                       Foreground="{DynamicResource GM.DangerBrush}" Content="{DynamicResource Projects.Delete}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                    <!-- A long title wraps down the box instead of running off to the right, and Return adds it. -->
                    <Grid Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" MinWidth="280" MaxHeight="140" TextWrapping="Wrap"
                                    VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                                    PlaceholderText="{DynamicResource Projects.ItemTitle}"
                                    Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddItemCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="110" VerticalAlignment="Top"
                                  ItemsSource="{Binding ItemTypes}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding NewItemType}"
                                  AutomationProperties.Name="{DynamicResource Projects.ItemType}" />
                        <ui:Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" Appearance="Primary"
                                   Command="{Binding AddItemCommand}" Content="{DynamicResource Projects.AddItem}" />
                    </Grid>

                    <!-- The new item's column (it follows the kind until one is picked), priority and notes. -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" MinWidth="110" VerticalAlignment="Top"
                                  ItemsSource="{Binding NewItemColumns}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding NewItemColumn}"
                                  ToolTip="{DynamicResource Projects.ItemColumn}"
                                  AutomationProperties.Name="{DynamicResource Projects.ItemColumn}" />
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="110" VerticalAlignment="Top"
                                  ItemsSource="{Binding Priorities}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding NewItemPriority}"
                                  ToolTip="{DynamicResource Projects.ItemPriority}"
                                  AutomationProperties.Name="{DynamicResource Projects.ItemPriority}" />
                        <ui:TextBox Grid.Column="2" Margin="8,0,0,0" MaxHeight="140" TextWrapping="Wrap" AcceptsReturn="True"
                                    VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                                    PlaceholderText="{DynamicResource Projects.ItemNotes}"
                                    Text="{Binding NewItemNotes, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- Who made the items on show: everyone, the owner, or Claude (docs/projects.md). -->
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource GM.TextMutedBrush}" Text="{DynamicResource Projects.MadeBy}" />
                        <ComboBox MinWidth="120" ItemsSource="{Binding MakerFilters}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding MadeByFilter}"
                                  AutomationProperties.Name="{DynamicResource Projects.MadeBy}" />
                    </StackPanel>

                    <!--
                      The open columns share the width when there is room, and a folded one keeps only
                      its strip. In a narrow window they stop shrinking and the board scrolls sideways,
                      so a card is never cut off and its menu stays on screen.
                    -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <!-- The board takes the width it is shown in, and what its columns need at the least, so a title still wraps. -->
                        <Grid MinWidth="{Binding BoardMinWidth}"
                              Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition DataContext="{Binding Columns[0]}" Style="{StaticResource BoardColumnWidth}" />
                                <ColumnDefinition DataContext="{Binding Columns[1]}" Style="{StaticResource BoardColumnWidth}" />
                                <ColumnDefinition DataContext="{Binding Columns[2]}" Style="{StaticResource BoardColumnWidth}" />
                                <ColumnDefinition DataContext="{Binding Columns[3]}" Style="{StaticResource BoardColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0" Focusable="False" Content="{Binding Columns[0]}" ContentTemplate="{StaticResource BoardColumn}" />
                            <ContentControl Grid.Column="1" Focusable="False" Content="{Binding Columns[1]}" ContentTemplate="{StaticResource BoardColumn}" />
                            <ContentControl Grid.Column="2" Focusable="False" Content="{Binding Columns[2]}" ContentTemplate="{StaticResource BoardColumn}" />
                            <ContentControl Grid.Column="3" Focusable="False" Content="{Binding Columns[3]}" ContentTemplate="{StaticResource BoardColumn}" />
                        </Grid>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Undo for the last item finished or taken out, for five seconds, as on the lists. -->
        <Border Grid.Row="1" Grid.Column="1"
                Margin="0,12,0,0"
                Padding="16,6,6,6"
                CornerRadius="{DynamicResource GM.RowCorner}"
                Background="{DynamicResource GM.HeroBrush}"
                Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Transparent"
                           Foreground="{DynamicResource GM.HeroAccentBrush}"
                           Content="{DynamicResource Lists.Undo}"
                           Command="{Binding UndoCommand}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding UndoText}" Foreground="{DynamicResource GM.OnHeroBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Page>
