<Page x:Class="GoalMaker.App.Views.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Projects.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <Page.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
        </Style>

        <!-- One project in the list beside the board. -->
        <DataTemplate x:Key="ProjectRow" DataType="{x:Type vm:ProjectRowViewModel}">
            <ui:Button Margin="0,0,0,4" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Appearance="Transparent" Command="{Binding OpenCommand}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="14" />
                    <!-- The status, then what Backlog, To do and Doing hold, so the load reads at a glance. -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <TextBlock Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding Backlog}"
                                   Foreground="{DynamicResource GM.AccentBrush}"
                                   ToolTip="{DynamicResource Projects.Backlog}" />
                        <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding Todo}"
                                   Foreground="{DynamicResource GM.AccentBrush}"
                                   ToolTip="{DynamicResource Projects.Todo}" />
                        <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding Doing}"
                                   Foreground="{DynamicResource GM.AccentBrush}"
                                   ToolTip="{DynamicResource Projects.Doing}" />
                    </StackPanel>
                </StackPanel>
            </ui:Button>
        </DataTemplate>

        <!-- A card's type: a plain task stays quiet, an idea takes the accent and a bug the danger colour. -->
        <Style x:Key="ItemTypeIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="TaskListSquareLtr24" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ItemType}" Value="idea">
                    <Setter Property="Symbol" Value="LightbulbFilament24" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ItemType}" Value="bug">
                    <Setter Property="Symbol" Value="Bug24" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemTypeLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ItemType}" Value="idea">
                    <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ItemType}" Value="bug">
                    <Setter Property="Foreground" Value="{DynamicResource GM.DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One card on the board. -->
        <DataTemplate x:Key="BoardCard" DataType="{x:Type vm:BoardItemViewModel}">
            <Border Margin="0,0,0,6" Padding="10,8"
                    CornerRadius="{DynamicResource GM.RowCorner}"
                    Background="{DynamicResource GM.SurfaceBrush}">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Padding="4" Appearance="Transparent"
                                   ToolTip="{DynamicResource Projects.ItemMenu}"
                                   AutomationProperties.Name="{DynamicResource Projects.ItemMenu}">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Projects.Backlog}" Command="{Binding MoveCommand}" CommandParameter="backlog" />
                                    <MenuItem Header="{DynamicResource Projects.Todo}" Command="{Binding MoveCommand}" CommandParameter="todo" />
                                    <MenuItem Header="{DynamicResource Projects.Doing}" Command="{Binding MoveCommand}" CommandParameter="doing" />
                                    <MenuItem Header="{DynamicResource Projects.Done}" Command="{Binding MoveCommand}" CommandParameter="done" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource Projects.OpenItem}" Command="{Binding OpenCommand}" />
                                    <MenuItem Header="{DynamicResource Projects.RemoveItem}" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <ui:SymbolIcon Symbol="MoreVertical24" />
                        </ui:Button>
                        <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <!-- An idea and a bug wear their own icon and colour, so a board reads at a glance. -->
                        <ui:SymbolIcon Margin="0,0,4,0" FontSize="12" VerticalAlignment="Center"
                                       Style="{StaticResource ItemTypeIcon}" />
                        <TextBlock Text="{Binding Type}" FontSize="11" Style="{StaticResource ItemTypeLabel}" />
                        <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <TextBlock Text="{Binding Priority}" FontSize="11" Foreground="{DynamicResource GM.AccentBrush}" />
                        <TextBlock Text="{Binding Day}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Visibility="{Binding HasDay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One column of the board. -->
        <DataTemplate x:Key="BoardColumn" DataType="{x:Type vm:BoardColumnViewModel}">
            <StackPanel Margin="0,0,10,0" MinWidth="180">
                <TextBlock Style="{StaticResource ColumnTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Hint}" FontSize="11" Text="{DynamicResource Projects.ColumnEmpty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BoardCard}" Focusable="False" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!-- Projects (docs/projects.md): the projects on the left, the board of the one on show beside them. -->
    <Grid Margin="{DynamicResource GM.PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <controls:HeadlineText Title="{DynamicResource Projects.Title}" FontSize="32" />
            <ui:Button Margin="0,8,0,8" HorizontalAlignment="Left" Appearance="Primary"
                       Command="{Binding NewCommand}" Content="{DynamicResource Projects.Add}" />
            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Projects.Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ProjectRow}" Focusable="False" />
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- The project on show, or the editor when one is being written. -->
                <Border Padding="12" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}"
                        Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Command="{Binding EditCommand}"
                                   Content="{DynamicResource Projects.Edit}" />
                        <StackPanel>
                            <TextBlock Text="{Binding ProjectName}" FontSize="18" FontFamily="{DynamicResource GM.BodyStrongFont}" />
                            <TextBlock Text="{Binding ProjectDescription}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" />
                            <TextBlock Text="{Binding ProjectRepository}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                            <TextBlock Text="{Binding ProjectFolder}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Padding="12" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ui:TextBox PlaceholderText="{DynamicResource Projects.Name}" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="{DynamicResource Projects.Description}"
                                    Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="{DynamicResource Projects.Repository}"
                                    Text="{Binding ProjectRepository, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="{DynamicResource Projects.Folder}"
                                    Text="{Binding ProjectFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Margin="0,8,0,0" MinWidth="140" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Statuses}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding ProjectStatus}"
                                  AutomationProperties.Name="{DynamicResource Projects.Status}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource Goals.Save}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding CancelCommand}"
                                       Content="{DynamicResource Goals.Cancel}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding DeleteCommand}"
                                       Foreground="{DynamicResource GM.DangerBrush}" Content="{DynamicResource Projects.Delete}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                    <!-- A long title wraps down the box instead of running off to the right, and Return adds it. -->
                    <Grid Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" MinWidth="280" MaxHeight="140" TextWrapping="Wrap"
                                    VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                                    PlaceholderText="{DynamicResource Projects.ItemTitle}"
                                    Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddItemCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="110" VerticalAlignment="Top"
                                  ItemsSource="{Binding ItemTypes}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding NewItemType}"
                                  AutomationProperties.Name="{DynamicResource Projects.ItemType}" />
                        <ui:Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" Appearance="Primary"
                                   Command="{Binding AddItemCommand}" Content="{DynamicResource Projects.AddItem}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Columns}" ItemTemplate="{StaticResource BoardColumn}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
