<Page x:Class="GoalMaker.App.Views.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GoalMaker.App.Controls"
      xmlns:vm="clr-namespace:GoalMaker.App.ViewModels"
      Title="{DynamicResource Projects.Title}"
      Background="{DynamicResource GM.BackgroundBrush}"
      FontFamily="{DynamicResource GM.BodyFont}"
      Foreground="{DynamicResource GM.TextBrush}">
    <Page.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
        </Style>
        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
        </Style>

        <!-- A line that takes no room while it has nothing to say. -->
        <Style x:Key="WhenSaid" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A section label, as on the Focus page: small, strong, in the accent. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>

        <!--
          A project's status at a glance, read from the Tag: active plays on in the accent, paused and
          done step back in the muted colour, each with a mark of its own.
        -->
        <Style x:Key="StatusIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="PlayCircle24" />
            <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="paused">
                    <Setter Property="Symbol" Value="PauseCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="done">
                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GM.TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="paused">
                    <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="done">
                    <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          A row in the project list: a flat button on the page's background that takes the surface on
          hover, and an accent edge for the project on show and for the keyboard, as Focus rows do.
        -->
        <Style x:Key="PaneRow" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="10,6,8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Padding="{TemplateBinding Padding}" Background="Transparent"
                                CornerRadius="{DynamicResource GM.RowCorner}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource GM.SurfaceBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource GM.SurfaceBrush}" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource GM.OutlineBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource GM.AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The menu every project row shares, as the cards share theirs: pin it to the top, or edit it. -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="{Binding PinText}" Command="{Binding TogglePinCommand}" />
            <MenuItem Header="{DynamicResource Projects.Edit}" Command="{Binding EditCommand}" />
        </ContextMenu>

        <!-- A heading in the project list; Paused and done folds. -->
        <DataTemplate DataType="{x:Type vm:ProjectGroupViewModel}">
            <Grid Margin="4,12,0,4">
                <StackPanel x:Name="Plain" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Title}" />
                    <TextBlock Margin="6,0,0,0" FontSize="11" Text="{Binding Count}" Foreground="{DynamicResource GM.TextMutedBrush}" />
                </StackPanel>
                <ui:Button x:Name="Folding" Visibility="Collapsed" Padding="0,2" Appearance="Transparent" BorderThickness="0"
                           HorizontalAlignment="Left" Command="{Binding FoldCommand}"
                           AutomationProperties.Name="{Binding Title}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="Chevron" Margin="0,0,4,0" FontSize="11" Symbol="ChevronDown16"
                                       Foreground="{DynamicResource GM.AccentBrush}" />
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Title}" />
                        <TextBlock Margin="6,0,0,0" FontSize="11" Text="{Binding Count}" Foreground="{DynamicResource GM.TextMutedBrush}" />
                    </StackPanel>
                </ui:Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanFold}" Value="True">
                    <Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Folding" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolded}" Value="True">
                    <Setter TargetName="Chevron" Property="Symbol" Value="ChevronRight16" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          One project in the list: its area's dot, status mark and name, then how much is open with the
          Doing count in the accent. The menu pins it to the top or edits it.
        -->
        <DataTemplate DataType="{x:Type vm:ProjectRowViewModel}">
            <Button Style="{StaticResource PaneRow}" Command="{Binding OpenCommand}" MouseRightButtonUp="OnRowRightClick"
                    AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding LoadText}"
                    ToolTip="{Binding LoadText}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="Pin" Margin="0,0,6,0" FontSize="12" Symbol="Pin16" Visibility="Collapsed"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <TextBlock FontSize="12" Text="{Binding Open}" Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Visibility="{Binding HasOpen, Converter={StaticResource BoolToVisibility}}" />
                        <Border Margin="6,0,0,0" Padding="6,0" CornerRadius="{DynamicResource GM.ChipCorner}"
                                Background="{DynamicResource GM.AccentBrush}"
                                Visibility="{Binding HasDoing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" FontFamily="{DynamicResource GM.BodyStrongFont}" Text="{Binding Doing}"
                                       Foreground="{DynamicResource GM.OnAccentBrush}" />
                        </Border>
                    </StackPanel>
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding AreaBrush}" />
                    <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center"
                                   Tag="{Binding StatusId}" Style="{StaticResource StatusIcon}" />
                    <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Tag="{Binding StatusId}" Style="{StaticResource StatusName}" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="Pin" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- An item the quick search found: its id and title, and the project and column it is in. -->
        <DataTemplate DataType="{x:Type vm:ItemResultViewModel}">
            <Button Style="{StaticResource PaneRow}" Command="{Binding JumpCommand}" AutomationProperties.Name="{Binding Name}">
                <StackPanel>
                    <TextBlock FontSize="13" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding IdLead, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                             Foreground="{DynamicResource GM.TextMutedBrush}" /><Run Text="{Binding Title, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Text="{Binding Place}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource GM.TextMutedBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!--
          A card's type, as a mark and a word in its second line of text: a plain task stays quiet, an
          idea takes the accent and a bug the danger colour. The marks are glyphs of the system's icon font,
          which costs a card far less to draw than icon controls (GM-121).
        -->
        <Style x:Key="ItemTypeMark" TargetType="Run">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Text" Value="&#xE9D5;" />
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ItemType}" Value="idea">
                    <Setter Property="Text" Value="&#xEA80;" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ItemType}" Value="bug">
                    <Setter Property="Text" Value="&#xEBE8;" />
                    <Setter Property="Foreground" Value="{DynamicResource GM.DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemTypeLabel" TargetType="Run">
            <Setter Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ItemType}" Value="idea">
                    <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ItemType}" Value="bug">
                    <Setter Property="Foreground" Value="{DynamicResource GM.DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          The one menu every card shares (GM-121): a menu per card cost the board most of its time to
          draw. The page sets its DataContext to the card it opens for.
        -->
        <ContextMenu x:Key="CardMenu">
            <MenuItem Header="{DynamicResource Projects.OpenItem}" Command="{Binding OpenCommand}" />
            <Separator />
            <MenuItem Header="{DynamicResource Projects.Backlog}" Command="{Binding MoveCommand}" CommandParameter="backlog" />
            <MenuItem Header="{DynamicResource Projects.Todo}" Command="{Binding MoveCommand}" CommandParameter="todo" />
            <MenuItem Header="{DynamicResource Projects.Doing}" Command="{Binding MoveCommand}" CommandParameter="doing" />
            <MenuItem Header="{DynamicResource Projects.Done}" Command="{Binding MoveCommand}" CommandParameter="done" />
            <MenuItem Header="{DynamicResource Projects.Dropped}" Command="{Binding MoveCommand}" CommandParameter="dropped" />
            <Separator />
            <MenuItem Header="{DynamicResource Projects.CopyId}" Command="{Binding CopyIdCommand}"
                      Visibility="{Binding HasItemId, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{DynamicResource Projects.Archive}" Command="{Binding ArchiveCommand}"
                      Visibility="{Binding CanArchive, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{DynamicResource Projects.RemoveItem}" Command="{Binding RemoveCommand}" />
        </ContextMenu>

        <!--
          The dots on a card, which open its menu. A plain button with only its mark: the toolkit's
          button costs more to draw than the rest of the card (GM-121).
        -->
        <Style x:Key="CardDots" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <!-- The words never change while the app runs, so they are looked up once, not once per card. -->
            <Setter Property="ToolTip" Value="{StaticResource Projects.ItemMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{StaticResource Projects.ItemMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Padding="4" Background="Transparent" CornerRadius="{DynamicResource GM.ButtonCorner}">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE712;"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource GM.BackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          One card on the board: its id and title, then its type, priority, day and maker in one line.
          A click anywhere but the dots opens the item, as a tap does on the phone. The card's face is the
          list item's (BoardCards), which takes an accent edge when picked or holding the keyboard.
        -->
        <DataTemplate x:Key="BoardCard" DataType="{x:Type vm:BoardItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--
                  A dropped item, in Dropped, steps back in the muted colour. The id (GM-12) leads the
                  title in the same text, small and muted, so a screen reader reads them together.
                -->
                <TextBlock x:Name="CardTitle" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource GM.TextBrush}">
                    <Run Text="{Binding IdLead, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                         Foreground="{DynamicResource GM.TextMutedBrush}" /><Run Text="{Binding Title, Mode=OneWay}" />
                </TextBlock>
                <Button Grid.Column="1" Style="{StaticResource CardDots}" Click="OnItemMenu" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource GM.TextMutedBrush}">
                    <Run Style="{StaticResource ItemTypeMark}" /><Run Text=" " /><Run Text="{Binding Type, Mode=OneWay}" Style="{StaticResource ItemTypeLabel}" /><Run Text=" · " /><Run Text="{Binding Priority, Mode=OneWay}" Foreground="{DynamicResource GM.AccentBrush}" /><Run Text="{Binding Extra, Mode=OneWay}" />
                </TextBlock>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Dropped}" Value="True">
                    <Setter TargetName="CardTitle" Property="Foreground" Value="{DynamicResource GM.TextMutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          A column's cards: a list that scrolls on its own and draws only the cards in view, so a column
          of hundreds stays quick (GM-121). Up and Down walk the cards, Enter opens one.
        -->
        <Style x:Key="BoardCards" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <!-- The scroll bar lies over the content, so the cards keep clear of it. -->
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                      CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="0,0,8,0" />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{StaticResource Projects.CardHelp}" />
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnCardClick" />
                        <EventSetter Event="MouseRightButtonUp" Handler="OnCardRightClick" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Margin="0,0,0,6" Padding="10,8" BorderThickness="1" BorderBrush="Transparent"
                                            Cursor="Hand" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource GM.OutlineBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource GM.OutlineBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource GM.AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A done item that left the board, with its way back. -->
        <DataTemplate x:Key="ArchivedCard" DataType="{x:Type vm:ArchivedItemViewModel}">
            <!-- The list item draws the card's face, as for the cards on the board. -->
            <Border>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Padding="6,2" VerticalAlignment="Center" Appearance="Transparent"
                               FontSize="12" Command="{Binding PutBackCommand}" Content="{Binding ActionText}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource GM.TextMutedBrush}">
                            <Run Text="{Binding IdLead, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" /><Run Text="{Binding Title, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding DoneText}" FontSize="11" Foreground="{DynamicResource GM.TextMutedBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!--
          One column of the board. Folded, it is a narrow strip with its count and its name down the
          side, and a click opens it again; open, its header folds it, and its cards scroll on their own.
        -->
        <DataTemplate x:Key="BoardColumn" DataType="{x:Type vm:BoardColumnViewModel}">
            <Grid Margin="0,0,10,0">
                <ui:Button Width="38" Padding="4,10" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                           HorizontalContentAlignment="Center" Appearance="Secondary"
                           Command="{Binding FoldCommand}" ToolTip="{Binding UnfoldText}"
                           AutomationProperties.Name="{Binding UnfoldText}"
                           Visibility="{Binding IsFolded, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding Count}"
                                   Foreground="{DynamicResource GM.AccentBrush}" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="11"
                                   FontFamily="{DynamicResource GM.BodyStrongFont}" Text="{Binding Title}"
                                   Foreground="{DynamicResource GM.AccentBrush}">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </ui:Button>
                <DockPanel MinWidth="200" Visibility="{Binding IsUnfolded, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" KeyboardNavigation.TabNavigation="Local">
                        <ui:Button DockPanel.Dock="Right" Padding="4" Appearance="Transparent" VerticalAlignment="Center"
                                   Command="{Binding FoldCommand}" ToolTip="{Binding FoldText}"
                                   AutomationProperties.Name="{Binding FoldText}">
                            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="12" />
                        </ui:Button>
                        <!-- A new item in this column, in the new item window; Done and Dropped have none. -->
                        <ui:Button DockPanel.Dock="Right" TabIndex="0" Padding="4" Appearance="Transparent" VerticalAlignment="Center"
                                   Command="{Binding AddCommand}" ToolTip="{Binding AddText}"
                                   AutomationProperties.Name="{Binding AddText}"
                                   Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Add24" FontSize="12" />
                        </ui:Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ColumnTitle}" Margin="4,0,0,0" Text="{Binding Title}" />
                            <TextBlock Margin="6,0,0,0" FontSize="11" Text="{Binding Count}"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- Under Done: how many items left the board, which opens the list of them. -->
                    <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding HasArchived, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Margin="0,2,0,6" Padding="6,2" HorizontalAlignment="Left" Appearance="Transparent" FontSize="12"
                                   Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Command="{Binding ToggleArchivedCommand}" Content="{Binding ArchivedText}" />
                        <ListBox MaxHeight="260" ItemsSource="{Binding Archived}" ItemTemplate="{StaticResource ArchivedCard}"
                                 Style="{StaticResource BoardCards}" Focusable="False"
                                 Visibility="{Binding ShowsArchived, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="11" Text="{DynamicResource Projects.ColumnEmpty}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ListBox x:Name="Cards" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BoardCard}"
                             Style="{StaticResource BoardCards}" AutomationProperties.Name="{Binding Title}"
                             PreviewKeyDown="OnCardsKey" />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- The project editor: a new project, or the one on show. -->
        <DataTemplate x:Key="ProjectEditor" DataType="{x:Type vm:ProjectsViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Padding="12" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}">
                    <StackPanel>
                        <ui:TextBox PlaceholderText="{DynamicResource Projects.Name}" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                        <!-- The key its items read by (docs/projects.md, "Item ids"): a new project's name suggests one. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" Text="{DynamicResource Projects.Key}" />
                            <ui:TextBox MinWidth="110" MaxLength="6" CharacterCasing="Upper"
                                        Text="{Binding ProjectKey, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{DynamicResource Projects.Key}"
                                        AutomationProperties.HelpText="{Binding KeyHint}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" Text="{Binding KeyHint}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource GM.DangerBrush}"
                                   Text="{Binding KeyProblem}"
                                   Visibility="{Binding HasKeyProblem, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="{DynamicResource Projects.Description}"
                                    Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="{DynamicResource Projects.Repository}"
                                    Text="{Binding ProjectRepository, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="{DynamicResource Projects.Folder}"
                                    Text="{Binding ProjectFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Margin="0,8,0,0" MinWidth="140" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Statuses}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding ProjectStatus}"
                                  AutomationProperties.Name="{DynamicResource Projects.Status}" />
                        <!-- The project's area: its items without one of their own count as in it. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" Text="{DynamicResource Projects.Area}" />
                            <ComboBox MinWidth="140" ItemsSource="{Binding ProjectAreaChoices}" SelectedItem="{Binding ProjectArea}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="{DynamicResource Projects.Area}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" Text="{DynamicResource Projects.ArchiveAfter}" />
                            <ComboBox MinWidth="120" ItemsSource="{Binding ArchiveChoices}"
                                      DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ProjectArchiveAfter}"
                                      AutomationProperties.Name="{DynamicResource Projects.ArchiveAfter}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource Goals.Save}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding CancelCommand}"
                                       Content="{DynamicResource Goals.Cancel}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding DeleteCommand}"
                                       Foreground="{DynamicResource GM.DangerBrush}" Content="{DynamicResource Projects.Delete}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DataTemplate>

        <!-- A board column shares the width while it is open and shrinks to its strip when folded. -->
        <Style x:Key="BoardColumnWidth" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="*" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolded}" Value="True">
                    <Setter Property="Width" Value="Auto" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Page.InputBindings>
        <!-- The new item window, from anywhere on the page (docs/projects.md). -->
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenItemWindowCommand}" />
    </Page.InputBindings>

    <!--
      Projects (docs/projects.md): the project list on the left, the board of the one on show beside it.
      In a narrow window the list folds to a strip and comes out over the board (GM-122).
    -->
    <Grid x:Name="Root" Margin="{DynamicResource GM.PagePaddingToEdge}" Tag="wide">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The strip the list folds to: bring it out, or straight to its search. -->
        <StackPanel x:Name="Rail" Grid.Column="0" Grid.RowSpan="2" Margin="0,4,12,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPaneOpen}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, ElementName=Root}" Value="narrow">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:Button Padding="8" Appearance="Transparent" Command="{Binding TogglePaneCommand}"
                       ToolTip="{DynamicResource Projects.ShowPane}" AutomationProperties.Name="{DynamicResource Projects.ShowPane}">
                <ui:SymbolIcon Symbol="PanelLeftExpand24" />
            </ui:Button>
            <ui:Button Margin="0,4,0,0" Padding="8" Appearance="Transparent" Click="OnFindProject"
                       ToolTip="{DynamicResource Projects.FindProjectHelp}" AutomationProperties.Name="{DynamicResource Projects.FindProject}">
                <ui:SymbolIcon Symbol="Search24" />
            </ui:Button>
        </StackPanel>

        <!--
          The project list: the title, New project and the quick search stay put; only the rows scroll,
          and only the rows in view are drawn (docs/pitfalls.md, "A StackPanel never scrolls").
        -->
        <Border x:Name="Pane" Grid.Column="0" Grid.RowSpan="2" Width="268" Panel.ZIndex="10" HorizontalAlignment="Left">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0,0,16,0" />
                    <Setter Property="Visibility" Value="{Binding IsPaneOpen, Converter={StaticResource BoolToVisibility}}" />
                    <Style.Triggers>
                        <!-- Narrow: over the board, on the page's background, with a shadow to lift it. -->
                        <DataTrigger Binding="{Binding Tag, ElementName=Root}" Value="narrow">
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="12,0,12,12" />
                            <Setter Property="Background" Value="{DynamicResource GM.BackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GM.OutlineBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <controls:HeadlineText DockPanel.Dock="Top" Title="{DynamicResource Projects.Title}" FontSize="32" />
                <!-- The quick search, then New project and the button that puts the list away. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,8,0,4">
                    <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8" VerticalAlignment="Center" Appearance="Transparent"
                               Command="{Binding TogglePaneCommand}"
                               ToolTip="{DynamicResource Projects.HidePane}" AutomationProperties.Name="{DynamicResource Projects.HidePane}">
                        <ui:SymbolIcon Symbol="PanelLeftContract24" />
                    </ui:Button>
                    <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8" VerticalAlignment="Center" Appearance="Primary"
                               Command="{Binding NewCommand}"
                               ToolTip="{DynamicResource Projects.Add}" AutomationProperties.Name="{DynamicResource Projects.Add}">
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button>
                    <ui:TextBox x:Name="PaneSearch"
                                PlaceholderText="{DynamicResource Projects.FindProject}"
                                Icon="{ui:SymbolIcon Search24}"
                                ToolTip="{DynamicResource Projects.FindProjectHelp}"
                                AutomationProperties.Name="{DynamicResource Projects.FindProject}"
                                AutomationProperties.HelpText="{DynamicResource Projects.FindProjectHelp}"
                                Text="{Binding PaneQuery, UpdateSourceTrigger=PropertyChanged}"
                                PreviewKeyDown="OnPaneSearchKey">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding PickFirstCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding ClearPaneQueryCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Projects.Empty}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Every project filtered away: the filter stays over the board, where it can be let go. -->
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Projects.NoneMatch}"
                               Visibility="{Binding IsFilteredAway, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="4,8,0,8" Text="{DynamicResource Projects.NothingFound}"
                               Visibility="{Binding IsNothingFound, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="4,4,0,0" FontSize="11" Text="{Binding MoreFoundText}" />
                <ItemsControl x:Name="ProjectList" ItemsSource="{Binding PaneEntries}" Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              PreviewKeyDown="OnPaneListKey" PreviewTextInput="OnPaneListText">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="ProjectListScroller" Focusable="False" CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Margin="0,0,8,0" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- The board side: what stays put on top, and the board, whose columns scroll on their own. -->
        <Grid Grid.Column="1" Margin="{DynamicResource GM.PageGutter}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!--
                  The area and tag filter (docs/projects.md) narrows the project list and the board, so
                  it sits over both, and stays when it filters every project away.
                -->
                <ContentControl Margin="0,0,0,12" Focusable="False" HorizontalAlignment="Left"
                                Content="{Binding Filters}" ContentTemplate="{StaticResource ListFilters}"
                                Visibility="{Binding Filters.HasAny, Converter={StaticResource BoolToVisibility}}" />
                <!-- The project on show. -->
                <Border Padding="12,10" CornerRadius="{DynamicResource GM.RowCorner}" Background="{DynamicResource GM.SurfaceBrush}"
                        Visibility="{Binding ShowsProject, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <!-- The status with its mark and the Edit button share one row, centred on each other. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:SymbolIcon Margin="0,0,4,0" FontSize="14" VerticalAlignment="Center"
                                           Tag="{Binding ProjectStatus}" Style="{StaticResource StatusIcon}" />
                            <TextBlock Margin="0,0,8,0" Text="{Binding ProjectStatusText}" FontSize="12" VerticalAlignment="Center"
                                       Tag="{Binding ProjectStatus}" Style="{StaticResource StatusName}" />
                            <ui:Button Appearance="Transparent" VerticalAlignment="Center" Command="{Binding EditCommand}"
                                       Content="{DynamicResource Projects.Edit}" />
                        </StackPanel>
                        <!-- The name, then the description and where the project lives, each only when it has one. -->
                        <StackPanel>
                            <TextBlock Text="{Binding ProjectName}" FontSize="18" FontFamily="{DynamicResource GM.BodyStrongFont}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ProjectDescription}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource GM.TextMutedBrush}"
                                       Style="{StaticResource WhenSaid}" />
                            <TextBlock Text="{Binding ProjectPlace}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource GM.TextMutedBrush}" Style="{StaticResource WhenSaid}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!--
              The editor takes the board's place while a project is being written. Its boxes are made
              only then, so the page opens quicker and switching projects doesn't fill boxes nobody sees (GM-121).
            -->
            <ContentControl Grid.Row="1" Grid.RowSpan="2" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content" Value="{x:Null}" />
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Content" Value="{Binding}" />
                                <Setter Property="ContentTemplate" Value="{StaticResource ProjectEditor}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <StackPanel Grid.Row="1" Visibility="{Binding ShowsProject, Converter={StaticResource BoolToVisibility}}">
                <!--
                  The quick line: a long title wraps down the box instead of running off to the right,
                  and Return adds it with its kind. New item opens the window with every field, and
                  takes what the line holds along.
                -->
                <Grid Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" MinWidth="200" MaxHeight="140" TextWrapping="Wrap"
                                VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                                PlaceholderText="{DynamicResource Projects.ItemTitle}"
                                AutomationProperties.Name="{DynamicResource Projects.ItemTitle}"
                                Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddItemCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="110" VerticalAlignment="Top"
                              ItemsSource="{Binding ItemTypes}"
                              DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding NewItemType}"
                              AutomationProperties.Name="{DynamicResource Projects.ItemType}" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" Appearance="Primary"
                               Command="{Binding AddItemCommand}" Content="{DynamicResource Projects.AddItem}" />
                    <ui:Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Top"
                               Command="{Binding OpenItemWindowCommand}" Content="{DynamicResource Projects.NewItem}"
                               ToolTip="{DynamicResource Projects.NewItemHelp}"
                               AutomationProperties.Name="{DynamicResource Projects.NewItem}"
                               AutomationProperties.HelpText="{DynamicResource Projects.NewItemHelp}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="WindowNew24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <!--
                  The board's search: words from an item's title or notes, or its id, GM-12 or #12. Then who
                  made the items on show: everyone, the owner, or Claude (docs/projects.md).
                -->
                <DockPanel Margin="0,0,0,8">
                    <ui:TextBox x:Name="BoardSearch" DockPanel.Dock="Left" Width="260"
                                PlaceholderText="{DynamicResource Projects.FindItem}"
                                Icon="{ui:SymbolIcon Search24}"
                                ToolTip="{DynamicResource Projects.FindItemHelp}"
                                AutomationProperties.Name="{DynamicResource Projects.FindItem}"
                                AutomationProperties.HelpText="{DynamicResource Projects.FindItemHelp}"
                                Text="{Binding BoardQuery, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource GM.TextMutedBrush}" Text="{DynamicResource Projects.MadeBy}" />
                        <ComboBox MinWidth="120" ItemsSource="{Binding MakerFilters}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding MadeByFilter}"
                                  AutomationProperties.Name="{DynamicResource Projects.MadeBy}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!--
              The open columns share the width when there is room, and a folded one keeps only its strip.
              In a narrow window they stop shrinking and the board scrolls sideways, so a card is never
              cut off and its menu stays on screen. Each column scrolls up and down on its own.
            -->
            <ScrollViewer x:Name="BoardScroller" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowsProject, Converter={StaticResource BoolToVisibility}}">
                <!-- The board takes the width it is shown in, and what its columns need at the least, so a title still wraps. -->
                <Grid x:Name="Board" MinWidth="{Binding BoardMinWidth}"
                      Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition DataContext="{Binding Columns[0]}" Style="{StaticResource BoardColumnWidth}" />
                        <ColumnDefinition DataContext="{Binding Columns[1]}" Style="{StaticResource BoardColumnWidth}" />
                        <ColumnDefinition DataContext="{Binding Columns[2]}" Style="{StaticResource BoardColumnWidth}" />
                        <ColumnDefinition DataContext="{Binding Columns[3]}" Style="{StaticResource BoardColumnWidth}" />
                        <ColumnDefinition DataContext="{Binding Columns[4]}" Style="{StaticResource BoardColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Focusable="False" Content="{Binding Columns[0]}" ContentTemplate="{StaticResource BoardColumn}" />
                    <ContentControl Grid.Column="1" Focusable="False" Content="{Binding Columns[1]}" ContentTemplate="{StaticResource BoardColumn}" />
                    <ContentControl Grid.Column="2" Focusable="False" Content="{Binding Columns[2]}" ContentTemplate="{StaticResource BoardColumn}" />
                    <ContentControl Grid.Column="3" Focusable="False" Content="{Binding Columns[3]}" ContentTemplate="{StaticResource BoardColumn}" />
                    <ContentControl Grid.Column="4" Focusable="False" Content="{Binding Columns[4]}" ContentTemplate="{StaticResource BoardColumn}" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Undo for the last item finished or taken out, for five seconds, as on the lists. -->
        <Border Grid.Row="1" Grid.Column="1"
                Margin="0,12,0,0"
                Padding="16,6,6,6"
                CornerRadius="{DynamicResource GM.RowCorner}"
                Background="{DynamicResource GM.HeroBrush}"
                Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Transparent"
                           Foreground="{DynamicResource GM.HeroAccentBrush}"
                           Content="{DynamicResource Lists.Undo}"
                           Command="{Binding UndoCommand}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding UndoText}" Foreground="{DynamicResource GM.OnHeroBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Page>
