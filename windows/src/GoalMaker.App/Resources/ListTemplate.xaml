<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:GoalMaker.App.Controls"
                    xmlns:vm="clr-namespace:GoalMaker.App.ViewModels">

    <!-- A field's name in the new task form, as in the goal and habit editors. -->
    <Style x:Key="GM.FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,10,0,4" />
        <Setter Property="FontFamily" Value="{DynamicResource GM.BodyStrongFont}" />
        <Setter Property="Foreground" Value="{DynamicResource GM.AccentBrush}" />
    </Style>

    <!-- An area (with its color) or a tag in the pickers above the lists. -->
    <DataTemplate x:Key="FilterChoice" DataType="{x:Type vm:FilterChoiceViewModel}">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}"
                     Visibility="{Binding HasBrush, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <!--
        One list (Today, Tomorrow, Inbox) as ListPage shows it (docs/lists.md). Today's habits sit in a
        panel beside the tasks where the window is wide enough, and under them where it is not (a narrow
        window, a mini window): the root's Tag says which.
    -->
    <DataTemplate x:Key="ListTemplate" DataType="{x:Type vm:ListViewModel}">
        <Grid x:Name="ListRoot" Margin="{DynamicResource GM.PagePadding}">
            <Grid.InputBindings>
                <!-- The new task form, from anywhere on the list (docs/composer.md). -->
                <KeyBinding Key="N" Modifiers="Control" Command="{Binding Composer.OpenFormCommand}" />
            </Grid.InputBindings>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Tag" Value="stacked" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthAtLeast}, ConverterParameter=780}" Value="True">
                            <Setter Property="Tag" Value="wide" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The title and the day, then one toolbar line: the area and tag pickers on the left, the sync
                 state and Plan tomorrow on the right, all centered on the same line. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <controls:HeadlineText Title="{Binding Title}" FontSize="40" Visibility="{DynamicResource GM.ListHeadlineVisibility}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding Subtitle}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource GM.TextMutedBrush}" />
                <!-- Tab takes them in the order they read: the pickers, then the sync state, the mini window and
                     Plan tomorrow. Where the list is narrow (a mini window, large text) the right-hand group
                     moves under the pickers instead of running over them. -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel HorizontalAlignment="Left"
                               DataContext="{Binding Filters}"
                               Visibility="{Binding HasAny, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <ComboBox MinWidth="160"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding AreaChoices}"
                                  SelectedItem="{Binding SelectedArea}"
                                  ItemTemplate="{StaticResource FilterChoice}"
                                  AutomationProperties.Name="{DynamicResource Lists.FilterArea}"
                                  Visibility="{Binding HasAreas, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAreaChosen}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GM.AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <ComboBox MinWidth="140"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding TagChoices}"
                                  SelectedItem="{Binding SelectedTag}"
                                  ItemTemplate="{StaticResource FilterChoice}"
                                  AutomationProperties.Name="{DynamicResource Lists.FilterTag}"
                                  Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTagChosen}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GM.AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <ui:Button Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Appearance="Transparent"
                                   Content="{DynamicResource Lists.ClearFilter}"
                                   Command="{Binding ClearCommand}"
                                   Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=ListRoot}" Value="stacked">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="Margin" Value="0,8,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding SyncText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource GM.TextMutedBrush}" />
                        <ui:Button Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Padding="8,6"
                                   Appearance="Transparent"
                                   Command="{Binding OpenMiniCommand}"
                                   ToolTip="{DynamicResource Mini.OpenThis}"
                                   AutomationProperties.Name="{DynamicResource Mini.OpenThis}">
                            <ui:Button.Style>
                                <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Visibility" Value="{Binding HasMini, Converter={StaticResource BoolToVisibility}}" />
                                    <Style.Triggers>
                                        <!-- The mini window draws this same template; it does not offer to open itself. -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Tag}" Value="mini">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="PictureInPictureEnter20" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button VerticalAlignment="Center"
                                   Appearance="Primary"
                                   Content="{DynamicResource Plan.Title}"
                                   Command="{Binding OpenPlanCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="CalendarEdit24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- The January nudge (docs/reviews.md): last year's review and this year's goals. -->
                        <Border Margin="0,4,0,8" Padding="16,14" CornerRadius="{DynamicResource GM.CardCorner}" Background="{DynamicResource GM.HeroBrush}"
                                Visibility="{Binding HasNewYear, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="22" Foreground="{DynamicResource GM.HeroAccentBrush}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding NewYearTitle}" FontSize="16"
                                               FontFamily="{DynamicResource GM.BodyStrongFont}" Foreground="{DynamicResource GM.OnHeroBrush}"
                                               AutomationProperties.HeadingLevel="Level2" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,10" Text="{Binding NewYearText}" TextWrapping="Wrap" Foreground="{DynamicResource GM.OnHeroBrush}" />
                                <WrapPanel>
                                    <ui:Button Margin="0,0,8,4" Appearance="Primary" Content="{Binding NewYearReviewText}" Command="{Binding NewYearReviewCommand}"
                                               Visibility="{Binding NewYear.Review, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <ui:Button Margin="0,0,8,4" Appearance="Primary" Content="{Binding NewYearGoalsText}" Command="{Binding OpenGoalsCommand}"
                                               Visibility="{Binding NewYear.Goals, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <ui:Button Margin="0,0,0,4" Appearance="Transparent" Content="{DynamicResource NewYear.NotNow}" Command="{Binding DismissNewYearCommand}"
                                               Foreground="{DynamicResource GM.OnHeroBrush}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="4,8,0,8"
                                   Text="{Binding EmptyText}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource GM.TextMutedBrush}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ListSectionViewModel}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Margin="4,8,0,6"
                                                   Text="{Binding Header}"
                                                   FontSize="11"
                                                   FontFamily="{DynamicResource GM.BodyStrongFont}"
                                                   Foreground="{DynamicResource GM.AccentBrush}"
                                                   Visibility="{Binding HasPlainHeader, Converter={StaticResource BoolToVisibility}}" />
                                        <ToggleButton Margin="0,8,0,6"
                                                      HorizontalAlignment="Left"
                                                      Padding="4,2"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Cursor="Hand"
                                                      IsChecked="{Binding IsExpanded}"
                                                      Visibility="{Binding IsCollapsible, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding Header}"
                                                           FontSize="11"
                                                           FontFamily="{DynamicResource GM.BodyStrongFont}"
                                                           Foreground="{DynamicResource GM.AccentBrush}" />
                                                <ui:SymbolIcon Margin="6,0,0,0" FontSize="12" Symbol="ChevronDown16" Foreground="{DynamicResource GM.AccentBrush}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ItemsControl ItemsSource="{Binding Rows}"
                                                      Focusable="False"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                                                    <Border Margin="{DynamicResource GM.RowGap}"
                                                            Padding="12,2"
                                                            MinHeight="{DynamicResource GM.RowMinHeight}"
                                                            CornerRadius="{DynamicResource GM.RowCorner}"
                                                            Background="{DynamicResource GM.SurfaceBrush}">
                                                        <!-- Right click, or the menu key on the focused row: set or remove reminders. -->
                                                        <Border.ContextMenu>
                                                            <ContextMenu ItemsSource="{Binding ReminderChoices}">
                                                                <ContextMenu.ItemContainerStyle>
                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                        <Setter Property="Header" Value="{Binding Label}" />
                                                                        <Setter Property="Command" Value="{Binding Command}" />
                                                                    </Style>
                                                                </ContextMenu.ItemContainerStyle>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <!-- Tab reads the row left to right: the done box, then Delete, then Open. -->
                                                        <DockPanel VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Local">
                                                            <ui:Button DockPanel.Dock="Right"
                                                                       TabIndex="2"
                                                                       Appearance="Transparent"
                                                                       BorderThickness="0"
                                                                       Padding="6"
                                                                       Command="{Binding OpenCommand}"
                                                                       ToolTip="{DynamicResource Lists.OpenTask}"
                                                                       AutomationProperties.Name="{DynamicResource Lists.OpenTask}">
                                                                <ui:SymbolIcon Symbol="Open24" />
                                                            </ui:Button>
                                                            <ui:Button DockPanel.Dock="Right"
                                                                       TabIndex="1"
                                                                       Appearance="Transparent"
                                                                       BorderThickness="0"
                                                                       Padding="6"
                                                                       Command="{Binding DeleteCommand}"
                                                                       ToolTip="{DynamicResource Lists.Delete}"
                                                                       AutomationProperties.Name="{DynamicResource Lists.Delete}">
                                                                <ui:SymbolIcon Symbol="Delete24" />
                                                            </ui:Button>
                                                            <ui:SymbolIcon DockPanel.Dock="Right"
                                                                           Margin="4,0,8,0"
                                                                           FontSize="14"
                                                                           Symbol="Alert16"
                                                                           Foreground="{DynamicResource GM.TextMutedBrush}"
                                                                           ToolTip="{DynamicResource Reminder.Waiting}"
                                                                           AutomationProperties.Name="{DynamicResource Reminder.Waiting}"
                                                                           Visibility="{Binding HasReminder, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Margin="8,0"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding TimeText}"
                                                                       FontSize="16"
                                                                       FontFamily="{DynamicResource GM.NumberFont}"
                                                                       Foreground="{DynamicResource GM.AccentBrush}"
                                                                       Visibility="{Binding HasTime, Converter={StaticResource BoolToVisibility}}" />
                                                            <CheckBox VerticalAlignment="Center"
                                                                      TabIndex="0"
                                                                      Foreground="{DynamicResource GM.TextBrush}"
                                                                      IsChecked="{Binding IsDone}"
                                                                      AutomationProperties.Name="{Binding Title}"
                                                                      AutomationProperties.HelpText="{Binding Status}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Margin="0,0,10,0"
                                                                                   Text="{Binding DayText}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource GM.DangerBrush}"
                                                                                   Visibility="{Binding HasDay, Converter={StaticResource BoolToVisibility}}" />
                                                                        <ui:SymbolIcon Margin="0,0,10,0"
                                                                                       FontSize="12"
                                                                                       Symbol="Flag16"
                                                                                       Foreground="{DynamicResource GM.AccentBrush}"
                                                                                       Visibility="{Binding TopPriority, Converter={StaticResource BoolToVisibility}}" />
                                                                        <StackPanel Margin="0,0,10,0"
                                                                                    Orientation="Horizontal"
                                                                                    Visibility="{Binding HasArea, Converter={StaticResource BoolToVisibility}}">
                                                                            <Ellipse Width="7" Height="7" Margin="0,0,4,0" VerticalAlignment="Center" Fill="{Binding AreaBrush}" />
                                                                            <TextBlock Text="{Binding AreaName}" FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" />
                                                                        </StackPanel>
                                                                        <ui:SymbolIcon FontSize="12"
                                                                                       Symbol="ArrowRepeatAll16"
                                                                                       Foreground="{DynamicResource GM.TextMutedBrush}"
                                                                                       ToolTip="{DynamicResource Lists.Repeats}"
                                                                                       Visibility="{Binding Repeats, Converter={StaticResource BoolToVisibility}}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- This week's goals, folded like the overdue tasks (design spec, Today). -->
                        <StackPanel Visibility="{Binding HasWeekGoals, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton Margin="0,8,0,6"
                                          HorizontalAlignment="Left"
                                          Padding="4,2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsWeekGoalsExpanded}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding WeekGoalsHeader}"
                                               FontSize="11"
                                               FontFamily="{DynamicResource GM.BodyStrongFont}"
                                               Foreground="{DynamicResource GM.AccentBrush}" />
                                    <ui:SymbolIcon Margin="6,0,0,0" FontSize="12" Symbol="ChevronDown16" Foreground="{DynamicResource GM.AccentBrush}" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Visibility="{Binding IsWeekGoalsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding WeekGoals}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalRowViewModel}">
                                            <Border Margin="{DynamicResource GM.RowGap}"
                                                    Padding="12,4"
                                                    MinHeight="{DynamicResource GM.RowMinHeight}"
                                                    CornerRadius="{DynamicResource GM.RowCorner}"
                                                    Background="{DynamicResource GM.SurfaceBrush}">
                                                <DockPanel VerticalAlignment="Center">
                                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding ProgressText}"
                                                               FontSize="12" Foreground="{DynamicResource GM.TextMutedBrush}" />
                                                    <controls:GoalRing DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" Fraction="{Binding Fraction}" Thickness="3" />
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Margin="0,4,0,0" Appearance="Transparent" Content="{DynamicResource Goals.All}" Command="{Binding OpenGoalsCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Today's habits under the tasks where there is no room beside them. -->
                        <ContentControl Margin="0,12,0,0" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HabitPanel}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasHabits}" Value="True" />
                                                <Condition Binding="{Binding Tag, ElementName=ListRoot}" Value="stacked" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Today's habits beside the tasks (the habits prototype's PC view), in one column of cards. -->
                <ScrollViewer Grid.Column="1" Width="340" Margin="20,0,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasHabits}" Value="True" />
                                        <Condition Binding="{Binding Tag, ElementName=ListRoot}" Value="wide" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HabitPanel}" VerticalAlignment="Top" />
                </ScrollViewer>
            </Grid>

            <!-- Undo for the last completion or deletion, for five seconds. -->
            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="16,6,6,6"
                    CornerRadius="{DynamicResource GM.RowCorner}"
                    Background="{DynamicResource GM.HeroBrush}"
                    Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right"
                               Appearance="Transparent"
                               Foreground="{DynamicResource GM.HeroAccentBrush}"
                               Content="{DynamicResource Lists.Undo}"
                               Command="{Binding UndoCommand}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding UndoText}" Foreground="{DynamicResource GM.OnHeroBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- The composer (docs/composer.md): the list supplies the day when the line names none. -->
            <ContentControl Grid.Row="3"
                            Margin="0,12,0,0"
                            Focusable="False"
                            Content="{Binding Composer}"
                            ContentTemplate="{StaticResource ComposerTemplate}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <!-- The new task form takes the list and its bar while it is open. -->
                            <DataTrigger Binding="{Binding NewTask.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- The new task form the bar's plus opens: it takes the list while it is open. -->
            <Border Grid.Row="0"
                    Grid.RowSpan="4"
                    Background="{DynamicResource GM.BackgroundBrush}"
                    Visibility="{Binding NewTask.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ui:Card Margin="0,8"
                             Padding="24"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             DataContext="{Binding NewTask}">
                        <ui:Card.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
                        </ui:Card.InputBindings>
                        <StackPanel MaxWidth="432">
                            <TextBlock Margin="0,0,0,8"
                                       FontSize="20"
                                       FontFamily="{DynamicResource GM.BodyStrongFont}"
                                       Text="{DynamicResource Composer.NewTask}" />
                            <TextBlock Style="{StaticResource GM.FieldLabel}" Text="{DynamicResource NewTask.What}" />
                            <ui:TextBox MaxLength="500"
                                        controls:FocusWhen.Open="{Binding IsOpen}"
                                        Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{DynamicResource NewTask.What}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource GM.FieldLabel}" Text="{DynamicResource NewTask.Day}" />
                                    <ComboBox ItemsSource="{Binding Days}"
                                              SelectedItem="{Binding Day}"
                                              DisplayMemberPath="Label"
                                              AutomationProperties.Name="{DynamicResource NewTask.Day}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource GM.FieldLabel}" Text="{DynamicResource NewTask.Area}" />
                                    <ComboBox ItemsSource="{Binding AreaChoices}"
                                              SelectedItem="{Binding Area}"
                                              DisplayMemberPath="Label"
                                              AutomationProperties.Name="{DynamicResource NewTask.Area}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Margin="0,12,0,0"
                                      Content="{DynamicResource Composer.Priority}"
                                      IsChecked="{Binding TopPriority}" />
                            <TextBlock Style="{StaticResource GM.FieldLabel}" Text="{DynamicResource NewTask.Notes}" />
                            <ui:TextBox MinHeight="76"
                                        MaxLength="20000"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{DynamicResource NewTask.Notes}" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource GM.TextMutedBrush}"
                                       Text="{DynamicResource NewTask.Hint}" />
                            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button Command="{Binding CancelCommand}" Content="{DynamicResource NewTask.Cancel}" />
                                <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource NewTask.Save}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </ScrollViewer>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
