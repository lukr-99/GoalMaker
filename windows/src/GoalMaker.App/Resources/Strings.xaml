    <!-- Claude connector (docs/connector.md) -->
    <sys:String x:Key="Connector.Title">Claude connector</sys:String>
    <sys:String x:Key="Connector.Intro">Add GoalMaker to Claude as a connector, and Claude can read and change your plans in Claude on the web, the desktop and phone apps, and Claude Code. Every change Claude makes shows in Activity, where you can undo it.</sys:String>
