    <sys:String x:Key="Nav.Inbox">Inbox</sys:String>
    <sys:String x:Key="Nav.Settings">Settings</sys:String>

    <sys:String x:Key="SignIn.Title">Plan tomorrow.&#10;Keep your goals alive.</sys:String>
    <sys:String x:Key="SignIn.EmailLabel">Email</sys:String>
    <sys:String x:Key="SignIn.EmailHint">We'll email you a 6-digit code. No password.</sys:String>
    <sys:String x:Key="SignIn.SendCode">Send code</sys:String>
    <sys:String x:Key="SignIn.CodeLabel">6-digit code</sys:String>
    <sys:String x:Key="SignIn.CodeSent">We sent a code to {0}. It works for 10 minutes.</sys:String>
    <sys:String x:Key="SignIn.Verify">Sign in</sys:String>
    <sys:String x:Key="SignIn.Resend">Send a new code</sys:String>
    <sys:String x:Key="SignIn.UseAnotherEmail">Use another email</sys:String>
