    <sys:String x:Key="Lists.TomorrowEmpty">Nothing for tomorrow yet. Anything you add here lands on tomorrow.</sys:String>
    <sys:String x:Key="Lists.InboxEmpty">Inbox zero. Anything without a day or an area lands here.</sys:String>
