    <sys:String x:Key="SignIn.Error.InvalidCode">Enter the 6 digits from the email.</sys:String>
    <sys:String x:Key="SignIn.Error.WrongCode">That code is wrong or has expired. Try again or send a new one.</sys:String>
    <sys:String x:Key="SignIn.Error.TooManyRequests">Too many attempts. Wait a minute, then try again.</sys:String>
    <sys:String x:Key="SignIn.Error.Offline">No connection to GoalMaker's server. Check your internet and try again.</sys:String>
    <sys:String x:Key="SignIn.Error.Other">Sign-in failed: {0}</sys:String>
    <sys:String x:Key="SignIn.DevBackend">Development build · {0}</sys:String>

