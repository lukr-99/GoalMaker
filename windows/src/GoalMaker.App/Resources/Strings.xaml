    <sys:String x:Key="Settings.Update.Downloading">Downloading {0:P0}…</sys:String>
    <sys:String x:Key="Settings.Update.NotConfigured">The update channel isn't set up in this build yet.</sys:String>
    <sys:String x:Key="Settings.Update.DevBuild">Development builds don't update themselves. Install a release build instead.</sys:String>
    <sys:String x:Key="Settings.Update.UpToDate">You have the latest version ({0}).</sys:String>
    <sys:String x:Key="Settings.Update.Available">Version {0} is available.</sys:String>
    <sys:String x:Key="Settings.Update.Untrusted">The update channel returned a release that failed verification. Nothing was installed.</sys:String>
    <sys:String x:Key="Settings.Update.Failed">Couldn't check for updates: {0}</sys:String>
    <sys:String x:Key="Settings.Update.Corrupted">The download didn't match its checksum and was discarded.</sys:String>
    <sys:String x:Key="Settings.Update.Started">The installer is running. GoalMaker restarts when it finishes.</sys:String>
    <sys:String x:Key="Settings.Update.Manual">You can always install an update by hand from the GoalMaker GitHub release.</sys:String>
    <sys:String x:Key="Settings.About">About</sys:String>
    <sys:String x:Key="Settings.Version">Version {0}</sys:String>
    <sys:String x:Key="Settings.Backend">Backend: {0}</sys:String>
