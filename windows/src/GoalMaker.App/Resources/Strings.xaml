    <sys:String x:Key="Settings.PureBlack">Pure black</sys:String>
    <sys:String x:Key="Settings.PureBlackHint">Dark mode on true black.</sys:String>
    <sys:String x:Key="Settings.ReduceMotion">Reduce motion</sys:String>
    <sys:String x:Key="Settings.ReduceMotionOn">On</sys:String>
    <sys:String x:Key="Settings.ReduceMotionOff">Off</sys:String>
    <sys:String x:Key="Settings.CompletionSound">Completion sound</sys:String>
    <sys:String x:Key="Settings.CompletionSoundHint">A soft tick when you finish something.</sys:String>
    <sys:String x:Key="Settings.ThemeSystem">System</sys:String>
    <sys:String x:Key="Settings.ThemeLight">Light</sys:String>
    <sys:String x:Key="Settings.ThemeDark">Dark</sys:String>
    <sys:String x:Key="Settings.Planning">Planning</sys:String>
    <sys:String x:Key="Settings.DayStart">The day starts at</sys:String>
    <sys:String x:Key="Settings.DayStartHint">Until then it's still yesterday, so planning after midnight lands on the right tomorrow.</sys:String>
    <sys:String x:Key="Settings.Account">Account</sys:String>
    <sys:String x:Key="Settings.SignOut">Sign out</sys:String>
    <sys:String x:Key="Settings.SignOutUnsynced">{0} change(s) haven't reached the server yet. Signing out now deletes them from this PC.</sys:String>
    <sys:String x:Key="Settings.SignOutAnyway">Sign out anyway</sys:String>
