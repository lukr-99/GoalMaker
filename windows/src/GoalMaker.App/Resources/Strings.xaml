                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- English copy. A Czech dictionary with the same keys can be merged later. -->
    <sys:String x:Key="App.Name">GoalMaker</sys:String>

    <sys:String x:Key="Tray.Open">Open GoalMaker</sys:String>
    <sys:String x:Key="Tray.Quit">Quit</sys:String>

    <sys:String x:Key="Nav.Today">Today</sys:String>
