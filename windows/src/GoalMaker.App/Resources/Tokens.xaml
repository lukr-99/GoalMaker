<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      GoalMaker's resources that don't depend on the theme. Everything themed (GM.*Brush and
      GM.*Color for each color role, GM.BodyFont, GM.BodyStrongFont, GM.HeadingFont, GM.NumberFont,
      GM.CardCorner, GM.RowCorner, GM.ButtonCorner, GM.PagePadding, GM.RowGap, GM.RowMinHeight) is set
      at run time by Theming/ThemeApplier from contracts/design/themes.json (ADR 0008). Views use
      DynamicResource for those keys so a theme switch applies at once.
    -->
    <!-- Half the composer's height, so it's a pill (WPF draws larger radii as an ellipse). -->
    <CornerRadius x:Key="GM.ComposerCorner">22</CornerRadius>
</ResourceDictionary>
