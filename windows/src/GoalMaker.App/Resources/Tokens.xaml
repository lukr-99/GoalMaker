<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      GoalMaker's own semantic tokens, beside WPF UI's theme resources. Placeholder values until the
      design questionnaire; views use the keys, never literal colors. Accents are independent of the
      neutral surfaces that WPF UI provides for light and dark.
    -->
    <Color x:Key="Brand.PrimaryColor">#5B2EE6</Color>
    <Color x:Key="Brand.SecondaryColor">#E5533A</Color>
    <SolidColorBrush x:Key="Brand.PrimaryBrush" Color="{StaticResource Brand.PrimaryColor}" />
    <SolidColorBrush x:Key="Brand.SecondaryBrush" Color="{StaticResource Brand.SecondaryColor}" />
    <SolidColorBrush x:Key="Brand.OnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Status.ErrorBrush" Color="#D13438" />

    <CornerRadius x:Key="Shape.Card">16</CornerRadius>
    <CornerRadius x:Key="Shape.Composer">24</CornerRadius>
    <Thickness x:Key="Space.Page">32,24,32,24</Thickness>
</ResourceDictionary>
