<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapters: Supabase, the replica, the file system, DPAPI, process launching. Windows only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GoalMaker.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoalMaker.Core\GoalMaker.Core.csproj" />
  </ItemGroup>

  <!--
    SystemEvents (lock, unlock, sleep and wake) for Tally's foreground source, and DPAPI for the session.
    The app runs on this framework anyway.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Supabase" Version="8.1.1" />
  </ItemGroup>

  <!-- The shared replica schema, synced-table contract, theme tokens and logo, built in (ADR 0007, 0008). -->
  <ItemGroup>
    <EmbeddedResource Include="$(RepositoryRoot)\replica\migrations\*.sql"
                      LogicalName="GoalMaker.Replica.Migrations.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(RepositoryRoot)\contracts\schemas\synced-tables.json"
                      LogicalName="GoalMaker.Contracts.synced-tables.json" />
    <EmbeddedResource Include="$(RepositoryRoot)\contracts\design\themes.json"
                      LogicalName="GoalMaker.Contracts.themes.json" />
    <EmbeddedResource Include="$(RepositoryRoot)\contracts\design\logo.json"
                      LogicalName="GoalMaker.Contracts.logo.json" />
    <EmbeddedResource Include="$(RepositoryRoot)\contracts\content\prompts.json"
                      LogicalName="GoalMaker.Contracts.prompts.json" />
    <EmbeddedResource Include="$(RepositoryRoot)\contracts\content\tally-rules.json"
                      LogicalName="GoalMaker.Contracts.tally-rules.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GoalMaker.Core.Tests" />
  </ItemGroup>
</Project>
