<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- dotnetlib's private GitHub Packages feed (DotNetLib.Tray). Restore needs a read:packages token,
         given as credentials for the source named "dotnetlib": the user NuGet config on a PC, an
         environment variable in CI (docs/setup/local-development.md). -->
    <add key="dotnetlib" value="https://nuget.pkg.github.com/lukr-99/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnetlib">
      <package pattern="DotNetLib.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
